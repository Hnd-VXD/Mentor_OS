# Build-time settings for the Mentor image. Sourced by build/build.sh and
# distro/customize.sh. Change the password before sharing an image.
MENTOR_USER=admin
MENTOR_PASSWORD=admin
MENTOR_HOSTNAME=mentor
MENTOR_TIMEZONE=Europe/Athens
MENTOR_LOCALE=en_US.UTF-8
# Maximum size of the VM disk. The qcow2 only takes the space actually used.
MENTOR_DISK_GB=40
