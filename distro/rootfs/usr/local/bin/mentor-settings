#!/usr/bin/python3
"""Mentor Settings: the few choices a person has about Mentor, on one short page.

Made for someone who does not know what a firewall or a service is: a handful of switches
in plain words, and a button that hands anything else to the assistant. The detail (which
ports, who was refused, each kind of suggestion) is the assistant's to explain when asked;
only the kinds of news and warnings are here, folded away under "More choices".

Nothing here calls a model. "Ask Mentor" and "Let Mentor look" hand a request to the
assistant. What is kept where: /etc/mentor/SETTINGS.md.
"""
import json
import os
import subprocess
import sys
import threading
import time

sys.path.insert(0, "/usr/local/lib/mentor")
import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk, Pango

import mentor_journal
import mentor_security
import mentor_settings
import mentor_tools
import mentor_colors
import mentor_pointer
import mentor_update

CHAT = "/usr/local/bin/mentor-chat"
ADVICE_PATH = "/var/lib/mentor/advice/suggestions.json"  # what the bell holds now (mentor-advisor)
VERSION_PATH = "/etc/mentor/version"
UPDATE_STATE = "/var/lib/mentor/updates/state.json"
UPDATE_WAITING = "/var/lib/mentor/updates/update.json"
UPDATES_INCLUDED = "/etc/mentor/updates-included.json"
REPORTS = os.path.join(GLib.get_user_state_dir(), "mentor", "reports.json")  # sent by problem_report
REPORT_REQUEST = ("Something in Mentor is not working as expected and I want to tell the Mentor repair center, so an update can fix "
                  "it. Ask me in one short question what is wrong, look a little yourself, then use problem_report: show "
                  "me the report as it is and wait for my yes before sending. /etc/mentor/UPDATES.md says how.")
MONTHS = ("January", "February", "March", "April", "May", "June", "July", "August", "September", "October",
          "November", "December")  # what a new build came with (build.sh)
# Asked before a Mentor update is installed: it restarts the system (UPDATES.md). Same words as the chat's.
RESTART_HEADING = "Restart to update?"
RESTART_BODY = ("Mentor restarts the whole system to install the update. It takes about a minute, and the apps you "
                "have open close: save your work in them first. If the new version does not start properly, Mentor "
                "goes back by itself.")

KINDS = {"updates": "Updates for my programs", "disk": "When the disk is getting full",
         "failed": "When something stopped working", "news": "News about the system",
         "gnome": "News about the desktop", "apps": "New applications", "github": "New projects on GitHub",
         "recipes": "Recipes that people found useful", "headlines": "News from Linux sites (with More)"}
WATCHES = {"security": "my safety", "refused": "someone trying to connect to this computer",
           "self": "Mentor itself", "disk": "the disk", "failed": "programs in the background"}


def ask(prompt):
    """Hand a request to the assistant on the desktop."""
    try:
        subprocess.Popen([CHAT, prompt], start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def later(work, done):
    """Run `work` off the window's thread and give its result to `done` on it."""
    def run():
        try:
            result = work()
        except Exception as e:
            result = e
        GLib.idle_add(lambda: done(result) and False)
    threading.Thread(target=run, daemon=True).start()


def button(label, action, suggested=False):
    made = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
    if suggested:
        made.add_css_class("suggested-action")
    made.connect("clicked", lambda *_: action())
    return made


def switch(title, subtitle, active, changed):
    row = Adw.SwitchRow(title=title, subtitle=subtitle, active=active)
    row.connect("notify::active", lambda row, _p: changed(row.get_active()))
    return row


class WidePage(Gtk.ScrolledWindow):
    """A page of groups, like Adw.PreferencesPage but as wide as the window allows (up to 1100 pixels),
    as in the Recipes app: the standard page stops at about 600 and leaves a wide window mostly empty."""

    def __init__(self):
        super().__init__(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24, margin_top=24, margin_bottom=24,
                           margin_start=12, margin_end=12)
        self.set_child(Adw.Clamp(maximum_size=1100, tightening_threshold=900, child=self.box))

    def add(self, group):
        self.box.append(group)


class SettingsWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Mentor Settings", default_width=680, default_height=720)
        self.busy = False  # a switch being set from here, not by the user
        self.look_request = ""
        page = WidePage()

        first = Adw.PreferencesGroup()
        helper = Adw.ActionRow(title="Not sure about something?",
                               subtitle="Ask in your own words. Mentor explains, and can do it for you")
        helper.add_suffix(button("Ask Mentor", lambda: ask(
            "I opened Mentor Settings and I am not sure what to do. Ask me what I would like to change or "
            "understand, and explain it simply."), suggested=True))
        first.add(helper)
        page.add(first)

        safe = Adw.PreferencesGroup(title="Keep me safe")
        self.wall = Adw.SwitchRow(title="Block other computers from getting in",
                                  subtitle="You can still use the internet as always")
        self.wall.connect("notify::active", self.on_firewall)
        safe.add(self.wall)
        safe.add(switch("Let Mentor check by itself when someone tries", "It tells you in the chat what it was, in a few words",
                        bool(mentor_settings.get("auto_review")), lambda on: mentor_settings.put("auto_review", on)))
        self.health = Adw.ActionRow(title="Checking…")
        self.look = button("Let Mentor look", lambda: ask(self.look_request))
        self.look.set_visible(False)
        self.health.add_suffix(self.look)
        safe.add(self.health)
        password = Adw.ActionRow(title="Change my password")
        # GNOME's own page for it (Settings, System, Users: Password, a dialog with the old and the new one), not
        # a Console on passwd: a red title bar and a "Current password:" that shows nothing as one types
        # (2026-10-18). Through /usr/local/bin, which draws Settings without OpenGL (DESKTOP.md, "Settings").
        password.add_suffix(button("Change", lambda: subprocess.Popen(
            ["/usr/local/bin/gnome-control-center", "system", "users"], start_new_session=True)))
        safe.add(password)
        page.add(safe)

        state = mentor_tools._advice_state()
        off = set(mentor_settings.get("watch_off") or [])
        tell = Adw.PreferencesGroup(title="What Mentor tells me")
        tell.add(switch("Warnings when something is wrong", "A yellow or red card in the chat",
                        not set(WATCHES) <= off, self.all_warnings))
        page.add(tell)

        did = Adw.PreferencesGroup(title="What Mentor did")
        changes = Adw.ActionRow(title="See what Mentor changed on this computer",
                                subtitle="Every change, under what you asked for")
        changes.add_suffix(button("Show", self.show_changes))
        did.add(changes)
        page.add(did)

        more = Adw.PreferencesGroup()
        fold = Adw.ExpanderRow(title="More choices", subtitle="Pick which warnings you want, and a few more")
        self.watch_rows = {}
        for key, title in WATCHES.items():
            row = switch("Warn me about " + title, "", key not in off,
                         lambda on, key=key: self.busy or self.one_warning(key, on))
            fold.add_row(row)
            self.watch_rows[key] = row
        fold.add_row(switch("Tell the recipes site about harmful recipes",
                            "When Mentor finds something serious in a recipe that came from the site, it says so, so it can be taken down",
                            bool(mentor_settings.get("report_to_hub")), lambda on: mentor_settings.put("report_to_hub", on)))
        fold.add_row(switch("Offer to write down what I built",
                            "A green card after something worked, to keep how it was done and share it",
                            bool(mentor_settings.get("offer_recipes")), lambda on: mentor_settings.put("offer_recipes", on)))
        fold.add_row(switch("Show the exact command when my password is asked",
                            "For those who read commands. Mentor's own short explanation is shown either way",
                            bool(mentor_settings.get("exact")), lambda on: mentor_settings.put("exact", on)))
        more.add(fold)
        page.add(more)

        # Two tabs: these settings, and Mentor's own updates with their history (the user's wish).
        self.tabs = Adw.ViewStack()
        self.tabs.add_titled_with_icon(page, "settings", "Settings", "emblem-system-symbolic")
        # How it looks, in a tab of its own (the user's wish, 2026-10-19): window colors with their accent sets,
        # and the pointer.
        themes = WidePage()
        themes.add(self.colors_group())
        themes.add(self.pointer_group())
        self.tabs.add_titled_with_icon(themes, "themes", "Themes", "applications-graphics-symbolic")
        self.tabs.add_titled_with_icon(self.suggestions_page(), "suggestions", "Suggestions", "starred-symbolic")
        self.tabs.add_titled_with_icon(self.updates_page(), "updates", "Updates", "software-update-available-symbolic")
        header = Adw.HeaderBar()
        header.set_title_widget(Adw.ViewSwitcher(stack=self.tabs, policy=Adw.ViewSwitcherPolicy.WIDE))
        view = Adw.ToolbarView()
        view.add_top_bar(header)
        view.set_content(self.tabs)
        self.set_content(view)
        self.check()

    # --- safety -------------------------------------------------------------------

    def check(self):
        self.health.set_title("Checking…")
        self.health.set_subtitle("")
        self.look.set_visible(False)
        later(lambda: (mentor_security.firewall(), list(mentor_security.checks())), self.checked)

    def checked(self, result):
        if isinstance(result, Exception):
            self.health.set_title("Could not check")
            self.health.set_subtitle(str(result))
            return
        (on, _why), findings = result
        self.busy = True
        self.wall.set_active(on)
        self.wall.set_sensitive(True)
        self.busy = False
        if not findings:
            self.health.set_title("Everything looks fine")
            return
        self.health.set_title("One thing needs a look" if len(findings) == 1 else f"{len(findings)} things need a look")
        self.health.set_subtitle(findings[0][2] + (" …" if len(findings) > 1 else ""))
        self.look_request = (
            "Mentor Settings says these need a look:\n\n"
            + "\n".join(f"- {title}: {text}" for _key, _level, title, text, _request in findings)
            + "\n\nExplain each to me in simple words, the most important first, and offer to fix them one at a "
            "time. /etc/mentor/SECURITY.md says how.")
        self.look.set_visible(True)

    def on_firewall(self, row, _param):
        if self.busy:
            return
        wanted = row.get_active()
        row.set_sensitive(False)

        def work():
            for operation in (("enable", "start") if wanted else ("stop", "disable")):
                arguments = {"unit": "nftables", "operation": operation, "explain": (
                    "Switching on the block that keeps other computers out of this one." if wanted else
                    "Switching off the block that keeps other computers out. You asked for this in Mentor Settings.")}
                ok, _out = mentor_tools.call("service_control", arguments)  # written into the journal too
                if not ok:
                    return False
            return True

        later(work, lambda _done: self.check())

    # --- what Mentor tells --------------------------------------------------------

    def save_advice(self, change):
        now = mentor_tools._advice_state()
        change(now)
        os.makedirs(os.path.dirname(mentor_tools.ADVICE_STATE), exist_ok=True)
        with open(mentor_tools.ADVICE_STATE, "w") as f:
            json.dump(now, f)

    def one_warning(self, key, wanted):
        now = [k for k in (mentor_settings.get("watch_off") or []) if k != key]
        mentor_settings.put("watch_off", now if wanted else now + [key])

    def all_warnings(self, wanted):
        mentor_settings.put("watch_off", [] if wanted else list(WATCHES))
        self.busy = True
        for row in self.watch_rows.values():
            row.set_active(wanted)
        self.busy = False

    # --- suggestions (their own tab; they were a window of the desktop's menu) ------------------------

    def colors_group(self):
        """Window colors: 20 matched sets of tones and 9 accent sets (mentor_colors.py), each shown as a little
        window, sidebar and content, with its name. A click uses it (DESKTOP.md, "Window colors")."""
        group = Adw.PreferencesGroup(title="Window colors",
                                     description="The colors of the program windows. Programs that are open take them "
                                                 "when they are opened again")
        css = []
        # Three groups, dark, light and accent, each wrapping by itself, five to a row at most: even rows
        # (six and four looked ragged in the wider window, 2026-10-19). Accent: sets whose title bars, taskbar
        # and menus are in one of GNOME's accent colors, which they also set (the user's wish, 2026-10-19).
        flows = {}
        sets = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=12, margin_bottom=12,
                       margin_start=12, margin_end=12)
        for kind, title in ((False, "Dark"), (True, "Light"), ("accent", "Accent")):
            sets.append(Gtk.Label(label=title, xalign=0, css_classes=["heading"], margin_start=6,
                                  margin_top=0 if kind is False else 8))
            flows[kind] = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=5,
                                      min_children_per_line=3, column_spacing=4, row_spacing=10, homogeneous=True)
            sets.append(flows[kind])
        current = mentor_colors.current() or ("GNOME light" if self.light_now() else "GNOME dark")
        first = None
        for i, palette in enumerate(mentor_colors.PALETTES + mentor_colors.ACCENT_PALETTES):
            name, light, window, view, sidebar, header, text = palette
            accent = mentor_colors.is_accent(palette)
            full = mentor_colors.label(palette)  # "Orange accent": what mentor_colors knows it by
            if window is None:  # GNOME's own tones
                window, sidebar, text = ("#fafafb", "#ebebed", "#2e3436") if light else ("#222226", "#2e2e32", "#ffffff")
            if accent:  # its picture shows its color, as its title bars and taskbar will be
                sidebar = header
            css.append(f".swatch-{i} .side {{ background: {sidebar}; }} .swatch-{i} .main {{ background: {window}; }}"
                       f" .swatch-{i} .line {{ background: {text}; opacity: 0.55; }}")
            picture = Gtk.Box(css_classes=["swatch-picture", f"swatch-{i}"], overflow=Gtk.Overflow.HIDDEN,
                              width_request=72, height_request=46)
            side = Gtk.Box(css_classes=["side"], width_request=22, orientation=Gtk.Orientation.VERTICAL,
                           spacing=5, margin_start=0)
            main = Gtk.Box(css_classes=["main"], hexpand=True, orientation=Gtk.Orientation.VERTICAL, spacing=5)
            for box, widths in ((side, (12, 8, 10)), (main, (32, 22))):
                for k, w in enumerate(widths):
                    box.append(Gtk.Box(css_classes=["line"], width_request=w, height_request=3,
                                       halign=Gtk.Align.START, margin_start=6, margin_top=8 if k == 0 else 0))
            picture.append(side)
            picture.append(main)
            label = Gtk.Label(label=name, css_classes=["caption"], wrap=True, wrap_mode=Pango.WrapMode.WORD,
                              max_width_chars=9, justify=Gtk.Justification.CENTER)  # "Warm / charcoal"
            content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            content.append(picture)
            content.append(label)
            choice = Gtk.ToggleButton(child=content, css_classes=["flat", "swatch"], tooltip_text=full,
                                      active=full == current)
            if first is None:
                first = choice
            else:
                choice.set_group(first)
            choice.connect("toggled", lambda b, full=full: b.get_active() and self.use_colors(full))
            flows["accent" if accent else light].append(choice)
        provider = Gtk.CssProvider()
        provider.load_from_string("\n".join(css) + "\n.swatch-picture { border-radius: 8px; "
                                  "border: 1px solid alpha(currentColor, 0.15); }\n"
                                  ".swatch { padding: 6px; border-radius: 12px; }\n"
                                  ".swatch:checked { background: alpha(@accent_bg_color, 0.25); "
                                  "box-shadow: inset 0 0 0 2px @accent_bg_color; }\n")
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        group.add(Gtk.ListBoxRow(activatable=False, child=sets))
        self.colors_note = Gtk.Label(label="", css_classes=["dim-label", "caption"], xalign=0, wrap=True,
                                     visible=False, margin_top=6)
        group.add(self.colors_note)
        return group

    def pointer_group(self):
        """The mouse pointer: black (GNOME's own), white, or the accent color, and its size (mentor_pointer.py;
        DESKTOP.md, "Pointer"). Both change at once."""
        group = Adw.PreferencesGroup(title="Pointer", description="The mouse pointer's color and size")
        color_now, size_now = mentor_pointer.current()
        colors = Adw.ActionRow(title="Color")
        buttons = Gtk.Box(css_classes=["linked"], valign=Gtk.Align.CENTER)
        first = None
        for color in mentor_pointer.COLORS:
            choice = Gtk.ToggleButton(label=color.capitalize(), active=color == color_now,
                                      tooltip_text="The accent color, as it changes" if color == "accent" else None)
            if first is None:
                first = choice
            else:
                choice.set_group(first)
            choice.connect("toggled", lambda b, color=color: b.get_active() and later(
                lambda: mentor_pointer.apply(color), lambda _result: None))
            buttons.append(choice)
        colors.add_suffix(buttons)
        group.add(colors)
        size = Adw.ActionRow(title="Size")
        sizes = mentor_pointer.SIZES
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, len(sizes) - 1, 1)
        scale.set_size_request(260, -1)
        scale.set_draw_value(False)
        scale.set_round_digits(0)
        scale.set_valign(Gtk.Align.CENTER)
        for i in range(len(sizes)):
            scale.add_mark(i, Gtk.PositionType.BOTTOM, None)
        scale.set_value(min(range(len(sizes)), key=lambda i: abs(sizes[i] - size_now)))
        pending = {}

        def moved(widget):
            # set when the slider rests a moment: every step of a drag would change the pointer under the hand
            if pending.get("id"):
                GLib.source_remove(pending["id"])

            def now():
                pending["id"] = 0
                index = int(round(widget.get_value()))
                widget.set_value(index)
                later(lambda: mentor_pointer.apply(size=sizes[index]), lambda _result: None)
                return False
            pending["id"] = GLib.timeout_add(250, now)
        scale.connect("value-changed", moved)
        size.add_suffix(scale)
        group.add(size)
        return group

    @staticmethod
    def light_now():
        return Gio.Settings.new("org.gnome.desktop.interface").get_string("color-scheme") == "prefer-light"

    def use_colors(self, name):
        palette = mentor_colors.apply(name)
        if palette:
            # This window takes them at once, over what it read at its start: GNOME's light or dark style
            # changes at once too, and between the two a window showed white text on a light card (2026-10-18).
            if getattr(self, "live_colors", None) is None:
                self.live_colors = Gtk.CssProvider()
                Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self.live_colors,
                                                          Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
            self.live_colors.load_from_string(mentor_colors.live_css(name))
            self.colors_note.set_label(f"{name} is in use. Programs that are open show it when they are opened again.")
            self.colors_note.set_visible(True)

    def suggestions_page(self):
        """The bell's suggestions: on or off, which kinds, and everything the user turned away, each with
        the way back. Kept in ~/.config/mentor/advice.json, which the desktop watches (SUGGESTIONS.md)."""
        page = WidePage()
        main = Adw.PreferencesGroup(description=(
            "The system looks itself over now and then and notes what may be worth your attention. It waits behind "
            "the bell on the desktop. Nothing goes to the assistant until you send it to the chat."))
        state = mentor_tools._advice_state()
        main.add(switch("Suggest things for this system", "Behind the bell on the desktop", not state["off"],
                        lambda on: self.save_advice(lambda s: s.update(off=not on))))
        page.add(main)
        kinds = Adw.PreferencesGroup(title="What to suggest")
        self.kind_rows = {}
        for kind, title in KINDS.items():
            row = switch(title, "", kind not in state["never"], lambda on, kind=kind: self.busy or self.save_advice(
                lambda s: s.update(never=[k for k in s["never"] if k != kind] + ([] if on else [kind]))) or self.show_hidden())
            kinds.add(row)
            self.kind_rows[kind] = row
        page.add(kinds)
        self.hidden = Adw.PreferencesGroup(title="Not suggested any more")
        self.hidden_rows = []
        page.add(self.hidden)
        self.show_hidden()
        return page

    def show_hidden(self):
        """What the user turned away: kinds they never want, and suggestions put off until a day."""
        for row in self.hidden_rows:
            self.hidden.remove(row)
        self.hidden_rows = []
        state = mentor_tools._advice_state()
        self.busy = True
        for kind, row in self.kind_rows.items():
            row.set_active(kind not in state["never"])
        self.busy = False

        def bring_back(change):
            self.save_advice(change)
            self.show_hidden()

        def add(title, subtitle, change):
            row = Adw.ActionRow(title=title, subtitle=subtitle)
            row.add_suffix(button("Bring back", lambda: bring_back(change)))
            self.hidden.add(row)
            self.hidden_rows.append(row)

        for kind in state["never"]:
            add(KINDS.get(kind, kind), "You chose not to be told about these again",
                lambda s, kind=kind: s.update(never=[k for k in s["never"] if k != kind]))
        try:
            with open(ADVICE_PATH) as f:
                titles = {s["id"]: s.get("title") for s in json.load(f) if isinstance(s, dict) and s.get("id")}
        except (OSError, ValueError):
            titles = {}
        for key, when in sorted(state.get("until", {}).items(), key=lambda item: item[1]):
            if when > time.time():
                add(titles.get(key) or key, "Put off until " + time.strftime("%-d %B", time.localtime(when)),
                    lambda s, key=key: s["until"].pop(key, None))
        if not self.hidden_rows:
            row = Adw.ActionRow(title="Nothing is hidden", subtitle="What you turn away is listed here")
            self.hidden.add(row)
            self.hidden_rows.append(row)

    # --- updates (their own tab) ---------------------------------------------------------

    def updates_page(self):
        """Which Mentor this is, an update that is waiting (with the buttons of the card in the chat), a
        way to look now, and every update this Mentor had, each with Ask Mentor to have it reviewed.
        The work is mentor-update's, as root (UPDATES.md)."""
        page = WidePage()
        now = Adw.PreferencesGroup(title="This Mentor")
        self.update_row = Adw.ActionRow(title="Checking…")
        self.update_row.set_subtitle_lines(4)
        self.whats_new = button("What's new?", lambda: ask(self.whats_new_request))
        self.whats_new.set_visible(False)
        self.whats_new_request = ""
        self.update_row.add_suffix(self.whats_new)
        self.update_button = button("Update", self.install_update, suggested=True)
        self.update_button.set_visible(False)
        self.update_row.add_suffix(self.update_button)
        now.add(self.update_row)
        self.look_row = Adw.ActionRow(title="Look for an update now", subtitle="Mentor also looks by itself once a day")
        self.look_button = button("Look", self.look_for_update)
        self.look_row.add_suffix(self.look_button)
        now.add(self.look_row)
        page.add(now)
        self.history = Adw.PreferencesGroup(title="Every update",
                                            description="By year and month, newest first. Ask Mentor goes over one with you")
        self.history_rows = []
        self.history_open = set()  # the years and months opened ("2026", "2026-10")
        page.add(self.history)
        # The problems this user reported to Mentor's maker (problem_report), and which update fixed each.
        self.reports = Adw.PreferencesGroup(title="Problems you reported",
                                            description="Only the Mentor repair center reads them. An update that fixes one says so")
        report = Adw.ActionRow(title="Something is not working as expected?",
                               subtitle="Mentor puts a short report together, shows it to you, and sends it only if you say so")
        report.add_suffix(button("Report a problem", lambda: ask(REPORT_REQUEST)))
        self.reports.add(report)
        self.report_rows = []
        page.add(self.reports)
        self.show_update()
        # The update card in the chat starts an install too: this page follows it (through the log the
        # install writes to as it starts), so that only one Update button is ever pressed.
        try:
            self.update_log = Gio.File.new_for_path(mentor_update.LOG).monitor_file(Gio.FileMonitorFlags.NONE, None)
            self.update_log.connect("changed", lambda *_: self.follow_update())
        except GLib.Error:
            pass
        return page

    def follow_update(self):
        if not self.waiting_version:
            return
        stage = mentor_update.apply_stage(self.waiting_version)
        if stage == "installing" and self.update_button.get_label() != "Updating…":
            self.update_button.set_sensitive(False)
            self.update_button.set_label("Updating…")
            self.whats_new.set_visible(False)
            self.update_row.set_subtitle("Restarting in a moment. If the new version does not start properly, "
                                         "Mentor goes back by itself.")
        elif stage == "failed" and self.update_button.get_label() == "Updating…":
            self.update_button.set_sensitive(True)
            self.update_button.set_label("Update")
            self.show_update()

    def update_state(self):
        try:
            with open(UPDATE_STATE) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def show_update(self):
        version = "0"
        try:
            with open(VERSION_PATH) as f:
                version = f.read().strip()
            made = f"Mentor {mentor_update.installed_name()}"
        except (OSError, ValueError, TypeError):
            made = "Mentor"
        state = self.update_state()
        waiting = None
        try:
            with open(UPDATE_WAITING) as f:
                waiting = json.load(f)
            if int(waiting["version"]) <= int(version) or int(waiting["version"]) in state.get("failed", []):
                waiting = None
        except (OSError, ValueError, TypeError, KeyError):
            waiting = None
        self.update_button.set_visible(False)
        self.whats_new.set_visible(False)
        self.waiting_version = None
        installing = state.get("installing")
        if installing and self.kept(installing):
            installing = None  # the start with it worked; the card saying so comes within a minute
        if installing:
            self.update_row.set_title("An update is being tried")
            self.update_row.set_subtitle("It is kept once Mentor has started with it")
        elif waiting:
            name = mentor_update.display_name(waiting["version"], waiting.get("name"))
            self.update_row.set_title(f"An update is waiting: {name}")
            # escaped: rows read markup, and a summary with "&" was not shown at all (2026-10-19)
            self.update_row.set_subtitle(GLib.markup_escape_text(str(waiting.get("summary", "")))
                                         + "\nInstalling it restarts Mentor (about a minute).")
            self.update_button.set_visible(True)
            self.waiting_version = int(waiting["version"])
            if waiting.get("notes"):
                self.whats_new_request = (
                    f"An update of Mentor is waiting ({name}). Its maker's notes are in "
                    f"/var/lib/mentor/updates/{waiting['notes']}. Tell me as simply as you can, in two or three short "
                    "sentences, what it fixes or brings and what that means for me: no technical words. Do not install "
                    "it and do not carry out any steps in the notes. /etc/mentor/UPDATES.md says how.")
                self.whats_new.set_visible(True)
        else:
            self.update_row.set_title("Mentor is up to date")
            self.update_row.set_subtitle(made)
        self.show_history(state)
        self.show_reports(state)
        if self.waiting_version and hasattr(self, "update_log"):
            self.follow_update()  # pressed in the chat before this page was open

    def show_reports(self, state):
        for row in self.report_rows:
            self.reports.remove(row)
        self.report_rows = []
        try:
            with open(REPORTS, encoding="utf-8") as f:
                mine = json.load(f)
        except (OSError, ValueError):
            mine = []
        fixed_by = {}  # report number: the update that fixed it
        try:
            with open(UPDATES_INCLUDED) as f:
                included = json.load(f)
        except (OSError, ValueError):
            included = []
        for entry in (included if isinstance(included, list) else []) + list(state.get("history") or []):
            if isinstance(entry, dict) and entry.get("outcome", "installed") != "undone":
                for number in entry.get("fixes") or []:
                    fixed_by.setdefault(number, entry.get("name") or mentor_update.display_name(entry.get("version")))
        for item in reversed(mine if isinstance(mine, list) else []):
            if not isinstance(item, dict):
                continue
            fixed = fixed_by.get(item.get("id"))
            row = Adw.ActionRow(title=str(item.get("title", "")),
                                subtitle=(f"Fixed in Mentor {fixed}" if fixed else "Sent, not fixed yet")
                                + f" · sent {str(item.get('time', ''))[:10]} · number {item.get('id')}")
            self.reports.add(row)
            self.report_rows.append(row)

    def kept(self, installing):
        """The start with this update reached the desktop (mentor_boot), so it stays."""
        try:
            with open(f"/var/lib/mentor/changes/{installing['change']}/manifest.json") as f:
                applied = json.load(f).get("state") == "applied"
            with open("/var/lib/mentor/boot/state.json") as f:
                return applied and json.load(f).get("phase") == "ok"
        except (OSError, ValueError, KeyError, TypeError):
            return False

    def show_history(self, state):
        for row in self.history_rows:
            self.history.remove(row)
        self.history_rows = []
        entries = list(state.get("history") or [])
        last = state.get("installed")  # from before the history was kept
        if last and not any(e.get("version") == last.get("version") for e in entries):
            entries.append({"version": last["version"], "name": last.get("name"), "outcome": "installed",
                            "time": str(last.get("time", ""))[:16], "summary": ""})
        # The updates published before this Mentor was built: it came with them (build.sh).
        try:
            with open(UPDATES_INCLUDED) as f:
                included = json.load(f)
        except (OSError, ValueError):
            included = []
        known = {e.get("version") for e in entries}
        for e in included if isinstance(included, list) else []:
            if isinstance(e, dict) and e.get("version") not in known:
                notes = f"/etc/mentor/update-notes/{e.get('version')}.md"
                entries.append({"version": e.get("version"), "name": e.get("name"), "summary": e.get("summary", ""),
                                "outcome": "included", "time": e.get("published", ""),
                                "notes": notes if os.path.exists(notes) else None})
        entries.sort(key=lambda e: int(e.get("version") or 0))
        if not entries:
            row = Adw.ActionRow(title="No updates yet", subtitle="Each update this Mentor gets is listed here")
            self.history.add(row)
            self.history_rows.append(row)
            return
        # By year, then month, then the updates of that month (the user's wish): each a row that opens.
        # What was open stays open when the list is shown again (after Look).
        tree = {}
        for entry in entries:
            year, month = self.when_made(entry)
            tree.setdefault(year, {}).setdefault(month, []).append(entry)
        for year in sorted(tree, reverse=True):
            count = sum(len(month) for month in tree[year].values())
            year_row = Adw.ExpanderRow(title=str(year), subtitle=self.how_many(count),
                                       expanded=f"{year}" in self.history_open)
            year_row.connect("notify::expanded", self.remember_open, f"{year}")
            for month in sorted(tree[year], reverse=True):
                month_row = Adw.ExpanderRow(title=MONTHS[month - 1], subtitle=self.how_many(len(tree[year][month])),
                                            expanded=f"{year}-{month}" in self.history_open)
                month_row.connect("notify::expanded", self.remember_open, f"{year}-{month}")
                for entry in reversed(tree[year][month]):
                    month_row.add_row(self.update_entry_row(entry))
                year_row.add_row(month_row)
            self.history.add(year_row)
            self.history_rows.append(year_row)

    @staticmethod
    def how_many(count):
        return "1 update" if count == 1 else f"{count} updates"

    @staticmethod
    def when_made(entry):
        """(year, month) of an update: from the date it was installed or published, else its version."""
        for text in (str(entry.get("time") or ""), str(entry.get("version") or "")):
            try:
                if len(text) >= 7 and text[4] == "-":
                    return int(text[:4]), int(text[5:7])
                if len(text) >= 6 and text[:6].isdigit():
                    return int(text[:4]), int(text[4:6])
            except ValueError:
                pass
        return 0, 1

    def remember_open(self, row, _param, key):
        if row.get_expanded():
            self.history_open.add(key)
        else:
            self.history_open.discard(key)

    def update_entry_row(self, entry):
        name = entry.get("name") or mentor_update.display_name(entry.get("version"))
        undone = entry.get("outcome") == "undone"
        when = str(entry.get("time", ""))
        if entry.get("outcome") == "included":
            when = "Came with this Mentor" + (f" (published {when})" if when else "")
        row = Adw.ActionRow(title=f"Mentor {name}" + (" — went back" if undone else ""),
                            subtitle=GLib.markup_escape_text((entry.get("summary") or "") + (f"\n{when}" if when else "")))
        row.set_subtitle_lines(4)
        row.add_suffix(button("Ask Mentor", lambda entry=entry, name=name, undone=undone:
                              ask(self.review_request(entry, name, undone))))
        return row

    def review_request(self, entry, name, undone):
        """What Ask Mentor hands the assistant about one update."""
        if undone:
            return (f"Mentor update {name} was undone by itself on {entry.get('time')}: the start after it did not reach "
                    "the desktop. Find out why (boot_status, and the log of that start), and tell me as simply as you "
                    "can what happened and whether I need to do anything. Do not change anything before I agree. "
                    "/etc/mentor/UPDATES.md says how.")
        notes = entry.get("notes")
        installed = ("it came with this Mentor" if entry.get("outcome") == "included" else
                     f"installed {entry.get('time')}")
        return (f"Go over Mentor update {name} with me ({installed}). "
                + (f"Its maker's notes are in {notes}. " if notes else "It came without notes. ")
                + (f"The change it made is {entry['change']} (change_list). " if entry.get("change") else "")
                + "First tell me as simply as you can what it changed and what that means for me. Then check that "
                "those parts work: mentor verify, and the checks in its notes. Say what you found in a sentence or two. "
                "Do not change anything before I agree. /etc/mentor/UPDATES.md says how.")

    def agent_busy(self):
        return subprocess.run(["pgrep", "-u", str(os.getuid()), "-f", "(^|/)(agy|claude|codex|mentor-agent)( |$)"],
                              stdout=subprocess.DEVNULL).returncode == 0

    def install_update(self):
        if self.agent_busy():
            # Said plainly, with a way to wait, as the chat's card does (the user, 2026-10-19).
            dialog = Adw.AlertDialog(
                heading="Mentor is still working",
                body="The assistant is in the middle of something. Restarting now would stop it halfway.\n\n"
                     "Mentor can update as soon as it is done. It asks you again before it restarts.")
            dialog.add_response("cancel", "Not now")
            dialog.add_response("later", "Update when it's done")
            dialog.set_response_appearance("later", Adw.ResponseAppearance.SUGGESTED)
            dialog.set_default_response("later")
            dialog.set_close_response("cancel")

            def answered(_dialog, response):
                if response != "later":
                    return
                self.update_row.set_subtitle("Mentor updates when it has finished what it is doing")
                self.update_button.set_sensitive(False)

                def look():  # every few seconds; this window may be closed meanwhile, then nothing happens
                    if self.agent_busy():
                        return True
                    self.update_button.set_sensitive(True)
                    self.install_update()
                    return False
                GLib.timeout_add_seconds(5, look)
            dialog.connect("response", answered)
            dialog.present(self)
            return
        # The restart comes a second or two after the install starts: ask before (as the chat's card does).
        dialog = Adw.AlertDialog(heading=RESTART_HEADING, body=RESTART_BODY)
        dialog.add_response("cancel", "Not now")
        dialog.add_response("restart", "Restart and update")
        dialog.set_response_appearance("restart", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _dialog, response: response == "restart" and self.start_update())
        dialog.present(self)

    def start_update(self):
        if self.agent_busy():
            return
        self.update_button.set_sensitive(False)
        self.update_button.set_label("Updating…")
        self.update_row.set_subtitle("Restarting in a moment. If the new version does not start properly, "
                                     "Mentor goes back by itself.")

        def done(result):
            if isinstance(result, Exception) or result.returncode:
                self.update_button.set_sensitive(True)
                self.update_button.set_label("Update")
                self.update_row.set_subtitle("The update could not be started: "
                                             + (str(result) if isinstance(result, Exception) else result.stderr.strip()))
        later(lambda: subprocess.run(["systemctl", "start", "--no-block", "mentor-update-apply.service"],
                                     capture_output=True, text=True), done)

    def look_for_update(self):
        self.look_button.set_sensitive(False)
        self.look_row.set_subtitle("Looking…")

        def done(result):
            self.look_button.set_sensitive(True)
            if isinstance(result, Exception) or result.returncode:
                self.look_row.set_subtitle("Could not look just now. Mentor tries again by itself tomorrow")
            else:
                self.look_row.set_subtitle("Mentor also looks by itself once a day")
            self.show_update()
        # Without --no-block: it returns when the look is over (a found update is also downloaded).
        later(lambda: subprocess.run(["systemctl", "start", "mentor-update-check.service"],
                                     capture_output=True, text=True, timeout=1800), done)

    # --- what Mentor did ----------------------------------------------------------

    def show_changes(self):
        dialog = Adw.Dialog(title="What Mentor changed", content_width=720, content_height=600)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=8, margin_bottom=12,
                      margin_start=14, margin_end=14)
        search = Gtk.SearchEntry(placeholder_text="Look for a program, a setting, something you asked")
        text = Gtk.TextView(editable=False, cursor_visible=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                            left_margin=10, right_margin=10, top_margin=8, bottom_margin=8)
        scrolled = Gtk.ScrolledWindow(child=text, vexpand=True)
        scrolled.add_css_class("card")

        def fill(*_):
            found, _left_out = mentor_journal.entries(search.get_text(), 300, False)
            text.get_buffer().set_text(mentor_journal.readable(found, 0) if found else
                                       "Nothing yet. When you ask Mentor to change something, it is written here.")
        search.connect("search-changed", fill)
        fill()
        box.append(search)
        box.append(scrolled)
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(box)
        dialog.set_child(view)
        dialog.present(self)


# A month inside an open year: libadwaita draws its arrow from the year's open state (the rule for
# an open row reaches the rows inside it), so a closed month looked open. Put back as closed.
NESTED_ARROW_CSS = """
row.expander:checked row.expander:not(:checked) image.expander-row-arrow {
  -gtk-icon-transform: rotate(0.5turn);
  color: inherit;
}
"""


class SettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.mentor.Settings", flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.window = None

    def do_command_line(self, command_line):
        if self.window is None:
            css = Gtk.CssProvider()
            css.load_from_string(NESTED_ARROW_CSS)
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.window = SettingsWindow(self)
        asked = command_line.get_arguments()[1:]
        if "updates" in asked:  # mentor settings updates: straight to that tab
            self.window.tabs.set_visible_child_name("updates")
            self.window.show_update()
        elif "suggestions" in asked:
            self.window.tabs.set_visible_child_name("suggestions")
            self.window.show_hidden()
        elif "themes" in asked:  # mentor settings themes: window colors and the pointer
            self.window.tabs.set_visible_child_name("themes")
        self.window.present()
        return 0


sys.exit(SettingsApp().run(sys.argv))
