def open_attachment(path, widget=None):
    """A click on an attached file: a picture is shown at once over the chat (preview_picture), anything
    else opens in its usual program, in a scope of its own so that it outlives the chat's restarts."""
    if not os.path.exists(path):
        return
    if path.lower().endswith(PICTURES) and widget is not None and preview_picture(path, widget):
        return
    launch(["gio", "open", path])


def launch(argv):
    try:
        GLib.spawn_async(["systemd-run", "--user", "--scope", "--quiet", "--collect", "--"] + argv,
                         flags=GLib.SpawnFlags.SEARCH_PATH)
    except GLib.Error:
        pass


# Links in an answer (the user's wish, 2026-10-22): the agent writes [name](target) for a file, an
# installed app, a page of GNOME Settings or a web page; the chat draws the name in blue with that
# thing's icon in front, as a picked app is drawn in the text box, and a click opens it. Only these
# kinds are ever opened, and only what is there: a link to nothing is shown as its name.
LINK = re.compile(r"\[([^\]\n]+)\]\(((?:file|app|settings|https?):[^)\s]+)\)")
LINK_MARK = re.compile("(\\d+)")


def link_target(target):
    """(icon, what to open) for a link's target, or None when there is nothing there to open."""
    kind, _, rest = target.partition(":")
    if kind == "file":
        try:
            path = GLib.filename_from_uri(target)[0]
        except GLib.Error:
            return None
        if not os.path.exists(path):
            return None
        if os.path.isdir(path):
            return Gio.ThemedIcon.new("folder"), ("file", path)
        return Gio.content_type_get_icon(Gio.content_type_guess(path, None)[0]), ("file", path)
    if kind in ("app", "settings"):
        name = rest.removesuffix(".desktop")
        if not re.fullmatch(r"[\w.-]+", name):
            return None
        # a page of Settings has a desktop file of its own, with its icon: gnome-display-panel.desktop
        desktop = f"gnome-{name}-panel.desktop" if kind == "settings" else name + ".desktop"
        try:
            info = Gio.DesktopAppInfo.new(desktop)
        except TypeError:
            info = None
        if info is None:
            return None
        return info.get_icon(), (kind, name if kind == "settings" else desktop)
    return Gio.ThemedIcon.new("web-browser-symbolic"), ("web", target)


def with_links(text):
    """The answer with each link that can be opened put as a mark (N), and the links:
    [(name, icon, what to open)]."""
    links = []

    def put(found):
        target = link_target(found.group(2))
        if target is None:
            return found.group(1)
        links.append((found.group(1), *target))
        return f"{len(links) - 1}"
    return LINK.sub(put, text), links


def open_link(what, widget):
    kind, value = what
    if kind == "file":
        open_attachment(value, widget)
    elif kind == "app":
        launch(["gtk-launch", value])
    elif kind == "settings":
        launch(["gnome-control-center", value])
    else:
        launch(["gio", "open", value])


class AnswerView(Gtk.TextView):
    """An answer with links in it (LINK). Every other answer is a Gtk.Label, which cannot hold an
    icon; this is text that can be selected in the same way, with each link's icon in front of its
    blue name (a child anchor, as in AskBox). It answers to what the chat asks of an answer's label:
    set_markup, get_text, get_selection_bounds."""

    def __init__(self, links):
        # Full width until fit narrows it: laid out first at the few pixels a text view asks for, it
        # kept the height of a letter a line, the card reaching down to the text box (a restored
        # conversation, 2026-10-22); it grows taller when narrowed, but never shrank back.
        super().__init__(editable=False, cursor_visible=False, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                         hexpand=True, halign=Gtk.Align.FILL, valign=Gtk.Align.START)
        self.links = links
        self.opens = {}  # the tag of each link -> what it opens
        click = Gtk.GestureClick()
        click.connect("released", self.on_click)
        self.add_controller(click)
        motion = Gtk.EventControllerMotion()
        motion.connect("motion", lambda _m, x, y: self.set_cursor_from_name("pointer" if self.link_at(x, y) else None))
        self.add_controller(motion)
        self.connect("map", lambda *_: GLib.idle_add(self.fit))
        # The right-click menu of an answer's label (Copy, Select All, Quote), not a text view's, which
        # would add Cut, Paste, Delete, Undo and Redo, all greyed out, to read-only text.
        menu_click = Gtk.GestureClick(button=Gdk.BUTTON_SECONDARY, propagation_phase=Gtk.PropagationPhase.CAPTURE)
        menu_click.connect("pressed", self.on_menu)
        self.add_controller(menu_click)

    def on_menu(self, gesture, _n, x, y):
        gesture.set_state(Gtk.EventSequenceState.CLAIMED)
        menu = Gio.Menu()
        menu.append("Copy", "clipboard.copy")
        menu.append("Select All", "selection.select-all")
        menu.append("Quote", "message.quote")
        popover = Gtk.PopoverMenu.new_from_model(menu)
        popover.set_parent(self)
        popover.set_has_arrow(False)
        at = Gdk.Rectangle()
        at.x, at.y, at.width, at.height = int(x), int(y), 1, 1
        popover.set_pointing_to(at)
        popover.connect("closed", lambda p: GLib.idle_add(p.unparent))
        popover.popup()

    def set_markup(self, markup):
        buffer = self.get_buffer()
        buffer.set_text("")
        self.opens.clear()
        buffer.insert_markup(buffer.get_end_iter(), markup, -1)
        text = buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(), True)
        for found in reversed(list(LINK_MARK.finditer(text))):  # from the end, so the offsets before stay right
            if int(found.group(1)) >= len(self.links):
                continue
            name, icon, what = self.links[int(found.group(1))]
            at = buffer.get_iter_at_offset(found.start())
            buffer.delete(at, buffer.get_iter_at_offset(found.end()))
            tag = buffer.create_tag(None, foreground="#78aeed")
            self.opens[tag] = what
            anchor = buffer.create_child_anchor(at)  # at now stands after the icon
            self.add_child_at_anchor(Gtk.Image(gicon=icon, pixel_size=16, margin_end=3), anchor)
            buffer.insert_with_tags(at, name, tag)

    def get_text(self):
        buffer = self.get_buffer()
        return buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(), True)

    def get_selection_bounds(self):
        """As Gtk.Label's: (selected, start, end) in get_text, which has no character for an icon."""
        buffer = self.get_buffer()
        bounds = buffer.get_selection_bounds()
        if not bounds:
            return False, 0, 0
        whole = buffer.get_slice(buffer.get_start_iter(), buffer.get_end_iter(), True)
        a, b = bounds[0].get_offset(), bounds[1].get_offset()
        return True, a - whole[:a].count("￼"), b - whole[:b].count("￼")

    def link_at(self, x, y):
        bx, by = self.window_to_buffer_coords(Gtk.TextWindowType.WIDGET, int(x), int(y))
        found, at = self.get_iter_at_location(bx, by)
        if not found:
            return None
        after = at.copy()
        after.forward_char()  # on an icon: the name after it
        for spot in (at, after):
            for tag in spot.get_tags():
                if tag in self.opens:
                    return self.opens[tag]
        return None

    def on_click(self, gesture, _n, x, y):
        if self.get_buffer().get_has_selection():
            return  # words were selected, not a link clicked
        what = self.link_at(x, y)
        if what:
            open_link(what, self)

    def fit(self):
        """As wide as its longest line, as a label is, up to the column's width."""
        column = self.get_ancestor(Adw.Clamp)
        widest = column.get_maximum_size() if column else CHAT_WIDTH
        # A text view lays its text out later, in the background, so its own measure says nearly
        # nothing yet: the lines are measured in its font (bold a little wider), the icons and the
        # card's padding added.
        line = self.create_pango_layout(self.get_text()).get_pixel_size()[0]
        natural = int(line * 1.04) + 20 * len(self.opens) + 32
        if natural < widest - 32:
            self.set_hexpand(False)
            self.set_halign(Gtk.Align.START)
            self.set_size_request(natural + 2, -1)
        return GLib.SOURCE_REMOVE


def clickable(widget, path):
    """`widget` opens `path` (open_attachment) when clicked, with a hand pointer over it; a right click
    offers "Open with…" (GNOME's list of programs, Gradia among them)."""
    widget.set_cursor(Gdk.Cursor.new_from_name("pointer", None))
    click = Gtk.GestureClick()
    click.connect("released", lambda *_: open_attachment(path, widget))
    widget.add_controller(click)
    menu_click = Gtk.GestureClick(button=Gdk.BUTTON_SECONDARY)
    menu_click.connect("pressed", lambda _g, _n, x, y: open_with_menu(path, widget, at=(x, y)))
    widget.add_controller(menu_click)


def open_with_menu(path, widget, dialog=None, at=None):
    """The right-click menu of an attached file, at the pointer (`at`, in `widget`); `dialog`, the
    preview it is in, closes on a choice."""
    if not os.path.exists(path):
        return
    popover = Gtk.Popover(has_arrow=False)
    popover.set_parent(widget)
    if at:
        spot = Gdk.Rectangle()
        spot.x, spot.y, spot.width, spot.height = int(at[0]), int(at[1]), 1, 1
        popover.set_pointing_to(spot)
    popover.connect("closed", lambda *_: GLib.idle_add(popover.unparent))
    items = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

    def item(label, act):
        button = Gtk.Button(label=label)
        button.add_css_class("flat")
        button.get_child().set_xalign(0)
        button.connect("clicked", lambda *_: (popover.popdown(), act(), dialog and dialog.close()))
        items.append(button)

    # The list of programs belongs to the window under the preview (a preview over the ask bar is a
    # window of its own, closed now); after it, that window is in front again.
    root = widget.get_root()
    if dialog and root.get_transient_for():
        root = root.get_transient_for()

    def chosen(launcher, result):
        try:
            launcher.launch_finish(result)
        except GLib.Error:
            pass
        if root.get_visible():
            root.present()

    def open_with():
        Gtk.FileLauncher(file=Gio.File.new_for_path(path), always_ask=True).launch(root, None, chosen)

    item("Open with\u2026", open_with)
    popover.set_child(items)
    popover.popup()


PREVIEW_MOST = (1100, 680)  # the largest a preview gets, in pixels; a smaller picture is shown as it is


def preview_picture(path, widget):
    """A pasted or attached picture, quickly: a dialog over the chat, sized to the picture. A click on it,
    Esc or the close button closes it; a right click offers "Open with…" (open_with_menu)."""
    try:
        texture = Gdk.Texture.new_from_filename(path)
    except GLib.Error:
        return False
    width, height = texture.get_width(), texture.get_height()
    scale = min(1.0, PREVIEW_MOST[0] / max(1, width), PREVIEW_MOST[1] / max(1, height))
    dialog = Adw.Dialog(title=os.path.basename(path), content_width=max(360, round(width * scale) + 24),
                        content_height=round(height * scale) + 76)
    dialog.add_css_class("advice-details")
    picture = Gtk.Picture(paintable=texture, content_fit=Gtk.ContentFit.CONTAIN, can_shrink=True,
                          margin_start=12, margin_end=12, margin_bottom=12)
    close = Gtk.GestureClick()
    close.connect("released", lambda *_: dialog.close())
    picture.add_controller(close)
    menu_click = Gtk.GestureClick(button=Gdk.BUTTON_SECONDARY)
    menu_click.connect("pressed", lambda _g, _n, x, y: open_with_menu(path, picture, dialog, (x, y)))
    picture.add_controller(menu_click)
    view = Adw.ToolbarView(content=picture)
    view.add_top_bar(dialog_header(dialog))
    keep_still(view)
    dialog.set_child(view)
    # Over the small ask bar (Super+Z) the preview is a window of its own: the bar is in front again after.
    root = widget.get_root()
    dialog.connect("closed", lambda *_: root.get_visible() and root.present())
    dialog.present(widget)
    return True
