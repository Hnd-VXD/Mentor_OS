def to_markup(text):
    """The little Markdown the agent is asked to use, as Pango markup."""
    out = GLib.markup_escape_text(text, -1)
    out = re.sub(r"```\w*\n(.*?)```", r"<tt>\1</tt>", out, flags=re.S)
    out = re.sub(r"`([^`\n]+)`", r"<tt>\1</tt>", out)
    out = re.sub(r"\*\*([^*\n]+)\*\*", r"<b>\1</b>", out)
    out = re.sub(r"(?m)^#{1,6} +(.+)$", r"<b>\1</b>", out)
    out = re.sub(r"(?m)^(\s*)[-*] +", "\\1\u2022 ", out)
    try:
        Pango.parse_markup(out, -1, "\0")
    except GLib.Error:
        return GLib.markup_escape_text(text, -1)
    return out


def told_when(moment):
    """A moment of a conversation, as one says it: the day only when it is not today."""
    then, now = time.localtime(moment), time.localtime()
    clock = time.strftime("%H:%M", then)
    if then[:3] == now[:3]:
        return f"Today, {clock}"
    year = "" if then.tm_year == now.tm_year else f" {then.tm_year}"
    return f"{then.tm_mday} {time.strftime('%B', then)}{year}, {clock}"


def window_name(minutes):
    """What a usage window is called: by its length, as the accounts' own pages do."""
    if not minutes:
        return "Usage limit"
    if minutes <= 6 * 60:
        return "Session limit"
    if 6 * 24 * 60 <= minutes <= 8 * 24 * 60:
        return "Weekly limit"
    return f"{round(minutes / 60)}-hour limit" if minutes < 48 * 60 else f"{round(minutes / 1440)}-day limit"


def resets_when(moment):
    """'Resets in 2 hr 40 min' when that is soon, the day and hour when it is not."""
    left = moment - time.time()
    if left <= 0:
        return "Resets now"
    if left < 24 * 3600:
        hours, minutes = int(left // 3600), int(left % 3600 // 60)
        return "Resets in " + (f"{hours} hr {minutes} min" if hours else f"{minutes} min")
    return "Resets " + time.strftime("%a %H:%M", time.localtime(moment))


def linked(text, link=None):
    """Pango markup for a title that leads to its page when it has one."""
    text = GLib.markup_escape_text(text, -1)
    return f'<a href="{GLib.markup_escape_text(link, -1)}">{text}</a>' if link else text


def details_markup(details):
    """What a suggestion is about, as markup: an entry that ends in the address of its page
    (an application, a project) gets its first line as the link instead, and any other
    address in the text can be clicked."""
    blocks = []
    for block in details.split("\n\n"):
        lines = block.split("\n")
        if len(lines) > 1 and re.fullmatch(r"https?://\S+", lines[-1].strip()):
            name, _, rest = lines[0].partition("  ")  # the name, then what is said of it on the same line
            head = f"<b>{linked(name, lines[-1].strip())}</b>" + (f"  {GLib.markup_escape_text(rest, -1)}" if rest else "")
            blocks.append("\n".join([head] + [GLib.markup_escape_text(line, -1) for line in lines[1:-1]]))
        else:
            escaped = GLib.markup_escape_text(block, -1)
            blocks.append(re.sub(r"https?://[^\s<>\"]+[^\s<>\".,;:!?)]", lambda m: f'<a href="{m.group(0)}">{m.group(0)}</a>', escaped))
    return "\n\n".join(blocks)


def note_request(sandbox, text):
    """Say which request a conversation is working on, for the journal the tools keep of what
    they change (mentor_journal.py, which reads it by the name of the sandbox)."""
    text = " ".join(text.split())
    try:
        os.makedirs(REQUESTS, exist_ok=True)
        with open(os.path.join(REQUESTS, re.sub(r"[^A-Za-z0-9._-]", "_", sandbox) + ".txt"), "w", encoding="utf-8") as f:
            f.write(text if len(text) <= 400 else text[:399] + "\u2026")
    except OSError:
        pass
    if mentor_security:
        mentor_security.new_request(sandbox)  # what was read for the last request no longer counts


def note_reading(sandbox, name, arguments):
    """An engine used a tool of its own (a web search, a page, a file): if that brought in text
    from outside, the Mentor tools warn the user before the next thing done as root. The Mentor
    tools note their own reading themselves."""
    if mentor_security and not str(name).startswith(TOOL_PREFIX):
        try:
            mentor_security.saw(sandbox, name, arguments)
        except Exception:
            pass


def agy_folder(sandbox, instructions):
    """The folder the Antigravity CLI is run in for one conversation: what it is told (AGENTS.md)
    and the Mentor tools, working in that conversation's sandbox (.agents/mcp_config.json)."""
    folder = os.path.join(AGY_FOLDERS, sandbox)
    try:
        os.makedirs(os.path.join(folder, ".agents"), exist_ok=True)
        # Mentor's instruction files, where its own file viewer may open them: it opens nothing
        # outside the folder, and what it is told names them under /etc/mentor.
        docs = os.path.join(folder, "mentor-docs")
        os.makedirs(docs, exist_ok=True)
        for name in os.listdir("/etc/mentor"):
            if name.endswith(".md"):
                shutil.copyfile(os.path.join("/etc/mentor", name), os.path.join(docs, name))
        with open(os.path.join(folder, "AGENTS.md"), "w") as f:
            f.write(instructions)
        with open(os.path.join(folder, ".agents", "mcp_config.json"), "w") as f:
            json.dump({"mcpServers": {"mentor": {"command": MCP_SERVER, "env": {"MENTOR_SANDBOX": sandbox}}}}, f)
    except OSError:
        pass
    return folder


def agy_attach(folder, path):
    """Put an attached file into the Antigravity CLI's folder, as attached/NAME: a second name
    for the same file where that can be had, a copy otherwise. Returns its place there, or
    None for what is not a file, or is too large to copy."""
    if not os.path.isfile(path):
        return None
    place = os.path.join(folder, "attached")
    name, number = os.path.basename(path), 1
    try:
        os.makedirs(place, exist_ok=True)
        inside = os.path.join(place, name)
        while os.path.lexists(inside):
            if os.path.samefile(inside, path):
                return inside
            number += 1
            stem, extension = os.path.splitext(name)
            inside = os.path.join(place, f"{stem}-{number}{extension}")
        try:
            os.link(path, inside)
        except OSError:  # another file system, or a file that is not the user's
            if os.path.getsize(path) > 256 << 20:
                return None
            shutil.copyfile(path, inside)
        return inside
    except OSError:
        return None


def agy_keyring():
    """Take away the Antigravity CLI's note that the keyring could not be had. It writes one
    when the keyring is slow to answer (right after a login, say) and then keeps away from the
    keyring, and so from the account's sign-in, for an hour: the user looks signed out."""
    try:
        os.remove(AGY_KEYRING_NOTE)
    except OSError:
        pass


def agy_allow():
    """Have the Antigravity CLI's settings let the Mentor tools through without asking."""
    agy_keyring()
    try:
        with open(AGY_SETTINGS) as f:
            settings = json.load(f)
    except (OSError, ValueError):
        settings = {}
    try:
        allowed = settings.setdefault("permissions", {}).setdefault("allow", [])
        if AGY_ALLOWED in allowed:
            return
        allowed.append(AGY_ALLOWED)
        os.makedirs(os.path.dirname(AGY_SETTINGS), exist_ok=True)
        with open(AGY_SETTINGS + ".new", "w") as f:
            json.dump(settings, f, indent=2)
        os.replace(AGY_SETTINGS + ".new", AGY_SETTINGS)
    except (OSError, AttributeError, TypeError):
        pass


def load_settings():
    try:
        with open(SETTINGS_PATH) as f:
            settings = json.load(f)
        return settings if isinstance(settings, dict) else {}
    except (OSError, ValueError):
        return {}


def save_settings(settings):
    os.makedirs(os.path.dirname(SETTINGS_PATH), exist_ok=True)
    with open(SETTINGS_PATH, "w") as f:
        json.dump(settings, f)


def key_path(provider, model=None):
    """A provider's key for all its models, or the one kept for a single model."""
    return os.path.join(KEYS_DIR, provider if model is None else
                        f"{provider}--{re.sub(r'[^A-Za-z0-9._-]', '_', model)}")


def read_key(provider, model=None):
    """The key to use for a model: its own if it has one, otherwise the provider's."""
    for path in ([key_path(provider, model)] if model else []) + [key_path(provider)]:
        try:
            with open(path) as f:
                if key := f.read().strip():
                    return key
        except OSError:
            pass
    return ""


def write_key(provider, key, model=None, keep_others=False):
    os.makedirs(KEYS_DIR, mode=0o700, exist_ok=True)
    with open(os.open(key_path(provider, model), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        f.write(key.strip())
    if model is None and not keep_others:  # one key for all: none of them keeps a different one
        for name in os.listdir(KEYS_DIR):
            if name.startswith(provider + "--"):
                os.remove(os.path.join(KEYS_DIR, name))


def describe_tool(name, arguments):
    name = name.removeprefix(TOOL_PREFIX)
    values = []
    for value in (arguments or {}).values():
        values.append(" ".join(map(str, value)) if isinstance(value, list) else str(value))
    detail = "  ".join(values)
    return name, detail if len(detail) <= 90 else detail[:89] + "\u2026"


# The user's words of being pleased with what was done (English and Greek): the moment to offer a recipe.
PLEASED = re.compile(r"(?i)\b(it\s+works?|works?\s+(now|great|fine|perfect)|worked|perfect|great|awesome|excellent|"
                     r"thanks?|thank\s+you|nice|good\s+job|that'?s\s+it|fixed|done|exactly)\b|"
                     r"\u03b4\u03bf\u03c5\u03bb\u03b5\u03cd|\u03c4\u03ad\u03bb\u03b5\u03b9|\u03b5\u03c5\u03c7\u03b1\u03c1\u03b9\u03c3\u03c4|"
                     r"\u03bc\u03c0\u03c1\u03ac\u03b2\u03bf|\u03c9\u03c1\u03b1\u03af\u03b1|\u03ad\u03b3\u03b9\u03bd\u03b5")

# What the agent is told with a question asked over a program (Alt+Space).
ASKED_OVER = ("\n\n(Asked with the text box over the program I am using. The attached picture, if there is one, is "
              "my screen as I see it now: look at it first. Answer in a few short sentences; it is shown in a small "
              "bubble over my program.)")


class Conversation(Gtk.Box):
    """One tab: a conversation with the agent, with its own history and its own running turn."""

    def __init__(self, window, first_run=False):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.window = window
        self.first_run = first_run
        self.sessions = {}  # what each kind of engine calls this conversation, to go on with it
        self.engine = None  # the kind of engine the running turn uses
        self.process = None
        self.spinner = None
        self.busy = False
        self.tool_icons = {}   # tool_use id -> the icon of its row
        self.stray_output = []  # non-JSON lines from the CLI, shown if it never reports a result
        self.got_result = False
        self.subject = None  # what the next message is about: (label, description for the agent)
        self.attachments = []  # paths of the files that go with the next message
        self.quote = None  # words of the agent's that the next message is about
        self.workspace = window.workspace  # the workspace this conversation is the desktop of
        self.last_said = ""  # the agent's latest words, for the notification when it finishes unseen
        self.quick = False  # this turn was asked with the text box over a program: its answer is shown there too
        self.positive = False  # the user's last words were of being pleased: "it works", "thanks"
        self.offered_after = ""  # the time of the last offer to write something down (journal time format)
        self.turn_start = 0.0
        self.turn_stamp = ""
        self.rating_asked = set()  # checksums of the recipes that have had their "did it work?" card here
        self.share_offered = set()  # recipes that have had their "share it?" card
        self.history = []  # what is shown, in a form that can be saved and shown again
        self.tool_items = {}  # tool_use id -> its item in the history
        # Trial changes made here stay apart from those of the other tabs.
        self.sandbox = "tab-" + uuid.uuid4().hex[:8]

        self.messages = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                                margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        self.column = Adw.Clamp(maximum_size=720, child=self.messages)
        self.scroller = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER,
                                           child=self.column)
        # Down the left side, a tick for each thing asked: where one is in the conversation,
        # what was asked there and when, and the way back to it.
        self.ticks = []  # (the tick, its popover, the message it leads to)
        self.timeline = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.timeline_scroller = Gtk.ScrolledWindow(
            child=self.timeline, halign=Gtk.Align.START, valign=Gtk.Align.CENTER, margin_start=12,
            hscrollbar_policy=Gtk.PolicyType.NEVER, vscrollbar_policy=Gtk.PolicyType.EXTERNAL,
            propagate_natural_height=True, propagate_natural_width=True, max_content_height=420,
            visible=False)
        self.scroller.get_vadjustment().connect("value-changed", lambda *_: self.mark_tick())
        self.current_tick = None  # the tick of the message the view is at
        wave = Gtk.EventControllerMotion()
        wave.connect("motion", lambda _c, _x, y: self.swell(y))
        wave.connect("leave", lambda *_: self.swell(None))
        self.timeline.add_controller(wave)

        self.entry = Gtk.Entry(hexpand=True, placeholder_text="Ask Mentor to do something\u2026")
        self.entry.add_css_class("ask")
        self.entry.connect("activate", lambda *_: self.send(self.entry.get_text()))
        self.action = Gtk.Button(valign=Gtk.Align.CENTER)
        self.action.add_css_class("circular")
        self.action.connect("clicked", self.on_action)
        attach = Gtk.Button(icon_name="mail-attachment-symbolic", tooltip_text="Attach files or pictures",
                            valign=Gtk.Align.CENTER)
        attach.add_css_class("osd")
        attach.add_css_class("circular")
        attach.connect("clicked", self.on_attach_clicked)
        self.model = Gtk.MenuButton(label=window.shown_name(window.model_index), menu_model=window.model_menu,
                                    direction=Gtk.ArrowType.UP)
        self.model.add_css_class("model")
        self.model.set_valign(Gtk.Align.CENTER)
        self.usage_box = None  # at the top of the model's menu: the model chosen and its limits (the window fills it)
        self.trouble = None  # what the Codex or the Antigravity CLI last complained of
        self.pending = ""  # what the Antigravity CLI has said so far of a text it sends in pieces
        bar =Gtk.Box(spacing=8, margin_bottom=28)
        bar.append(attach)
        bar.append(self.entry)
        bar.append(self.model)
        bar.append(self.action)

        # Files for the next message, one removable chip each.
        self.attachment_bar = Adw.WrapBox(child_spacing=6, line_spacing=6, visible=False)
        drop = Gtk.DropTarget.new(Gdk.FileList, Gdk.DragAction.COPY)
        drop.connect("drop", lambda _target, files, _x, _y: self.attach_files(files.get_files()) or True)
        self.add_controller(drop)
        paste = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        paste.connect("key-pressed", self.on_entry_key)
        self.entry.add_controller(paste)

        # Shown while the next message is about one application.
        self.subject_icon = Gtk.Image(pixel_size=20)
        self.subject_label = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
        forget = Gtk.Button(icon_name="window-close-symbolic", tooltip_text="Not about this")
        forget.add_css_class("flat")
        forget.connect("clicked", lambda *_: self.set_subject())
        self.subject_bar = Gtk.Box(spacing=8, visible=False)
        self.subject_bar.add_css_class("subject")
        for widget in (self.subject_icon, self.subject_label, forget):
            self.subject_bar.append(widget)

        # Shown while the next message is about something the agent said (right-click, Quote).
        self.quote_label = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
        unquote = Gtk.Button(icon_name="window-close-symbolic", tooltip_text="Not about this")
        unquote.add_css_class("flat")
        unquote.connect("clicked", lambda *_: self.set_quote())
        self.quote_bar = Gtk.Box(spacing=8, visible=False)
        self.quote_bar.add_css_class("subject")
        for widget in (Gtk.Image(icon_name="mail-reply-sender-symbolic", pixel_size=16), self.quote_label, unquote):
            self.quote_bar.append(widget)

        # The text box and what belongs to it. It can be lifted out and shown over the
        # windows (DesktopWindow.toggle_ask), which is why it is kept by name.
        bottom = self.bottom = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                                       margin_top=6, margin_start=12, margin_end=12)
        bottom.append(self.subject_bar)
        bottom.append(self.quote_bar)
        bottom.append(self.attachment_bar)
        bottom.append(bar)
        body = Gtk.Overlay(child=self.scroller, vexpand=True)
        body.add_overlay(self.timeline_scroller)
        self.append(body)
        self.bottom_home = Adw.Clamp(maximum_size=680, child=bottom)
        self.append(self.bottom_home)

        # Until something is asked the wallpaper stays bare, except on the very first start.
        self.welcome = Gtk.Box(vexpand=True)
        if first_run:
            title = Gtk.Label(label="Welcome to Mentor")
            title.add_css_class("title-2")
            text = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=44, label=(
                "The assistant that runs this system lives here, on your desktop. Click anywhere and "
                "type what you want. Super+A brings you back to it from any app."))
            setup = Gtk.Button(label="Set up my system", halign=Gtk.Align.CENTER)
            setup.add_css_class("pill")
            setup.add_css_class("suggested-action")
            setup.connect("clicked", lambda *_: self.send(WELCOME_PROMPT, shown="Set up my system"))
            self.welcome = card(Gtk.Image(icon_name=APP_ID, pixel_size=72), title, text, setup,
                                halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, vexpand=True)
        self.messages.append(self.welcome)
        self.set_busy(False)

    @property
    def untouched(self):
        """True while nothing has been asked here yet."""
        return self.welcome is not None and not self.busy

    def set_quote(self, text=None):
        """Make the next message be about these words of the agent's, or about none."""
        self.quote = text
        self.quote_bar.set_visible(bool(text))
        if text:
            self.quote_label.set_text("\u201c" + " ".join(text.split()) + "\u201d")
            self.entry.grab_focus()

    def quote_from(self, label):
        """Quote what is selected in one of the agent's messages, or all of it."""
        text = label.get_text()
        bounds = label.get_selection_bounds()
        if len(bounds) == 3 and bounds[0] and bounds[1] != bounds[2]:
            text = text[min(bounds[1:]):max(bounds[1:])]
        if text.strip():
            self.set_quote(text.strip())

    def set_subject(self, app_id=None):
        """Make the next message be about an application, or about nothing in particular."""
        self.subject = None
        self.subject_bar.set_visible(False)
        self.entry.set_placeholder_text("Ask Mentor to do something…")
        icon = None
        if app_id:
            try:
                info = Gio.DesktopAppInfo.new(app_id)
            except TypeError:
                return
            name, icon = info.get_display_name(), info.get_icon()
            self.subject = (name, f'the application "{name}" (desktop file {info.get_filename()}, '
                                  f'command: {info.get_commandline()})')
            self.entry.set_placeholder_text("Update it, remove it, change a setting, open it and…")
        else:
            return
        self.subject_icon.set_from_gicon(icon or Gio.ThemedIcon.new("application-x-executable"))
        self.subject_label.set_markup(f"About <b>{GLib.markup_escape_text(name, -1)}</b>")
        self.subject_bar.set_visible(True)
        self.entry.grab_focus()

    # --- attachments ------------------------------------------------------------

    def attach(self, path):
        path = os.path.abspath(path)
        if path in self.attachments:
            return
        self.attachments.append(path)
        chip = Gtk.Box(spacing=2)
        chip.add_css_class("attachment")
        chip.append(Gtk.Label(label=os.path.basename(path) or path, max_width_chars=28,
                              ellipsize=Pango.EllipsizeMode.MIDDLE, tooltip_text=path))
        remove = Gtk.Button(icon_name="window-close-symbolic", tooltip_text="Remove")
        remove.add_css_class("flat")
        remove.add_css_class("circular")
        remove.connect("clicked", lambda *_: self.detach(path, chip))
        chip.append(remove)
        self.attachment_bar.append(chip)
        self.attachment_bar.set_visible(True)
        self.entry.set_placeholder_text("Explain it, convert it, rename, fix what it shows\u2026")
        self.entry.grab_focus()

    def attach_files(self, files):
        for file in files:
            if file.get_path():
                self.attach(file.get_path())

    def detach(self, path, chip):
        self.attachments.remove(path)
        self.attachment_bar.remove(chip)
        self.attachment_bar.set_visible(bool(self.attachments))

    def on_attach_clicked(self, _button):
        dialog = Gtk.FileDialog(title="Attach files or pictures")

        def chosen(_dialog, result):
            try:
                self.attach_files(dialog.open_multiple_finish(result))
            except GLib.Error:
                pass  # cancelled
        dialog.open_multiple(self.window, None, chosen)

    def on_entry_key(self, _controller, keyval, _keycode, state):
        """Ctrl+V with a picture or copied files in the clipboard attaches them; text pastes as usual."""
        if keyval not in (Gdk.KEY_v, Gdk.KEY_V) or not state & Gdk.ModifierType.CONTROL_MASK:
            return False
        clipboard = self.entry.get_clipboard()
        formats = clipboard.get_formats()
        if formats.contain_gtype(Gdk.FileList):
            clipboard.read_value_async(Gdk.FileList, GLib.PRIORITY_DEFAULT, None, self.on_files_pasted)
        elif formats.contain_gtype(Gdk.Texture):
            clipboard.read_texture_async(None, self.on_picture_pasted)
        else:
            return False
        return True

    def on_files_pasted(self, clipboard, result):
        try:
            self.attach_files(clipboard.read_value_finish(result).get_files())
        except GLib.Error:
            pass

    def on_picture_pasted(self, clipboard, result):
        try:
            texture = clipboard.read_texture_finish(result)
        except GLib.Error:
            return
        os.makedirs(PASTED_DIR, exist_ok=True)
        path = os.path.join(PASTED_DIR, time.strftime("pasted-%Y%m%d-%H%M%S.png"))
        if texture and texture.save_to_png(path):
            self.attach(path)

    def clear(self):
        """Forget the conversation: the tab starts again as if nothing had been asked in it."""
        self.stop()
        if self.busy:  # the CLI's exit is no longer waited for
            self.process = None
            self.set_busy(False)
        while child := self.messages.get_first_child():
            self.messages.remove(child)
        for tick, popover, _ in self.ticks:
            popover.unparent()
            self.timeline.remove(tick)
        self.ticks = []
        self.current_tick = None
        self.timeline_scroller.set_visible(False)
        self.welcome = Gtk.Box(vexpand=True)
        self.messages.append(self.welcome)
        self.spinner = None
        self.sessions = {}
        self.tool_icons.clear()
        self.tool_items.clear()
        self.history = []
        self.stray_output = []
        self.got_result = False
        self.last_said = ""
        self.attachments = []
        while chip := self.attachment_bar.get_first_child():
            self.attachment_bar.remove(chip)
        self.attachment_bar.set_visible(False)
        self.set_subject()
        self.set_quote()
        self.entry.set_text("")
        self.window.tabs.get_page(self).set_title("New conversation")
        self.window.save_conversations()
        self.entry.grab_focus()

    def saved(self, title):
        return {"title": title, "sessions": self.sessions, "sandbox": self.sandbox,
                "workspace": self.workspace, "history": self.history[-MAX_SAVED_ITEMS:]}

    def restore(self, saved):
        """Show a conversation from before the assistant was last started, ready to go on."""
        self.sessions = dict(saved.get("sessions") or {})
        if saved.get("session_id"):  # saved before there was more than one engine
            self.sessions.setdefault("claude", saved["session_id"])
        self.sandbox = saved.get("sandbox") or self.sandbox
        self.workspace = saved.get("workspace") or 0
        for item in saved.get("history", []):
            if "tool" in item:
                self.add_tool(None, item["tool"], item.get("detail", ""), described=True, failed=item.get("failed"))
            elif "note" in item:
                self.add_note(item["note"])
            else:
                self.add_text(item.get("text", ""), user=item.get("user", False), error=item.get("error", False),
                              when=item.get("time") or 0)

    def stop(self):
        """Stop the engine at work, with whatever it started: Codex and Claude Code are
        launchers that run the real program as a child, which would otherwise go on."""
        if self.process:
            try:
                os.killpg(int(self.process.get_identifier()), signal.SIGKILL)  # its own group: see spawn
            except (OSError, TypeError, ValueError):
                pass
            self.process.force_exit()

    def set_busy(self, busy):
        self.busy = busy
        self.entry.set_sensitive(not busy)
        self.action.set_icon_name("media-playback-stop-symbolic" if busy else "go-up-symbolic")
        self.action.set_tooltip_text("Stop" if busy else "Send")
        for css_class, on in (("destructive-action", busy), ("suggested-action", not busy)):
            (self.action.add_css_class if on else self.action.remove_css_class)(css_class)
        self.window.on_busy_changed(self)
        if not busy:
            self.entry.grab_focus()

    def add(self, widget):
        if self.welcome:
            self.messages.remove(self.welcome)
            self.welcome = None
        self.messages.append(widget)
        GLib.idle_add(self.scroll_to_end)
        return widget

    def scroll_to_end(self):
        adjustment = self.scroller.get_vadjustment()
        adjustment.set_value(adjustment.get_upper())
        return GLib.SOURCE_REMOVE

    def add_tick(self, message, item):
        """The mark on the timeline for something the user asked."""
        mark = Gtk.Box()
        mark.add_css_class("tick")
        tick = Gtk.Button(child=mark, halign=Gtk.Align.START)
        tick.add_css_class("tick-button")
        title = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=40)
        title.add_css_class("heading")
        answer = Gtk.Label(xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR, lines=3,
                           ellipsize=Pango.EllipsizeMode.END, width_chars=40, max_width_chars=40)
        answer.add_css_class("dim-label")
        when = Gtk.Label(xalign=0)
        when.add_css_class("caption")
        when.add_css_class("dim-label")
        about = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        for label in (title, answer, when):
            about.append(label)
        popover = Gtk.Popover(child=about, position=Gtk.PositionType.RIGHT, autohide=False, can_target=False)
        popover.set_parent(tick)

        def show(*_):  # filled in when looked at: the answer may not have been there before
            title.set_text(" ".join(item["text"].split()))
            said = self.answer_to(item)
            answer.set_text(said)
            answer.set_visible(bool(said))
            when.set_text(told_when(item["time"]) if item.get("time") else "")
            when.set_visible(bool(item.get("time")))
            popover.popup()

        hover = Gtk.EventControllerMotion()
        hover.connect("enter", show)
        hover.connect("leave", lambda *_: popover.popdown())
        tick.add_controller(hover)
        tick.connect("clicked", lambda *_: self.scroll_to(message))
        self.timeline.append(tick)
        self.ticks.append((tick, popover, message))
        self.timeline_scroller.set_visible(len(self.ticks) > 1)
        self.swell(None)

    def swell(self, pointer):
        """Draw the ticks: a wave of longer, brighter ones around the pointer (its height on
        the timeline, None when it is elsewhere), and the one of the message in view marked."""
        for tick, _, _ in self.ticks:
            near = 0.0
            found, bounds = tick.compute_bounds(self.timeline)
            if pointer is not None and found:
                away = (bounds.get_y() + bounds.get_height() / 2 - pointer) / 15
                near = math.exp(-away * away)
            rest = 16 if tick is self.current_tick else 12
            mark = tick.get_child()
            mark.set_size_request(round(rest + (32 - rest) * near), 2)
            mark.set_opacity(1 if tick is self.current_tick else 0.4 + 0.6 * near)

    def answer_to(self, item):
        """The start of what the agent said to one of the user's messages."""
        mine = False
        for other in self.history:
            if other is item:
                mine = True
            elif mine and other.get("user"):
                break
            elif mine and other.get("text") and not other.get("error"):
                said = " ".join(re.sub(r"[*`#]", "", other["text"]).split())
                return said if len(said) <= 220 else said[:219] + "\u2026"
        return ""

    def place_of(self, message):
        """How far down the conversation a message is, or None before it has been laid out."""
        found, bounds = message.compute_bounds(self.column)
        return bounds.get_y() if found else None

    def scroll_to(self, message):
        place = self.place_of(message)
        if place is not None:
            self.scroller.get_vadjustment().set_value(max(0, place - 12))

    def mark_tick(self):
        """Show on the timeline which of the user's messages the view is at."""
        adjustment = self.scroller.get_vadjustment()
        line = adjustment.get_value() + adjustment.get_page_size() / 3
        at = None
        for tick, _, message in self.ticks:
            place = self.place_of(message)
            if place is not None and (at is None or place <= line):
                at = tick
        if at is not self.current_tick:
            self.current_tick = at
            self.swell(None)

    def add_text(self, text, user=False, error=False, when=None):
        """`when` is for a message shown again from the history: the time it was sent, 0 if unknown."""
        label = Gtk.Label(wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR, xalign=0, selectable=True,
                          halign=Gtk.Align.END if user else Gtk.Align.START)
        if user:
            label.set_text(text)
            label.add_css_class("bubble")
            label.add_css_class("user")
        else:
            label.set_markup(to_markup(text))
            label.add_css_class("agent-card")
            label.add_css_class("said")
            if not error:  # in its right-click menu, under Copy
                menu = Gio.Menu()
                menu.append("Quote", "message.quote")
                label.set_extra_menu(menu)
                quote = Gio.SimpleAction.new("quote", None)
                quote.connect("activate", lambda *_: self.quote_from(label))
                actions = Gio.SimpleActionGroup()
                actions.add_action(quote)
                label.insert_action_group("message", actions)
        if error:
            label.add_css_class("chat-error")
        item = {"text": text, "user": user, "error": error}
        if when is None and not error:
            self.window.note(self, text, user)
        if user:
            if moment := time.time() if when is None else when:
                item["time"] = moment
            self.add_tick(label, item)
        self.history.append(item)
        return self.add(label)

    def add_notice(self, level, title, text, prompt=None, auto=False, action="Let Mentor look", silence=None):
        """Something the system tells of by itself: a card, yellow for a warning, red for a
        problem, green for an idea (something it suggests, such as writing down what was just
        built), with a way to hand it to the agent. Not part of what was said to the agent.
        `silence` is a function: the user does not want ideas of this kind (a button for it)."""
        heading = Gtk.Label(label=title, xalign=0, wrap=True, max_width_chars=64)
        heading.add_css_class("heading")
        body = Gtk.Label(label=text, xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR, max_width_chars=64,
                         selectable=True, visible=bool(text))
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, halign=Gtk.Align.START)
        card.add_css_class("notice")
        card.add_css_class(level if level in ("problem", "idea") else "warning")
        card.append(heading)
        card.append(body)
        buttons = Gtk.Box(spacing=6, halign=Gtk.Align.END, margin_top=2)
        dismiss = Gtk.Button(label="Dismiss")
        dismiss.add_css_class("flat")
        dismiss.connect("clicked", lambda *_: self.messages.remove(card))
        buttons.append(dismiss)
        if silence:
            quiet = Gtk.Button(label="Don't suggest this")
            quiet.add_css_class("flat")
            quiet.connect("clicked", lambda *_: (silence(), self.messages.remove(card)))
            buttons.append(quiet)
        if prompt:
            look = Gtk.Button(label=action)
            look.add_css_class("pill")
            look.add_css_class("look")

            def hand_over(*_):
                look.set_sensitive(False)
                self.window.for_request().send(prompt, shown=title)
            look.connect("clicked", hand_over)
            buttons.append(look)
            # One the system wants looked at now (the firewall turned somebody away): sent on
            # without waiting, when an engine is chosen. The card stays, to say what it was.
            if auto and not self.window.unchosen:
                GLib.timeout_add(800, lambda: hand_over() and False)
        card.append(buttons)
        self.window.note(self, f"{title}. {text}".strip(), False)
        if self.first_run and self.welcome:  # the card of a first start stays where it is
            self.messages.append(card)
            return card
        return self.add(card)

    def offer_recipe(self):
        """After a turn that went well: when something was built here that took some doing, say
        so with a green card and offer to write it down as a recipe (RECIPES.md). Never twice
        for the same work, and never for a recipe that was only followed."""
        if not (mentor_journal and mentor_recipes and mentor_settings) or not self.got_result or self.trouble:
            return
        try:
            if not mentor_settings.get("offer_recipes"):
                return
            if any(not v.get("own") for v in mentor_recipes._load(self.sandbox).values()):
                return  # a recipe of someone else's was followed here: it is theirs, not ours to hand on
            entries, _left_out = mentor_journal.entries("", 0, True)
        except Exception:
            return
        mine = [e for e in entries if e.get("conversation") == self.sandbox and str(e.get("time", "")) > self.offered_after]
        done = [e for e in mine if e.get("kind") == "change" and e.get("ok", True)
                and not str(e.get("tool", "")).startswith("recipe_")
                and e.get("tool") not in ("change_undo", "file_restore", "suggestions_restore")]
        # Anything that was changed and worked is worth a recipe: one flag in one file is the
        # most reusable kind. Never twice for the same work (offered_after); "Don't suggest this" ends it.
        if not done:
            return
        self.offered_after = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        self.add_notice(
            "idea", "That worked. Want to keep how it was done?",
            "I can write down how this was built, step by step, so you can use it again or give it to other "
            "Mentor users. It takes a minute, and I show you what it says before anything is kept.",
            "Write a recipe of what we just built in this conversation. Follow /etc/mentor/RECIPES.md: get the "
            "material with recipe_material, keep only what ended up working, show me in a few plain sentences what "
            "it says, and save it with recipe_save.",
            action="Write it down",
            silence=lambda: mentor_settings.put("offer_recipes", False))

    def offer_share(self):
        """A recipe of the user's own was written down in this turn: a green card with what it
        does in one line (written by the agent, the user can change it), everything that would
        be shared, and a Share button. The button is the user's yes to exactly this text; the
        agent then finds the category and posts (recipe_share accepts the card's yes, see
        RECIPES.md, "Sharing one")."""
        if not (mentor_recipes and mentor_settings) or self.trouble or not self.got_result:
            return
        try:
            if not mentor_settings.get("offer_recipes"):
                return
            state = mentor_recipes._load(self.sandbox)
            for name, title, _when in mentor_recipes.listing():
                path = os.path.join(mentor_recipes.FOLDER, name)
                if path in self.share_offered or os.path.getmtime(path) < self.turn_start - 2:
                    continue
                if not state.get(os.path.realpath(path), {}).get("own"):
                    continue
                with open(path, encoding="utf-8") as f:
                    text = f.read()
                self.share_offered.add(path)
                self.share_card(path, title, text)
                return
        except Exception:
            return

    def share_card(self, path, title, text):
        summary = next((l.lstrip("> ").strip() for l in text.splitlines() if l.startswith(">")), "")
        heading = Gtk.Label(label=f"Share \u201c{title}\u201d with other Mentor users?", xalign=0, wrap=True, max_width_chars=64)
        heading.add_css_class("heading")
        body = Gtk.Label(
            label="It is saved on your computer. If you share it, it goes on the public recipes site and cannot be taken "
                  "back. It names no one. The site checks it by itself before showing it. This is what it does:",
            xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR, max_width_chars=64)
        said = Gtk.Entry(text=summary, hexpand=True, max_length=200)
        everything = Gtk.Label(label=text, xalign=0, wrap=True, selectable=True, wrap_mode=Pango.WrapMode.WORD_CHAR)
        scroll = Gtk.ScrolledWindow(max_content_height=260, propagate_natural_height=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.set_child(everything)
        expander = Gtk.Expander(label="See everything that would be shared")
        expander.set_child(scroll)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, halign=Gtk.Align.START)
        card.add_css_class("notice")
        card.add_css_class("idea")
        for part in (heading, body, said, expander):
            card.append(part)
        buttons = Gtk.Box(spacing=6, halign=Gtk.Align.END, margin_top=2)
        dismiss = Gtk.Button(label="Not now")
        dismiss.add_css_class("flat")
        dismiss.connect("clicked", lambda *_: self.messages.remove(card))
        share = Gtk.Button(label="Share it")
        share.add_css_class("pill")
        share.add_css_class("look")

        def go(*_):
            if self.busy:  # the request could not be handed over now: the card stays for later
                return
            share.set_sensitive(False)
            said.set_sensitive(False)
            try:
                line = " ".join(said.get_text().split())
                if line and line != summary:
                    lines = text.split("\n")
                    for i, l in enumerate(lines):
                        if l.startswith(">"):
                            lines[i] = "> " + line
                            break
                    with open(path, "w", encoding="utf-8", newline="\n") as f:
                        f.write("\n".join(lines))
                sha = mentor_recipes.sha_of(path)
                mentor_recipes.mark_checked(self.sandbox, path, sha, {}, own=True)
                share_path = os.path.join(REQUESTS, re.sub(r"[^A-Za-z0-9._-]", "_", self.sandbox) + ".share")
                try:
                    with open(share_path, encoding="utf-8") as f:
                        approved = json.load(f)
                except (OSError, ValueError):
                    approved = {}
                approved["card:" + sha] = time.time() - 1  # what the card showed, said yes to
                os.makedirs(REQUESTS, exist_ok=True)
                with open(share_path, "w", encoding="utf-8") as f:
                    json.dump(approved, f)
            except OSError:
                share.set_sensitive(True)
                return
            self.send(
                f"The user pressed Share on the card for the recipe {path}. They saw the exact text and said yes on the "
                "card, so do not ask them again. Do this: recipe_hub_look with that path, to see if the same recipe is "
                "already on the site (if it is, say so in one sentence and do not post); choose the category (a new "
                "sub-category only when none fits); then recipe_share with confirmed true straight away. Finish with one "
                "short, plain sentence about what happens next. RECIPES.md, \"Sharing one\".",
                shown=f"Share the recipe \u201c{title}\u201d")
            self.messages.remove(card)
        share.connect("clicked", go)
        buttons.append(dismiss)
        buttons.append(share)
        card.append(buttons)
        self.window.note(self, f"Share the recipe {title}?", False)
        self.add(card)

    def note_used(self):
        """A recipe from the site was followed in this turn and something was changed: remember it
        as used here (the Recipes app lists those) and ask how it went, with a card. Wherever the
        file is (the agent fetched it, or the user downloaded it with the browser): which recipe
        of the site it is, is told by its checksum, not by its name or its folder."""
        if not (mentor_journal and mentor_recipes) or not self.got_result or self.trouble:
            return
        try:
            state = mentor_recipes._load(self.sandbox)
            entries, _left_out = mentor_journal.entries("", 0, True)
        except Exception:
            return
        changed = [e for e in entries if e.get("conversation") == self.sandbox and str(e.get("time", "")) >= self.turn_stamp  # the same second counts: times are whole seconds
                   and e.get("kind") == "change" and e.get("ok", True)
                   and not str(e.get("tool", "")).startswith("recipe_") and e.get("tool") not in ("change_undo", "file_restore")]
        if not changed:
            return
        # The recipe of someone else's that was inspected most recently in this conversation.
        mine = [(float(v.get("when", 0)), path, v) for path, v in state.items()
                if isinstance(v, dict) and not v.get("own") and v.get("checked")]
        if not mine:
            return
        _when, path, v = max(mine)
        sha = v.get("checked")
        if sha in self.rating_asked:
            return
        self.rating_asked.add(sha)

        def work():
            try:
                import mentor_hub
                listed = mentor_hub.on_hub(sha)
                if not listed:
                    try:  # published a moment ago: the list kept here may be older than it
                        listed = next((r for r in mentor_hub.get_index(True)["recipes"] if str(r.get("sha256", "")).lower() == sha), None)
                    except Exception:
                        listed = None
                if not listed:
                    return  # not a recipe of the site (a file from somewhere else): nothing to rate
                rid, title, kept = str(listed["id"]), str(listed.get("title") or listed["id"]), path
                try:  # a copy in Mentor's own folder, so that taking it away still works when the download is gone
                    folder = os.path.join(mentor_recipes.FOLDER, "from the site")
                    os.makedirs(folder, exist_ok=True)
                    kept = os.path.join(folder, rid + ".md")
                    if os.path.realpath(kept) != os.path.realpath(path):
                        shutil.copyfile(path, kept)
                except OSError:
                    kept = path
                mentor_recipes.used_note(rid, title, sha, kept)
                GLib.idle_add(lambda: self.rating_card(rid, title, again=False) and False)
            except Exception:
                pass
        import threading
        threading.Thread(target=work, daemon=True).start()

    def rating_card(self, rid, title, again=False):
        """"Did it work?" with thumbs. The answer goes to the recipes site, signed, as one vote;
        the site shows it, and Mentors give less attention to recipes that did not work."""
        heading = Gtk.Label(label=f"Did \u201c{title}\u201d work for you?", xalign=0, wrap=True, max_width_chars=64)
        heading.add_css_class("heading")
        text = ("You used this recipe a while ago and have not said how it went. " if again else "") + \
               "Your answer helps other Mentor users know which recipes to trust. It names no one."
        body = Gtk.Label(label=text, xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR, max_width_chars=64)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, halign=Gtk.Align.START)
        card.add_css_class("notice")
        card.add_css_class("idea")
        card.append(heading)
        card.append(body)
        buttons = Gtk.Box(spacing=6, halign=Gtk.Align.END, margin_top=2)
        later = Gtk.Button(label="Not sure yet")
        later.add_css_class("flat")
        no = Gtk.Button(label="\U0001F44E It did not")
        no.add_css_class("flat")
        yes = Gtk.Button(label="\U0001F44D It worked")
        yes.add_css_class("pill")
        yes.add_css_class("look")

        def done_card(said):
            body.set_text(said)
            card.remove(buttons)
            return GLib.SOURCE_REMOVE

        def vote(which):
            for b in (later, no, yes):
                b.set_sensitive(False)

            def work():
                import mentor_hub
                try:
                    entry = mentor_recipes.used_load().get(rid, {})
                    mentor_hub.rate(rid, entry.get("sha", ""), which)
                    mentor_recipes.used_vote(rid, which)
                    said = "Thank you. Your answer was sent."
                except Exception as e:
                    mentor_recipes.used_asked(rid)
                    said = "It could not be sent just now (" + str(e)[:80] + "). Mentor will ask again later."
                GLib.idle_add(done_card, said)
            import threading
            threading.Thread(target=work, daemon=True).start()

        def not_now(*_):
            mentor_recipes.used_asked(rid)
            self.messages.remove(card)
        later.connect("clicked", not_now)
        no.connect("clicked", lambda *_: vote("down"))
        yes.connect("clicked", lambda *_: vote("up"))
        for b in (later, no, yes):
            buttons.append(b)
        card.append(buttons)
        self.window.note(self, f"Did the recipe {title} work?", False)
        return self.add(card)

    def add_note(self, text):
        note = Gtk.Label(label=text, xalign=1, halign=Gtk.Align.END, wrap=True)
        note.add_css_class("attachment-note")
        self.history.append({"note": text})
        return self.add(note)

    def add_tool(self, tool_id, name, arguments, described=False, failed=None):
        """One row per tool call. `described` and `failed` are for a call shown again from the history."""
        detail = arguments
        if not described:
            name, detail = describe_tool(name, arguments)
        item = {"tool": name, "detail": detail, "failed": failed}
        self.history.append(item)
        icon = Gtk.Image(icon_name="content-loading-symbolic")
        if described:  # over long ago: done, failed, or never answered
            icon.set_from_icon_name({True: "dialog-warning-symbolic", False: "object-select-symbolic"}
                                    .get(failed, "process-stop-symbolic"))
        else:
            self.tool_items[tool_id] = item
        text = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        text.set_markup(f"<b>{GLib.markup_escape_text(name, -1)}</b>  <tt>{GLib.markup_escape_text(detail, -1)}</tt>")
        row = Gtk.Box(spacing=8, halign=Gtk.Align.START)
        row.add_css_class("tool-row")
        row.append(icon)
        row.append(text)
        if not described:
            self.tool_icons[tool_id] = icon
        self.add(row)

    def on_action(self, _button):
        if self.busy:
            self.stop()
        else:
            self.send(self.entry.get_text())

    def send(self, text, shown=None):
        """Give the agent a message. `shown` replaces it in the conversation when it is not the user's words."""
        text = text.strip()
        if self.busy or not (text or self.attachments):
            return
        text = text or "Look at this."
        self.entry.set_text("")
        prompt = text
        self.positive = bool(PLEASED.search(text)) and shown is None  # their own words, not a card's request
        self.turn_start = time.time()
        self.turn_stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        # Asked with the text box over a program (Alt+Space): the agent is told so, and the
        # answer is shown there as well.
        self.quick = self.window.asking(self)
        if self.quick:
            prompt += ASKED_OVER
            self.window.ask_say("Mentor is looking\u2026")
        if self.subject:
            name, description = self.subject
            prompt = f"This is about {description}.\n\n{text}"
            text = f"{name}: {text}"
            self.set_subject()  # the conversation remembers it from here on
        if self.welcome:
            self.window.name_tab(self, shown or text)
            if self.first_run:  # from here on this is no longer a new system
                os.makedirs(os.path.dirname(WELCOMED_PATH), exist_ok=True)
                open(WELCOMED_PATH, "w").close()
        self.add_text(shown or text, user=True)
        if self.quote:
            quoted = "\n".join("> " + line for line in self.quote.splitlines())
            prompt = f"About this, which you said earlier in this conversation:\n\n{quoted}\n\n{prompt}"
            short = " ".join(self.quote.split())
            self.add_note("\u201c" + (short if len(short) <= 90 else short[:89] + "\u2026") + "\u201d")
            self.set_quote()
        attached = list(self.attachments)
        if self.attachments:
            prompt += "\n\nAttached files:\n" + "\n".join(self.attachments)
            names = ", ".join(os.path.basename(path) or path for path in self.attachments)
            self.add_note(f"\U0001F4CE {names}")
            self.attachments = []
            while chip := self.attachment_bar.get_first_child():
                self.attachment_bar.remove(chip)
            self.attachment_bar.set_visible(False)
            self.entry.set_placeholder_text("Ask Mentor to do something\u2026")
        _, provider, model, _ = MODELS[self.window.model_index]
        effort = EFFORTS[self.window.effort_index][1]
        key = folder = None
        if provider == "claude":
            self.engine = "claude"
            argv = [CLAUDE, "-p", prompt, "--output-format", "stream-json", "--verbose",
                    "--mcp-config", MCP_CONFIG, "--strict-mcp-config",
                    "--allowedTools", ALLOWED_TOOLS, "--disallowedTools", DISALLOWED_TOOLS,
                    "--append-system-prompt", SYSTEM_PROMPT + ATTACHED["claude"]]
            if model:
                argv += ["--model", model]
        elif provider == "codex":
            self.engine = "codex"
            try:
                with open(GUIDE) as f:
                    guide = f.read()
            except OSError:
                guide = ""
            # Its own shell stays read-only, so that changes go through the Mentor tools, and it
            # never stops to ask: those tools ask the user themselves. Values are TOML, which a
            # JSON string also is.
            settings = {
                "sandbox_mode": "read-only", "approval_policy": "never",
                "mcp_servers.mentor.command": MCP_SERVER,
                "mcp_servers.mentor.default_tools_approval_mode": "approve",
                "developer_instructions": f"{guide}\n\n{SYSTEM_PROMPT}{ATTACHED['codex']}",
            }
            if effort:
                settings["model_reasoning_effort"] = effort
            options = ["--json", "--skip-git-repo-check"]
            for name, value in settings.items():
                options += ["-c", f"{name}={json.dumps(value)}"]
            options += ["-c", f"mcp_servers.mentor.env={{MENTOR_SANDBOX={json.dumps(self.sandbox)}}}"]
            if model:
                options += ["-m", model]
            argv = [CODEX, "exec", *(["resume"] if self.sessions.get("codex") else []), *options]
            if self.sessions.get("codex"):
                argv.append(self.sessions["codex"])
            argv.append(prompt)
        elif provider == "gemini":
            self.engine = "gemini"
            try:
                with open(GUIDE) as f:
                    guide = f.read()
            except OSError:
                guide = ""
            # Run like this it cannot stop to ask: what it would have asked about is refused, and
            # that ends its turn. The Mentor tools are let through; they ask the user themselves.
            folder = agy_folder(self.sandbox, f"{guide}\n\n{SYSTEM_PROMPT}{ATTACHED['gemini']}{AGY_PROMPT}")
            agy_allow()
            # Its own file tool, the one that can look at a picture, only opens what is in the
            # folder it works in: what was attached is put there, and named by its place there.
            folders = [option for path in attached if os.path.isdir(path) for option in ("--add-dir", path)]
            if attached:
                said, listed, _paths = prompt.rpartition("\n\nAttached files:\n")
                prompt = said + listed + "\n".join(agy_attach(folder, path) or path for path in attached)
            # A message that begins with a slash is still a message, not one of its commands.
            # /etc/mentor too (read only for the user): the files it is told to read are there.
            argv = [AGY, "-p", prompt, "--output-format", "stream-json", "--disable-slash-commands",
                    "--add-dir", "/etc/mentor", *folders]
            if model:
                argv += ["--model", model]
            if self.sessions.get("gemini"):
                argv += ["--conversation", self.sessions["gemini"]]
        else:
            self.engine = "agent"  # one conversation format, whichever provider answers
            key = read_key(provider, model)
            argv = [AGENT, "-p", prompt, "--provider", provider, "--model", model,
                    "--system", SYSTEM_PROMPT + ATTACHED["agent"]]
            if effort:
                argv += ["--effort", effort]
            for path in attached:
                argv += ["--file", path]
        if self.engine in ("claude", "agent") and self.sessions.get(self.engine):
            argv += ["--resume", self.sessions[self.engine]]
        self.trouble = None
        self.pending = ""
        self.stray_output = []
        self.got_result = False
        note_request(self.sandbox, shown or text)
        self.process = self.window.spawn(argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE,
                                         sandbox=self.sandbox, key=key, own_group=True, folder=folder)
        if not self.process:
            self.add_text(f"Could not start {argv[0]}.", error=True)
            return
        self.window.show_chat()
        self.window.save_conversations()
        self.set_busy(True)
        self.status = Gtk.Label(xalign=0)
        self.status.add_css_class("attachment-note")
        self.status.set_visible(False)
        waiting = Gtk.Box(spacing=8, halign=Gtk.Align.START)
        waiting.append(Gtk.Spinner(spinning=True))
        waiting.append(self.status)
        self.spinner = self.add(waiting)
        stream = Gio.DataInputStream.new(self.process.get_stdout_pipe())
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.on_line, self.process)

    def on_line(self, stream, result, process):
        try:
            line, _ = stream.read_line_finish_utf8(result)
        except GLib.Error:
            line = None
        if process is not self.process:
            return  # the tab was closed meanwhile
        if line is None:
            self.finish()
            return
        try:
            event = json.loads(line)
        except ValueError:
            event = None
        if isinstance(event, dict):
            {"codex": self.on_codex_event, "gemini": self.on_agy_event}.get(self.engine, self.on_event)(event)
        elif line.strip() and self.engine != "codex":  # Codex logs to the same place; its events say enough
            self.stray_output.append(line)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.on_line, process)

    def on_event(self, event):
        kind = event.get("type")
        if event.get("session_id"):
            self.sessions[self.engine] = event["session_id"]
        if kind == "system" and event.get("subtype") == "init" and event.get("model"):
            self.window.show_model(event["model"])
        elif kind == "system" and event.get("subtype") == "status" and self.spinner:
            self.status.set_text(str(event.get("text", "")))
            self.status.set_visible(True)
        elif kind in ("assistant", "user"):
            content = event.get("message", {}).get("content")
            for block in content if isinstance(content, list) else []:
                self.on_block(block)
        elif kind == "rate_limit_event":
            self.window.claude_usage(event.get("rate_limit_info"))
        elif kind == "result":
            self.got_result = True
            if not event.get("is_error"):
                return
            # The CLI already said why as an assistant message, unless it failed before that.
            if event.get("subtype") != "success":
                self.add_text(str(event.get("result") or event.get("subtype")), error=True)
            self.window.check_sign_in(rejected=event.get("subtype") == "auth")

    def on_codex_event(self, event):
        """The Codex CLI tells the same story in its own words (codex exec --json)."""
        kind, item = event.get("type"), event.get("item") or {}
        if kind == "thread.started" and event.get("thread_id"):
            self.sessions["codex"] = event["thread_id"]
        elif kind == "item.started" and item.get("type") == "mcp_tool_call":
            self.on_block({"type": "tool_use", "id": item.get("id"), "name": item.get("tool", "?"),
                           "input": item.get("arguments")})
        elif kind == "item.completed" and item.get("type") == "mcp_tool_call":
            self.on_block({"type": "tool_result", "tool_use_id": item.get("id"),
                           "is_error": item.get("status") == "failed" or bool(item.get("error"))})
        elif kind == "item.completed" and item.get("type") == "command_execution":
            note_reading(self.sandbox, "shell", str(item.get("command", "")))
            self.add_tool(None, "shell", str(item.get("command", "")), described=True,
                          failed=item.get("exit_code") not in (0, None))
        elif kind == "item.completed" and item.get("type") == "agent_message":
            self.on_block({"type": "text", "text": item.get("text", "")})
        elif "web" in str(item.get("type", "")):  # its own search of the web
            note_reading(self.sandbox, "web_search", str(item.get("query") or item.get("url") or ""))
        elif kind == "turn.completed":
            self.got_result = True
            self.window.ask_usage("codex")
        elif kind in ("error", "turn.failed"):
            message = event.get("message") or (event.get("error") or {}).get("message") or "Codex stopped."
            self.trouble = str(message)

    def on_agy_event(self, event):
        """And the Antigravity CLI in its own (agy --output-format stream-json): the turn is a
        row of steps, each told of as it starts, as its text grows and as it ends."""
        kind = event.get("event")
        if event.get("conversation_id"):
            self.sessions["gemini"] = event["conversation_id"]
        if kind == "step_update":
            step = event.get("step_update") or {}
            state, info = step.get("state"), step.get("tool_info") or {}
            if step.get("step_type") == "agent_response":
                self.pending += str(step.get("text_delta") or "")
                if state != "ACTIVE":
                    self.say_pending()
            elif step.get("step_type") == "tool":
                self.say_pending()
                name, given = str(info.get("name") or step.get("tool_name") or "?"), info.get("parameters") or {}
                # Before it calls a tool of ours it reads how; that is not worth a row.
                if str(given.get("AbsolutePath", "")).startswith(AGY_TOOL_NOTES):
                    return
                # Its one tool for calling any server's: shown as the Mentor tool that was meant.
                if name == "call_mcp_tool" and given.get("ServerName") == "mentor":
                    name, given = TOOL_PREFIX + str(given.get("ToolName") or "?"), given.get("Arguments")
                call = f"{step.get('conversation_id')}:{step.get('step_index')}"
                if state == "ACTIVE":
                    self.on_block({"type": "tool_use", "id": call, "name": name, "input": given})
                else:
                    if call not in self.tool_icons:  # one that was over before it was told of
                        self.on_block({"type": "tool_use", "id": call, "name": name, "input": given})
                    self.on_block({"type": "tool_result", "tool_use_id": call,
                                   "is_error": state == "ERROR" or bool(info.get("error"))})
        elif kind == "result":
            result = event.get("result") or {}
            self.say_pending()
            if result.get("status") != "SUCCESS":
                self.trouble = str(result.get("error") or result.get("status") or "Gemini stopped.")
                return
            self.got_result = True
            refused = ", ".join(str(action.get("display_name") or action.get("action"))
                                for action in result.get("denied_actions") or [] if isinstance(action, dict))
            if refused and not str(result.get("response") or "").strip():
                self.add_text(f"Gemini reached for a tool of its own ({refused}) in place of Mentor’s, which "
                              "is not allowed here, and stopped. Ask again.", error=True)
            self.window.ask_usage("gemini")

    def say_pending(self):
        if self.pending.strip():
            self.on_block({"type": "text", "text": self.pending})
        self.pending = ""

    def on_block(self, block):
        kind = block.get("type")
        if kind == "text" and block.get("text", "").strip():
            self.last_said = block["text"].strip()
            self.add_text(block["text"])
        elif kind == "tool_use":
            if self.quick:  # say over the program that something is happening
                self.window.ask_say("Mentor is working\u2026")
            note_reading(self.sandbox, block.get("name", "?"), block.get("input"))
            self.add_tool(block.get("id"), block.get("name", "?"), block.get("input"))
        elif kind == "tool_result":
            icon = self.tool_icons.pop(block.get("tool_use_id"), None)
            item = self.tool_items.pop(block.get("tool_use_id"), None)
            if item:
                item["failed"] = bool(block.get("is_error"))
            if icon:
                failed = block.get("is_error")
                icon.set_from_icon_name("dialog-warning-symbolic" if failed else "object-select-symbolic")
        if self.spinner:  # keep it last
            self.messages.reorder_child_after(self.spinner, self.messages.get_last_child())

    def finish(self):
        """The CLI exited: the turn is over."""
        self.say_pending()
        if self.spinner:
            self.messages.remove(self.spinner)
            self.spinner = None
        for icon in self.tool_icons.values():  # calls that never got a result
            icon.set_from_icon_name("process-stop-symbolic")
        self.tool_icons.clear()
        self.tool_items.clear()
        # The Antigravity CLI logs to the same place; when it has said what went wrong, that is enough.
        if self.stray_output and not self.got_result and not self.trouble:
            self.add_text("\n".join(self.stray_output[-8:]), error=True)
        if self.trouble and not self.got_result:
            signed_out = self.engine == "codex" and ("401" in self.trouble or "nauthorized" in self.trouble)
            self.add_text("ChatGPT is not signed in." if signed_out else self.trouble, error=True)
            self.window.check_sign_in()
        self.process = None
        self.set_busy(False)
        self.window.save_conversations()
        self.offer_recipe()
        self.offer_share()
        self.note_used()
        if self.quick:  # asked with the text box over a program: the answer is shown above it
            self.quick = False
            said = self.last_said or self.trouble or "Mentor did not answer. The chat on the desktop says more."
            self.window.ask_say(re.sub(r"[*`#]", "", said))
            return
        self.window.on_finished(self)


def card(*children, **properties):
    """A dark translucent panel: how anything of ours stays readable on any wallpaper."""
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, **properties)
    box.add_css_class("agent-card")
    for child in children:
        box.append(child)
    return box


class DesktopWindow(Adw.ApplicationWindow):
    """The assistant's surface. It has no frame and no background of its own: the shell
    (the mentor extension) spreads it over the work area as a desktop-type window, under
    every application, so what is drawn here appears to be part of the wallpaper."""

    def __init__(self, app):
        super().__init__(application=app, title="Mentor", decorated=False,
                         default_width=1280, default_height=760)
        self.remove_css_class("background")
        self.add_css_class("agent")
        self.settings = load_settings()
        # The surface is on every workspace, and each has its own conversation on it: the
        # shell says which one is in front (go_to_workspace).
        self.workspace = 0
        self.last_on = {}  # workspace -> the conversation last looked at there

        # Top left: the conversations. Top right: the model.
        new_tab = Gtk.Button(icon_name="list-add-symbolic", tooltip_text="New conversation",
                             valign=Gtk.Align.CENTER)
        new_tab.add_css_class("osd")
        new_tab.add_css_class("circular")
        new_tab.connect("clicked", lambda *_: self.new_or_empty())
        # All of them by name: the bar only has room for some.
        self.tab_list = Gtk.MenuButton(icon_name="view-list-symbolic", tooltip_text="All conversations",
                                       valign=Gtk.Align.CENTER)
        self.tab_list.add_css_class("osd")
        self.tab_list.add_css_class("circular")
        self.tab_list.set_create_popup_func(self.fill_tab_list)
        go = Gio.SimpleAction.new("go-tab", GLib.VariantType.new("i"))
        go.connect("activate", lambda _action, index: self.go_to_tab(index.get_int32()))
        self.add_action(go)
        self.tabs = Adw.TabView()
        self.tabs.connect("close-page", self.on_close_page)
        self.tabs.connect("notify::selected-page", self.on_selected)
        tab_bar = Adw.TabBar(view=self.tabs, autohide=True, expand_tabs=False, hexpand=True)
        tab_bar.add_css_class("agent-tabs")

        labels = [label for label, _, _, _ in MODELS]
        if self.settings.get("choice") in labels:
            self.model_index = labels.index(self.settings["choice"])
        elif "model" in self.settings or {"default", "opus", "sonnet", "haiku", "fable"} & set(self.settings.get("resolved", {})):
            # Someone who used the assistant when it only knew Claude stays on Claude.
            aliases = [model for _, provider, model, _ in MODELS if provider == "claude"]
            first = [provider for _, provider, _, _ in MODELS].index("claude")
            saved = self.settings.get("model")
            self.model_index = first + (aliases.index(saved) if saved in aliases else 0)
        else:
            self.model_index = 0
        # Someone who has not picked yet is asked which engine they want (show_choice),
        # not walked into connecting the first of the list.
        self.unchosen = "choice" not in self.settings and self.model_index == 0
        if not self.unchosen:
            self.settings["choice"] = labels[self.model_index]
        # What Claude's names stood for used to be kept under the CLI's own words for them.
        known = self.settings.setdefault("resolved", {})
        for alias, label in (("default", "Claude"), ("fable", "Claude Fable"), ("opus", "Claude Opus"),
                             ("sonnet", "Claude Sonnet"), ("haiku", "Claude Haiku")):
            if alias in known:
                known.setdefault(label, known.pop(alias))
        # The picker's menu, shared by the buttons of all conversations: one submenu a provider.
        self.model_menu = Gio.Menu()
        picked = Gio.SimpleAction.new_stateful("model", GLib.VariantType.new("s"),
                                               GLib.Variant.new_string(labels[self.model_index]))
        picked.connect("activate", lambda _action, label: self.choose_model(
            [name for name, _, _, _ in MODELS].index(label.get_string())))
        self.add_action(picked)
        change = Gio.SimpleAction.new("change-key", GLib.VariantType.new("s"))
        change.connect("activate", lambda _action, provider: self.show_connect(change=provider.get_string()))
        self.add_action(change)
        again = Gio.SimpleAction.new("sign-in", GLib.VariantType.new("s"))
        again.connect("activate", lambda _action, provider: self.sign_in(provider.get_string()))
        self.add_action(again)
        # How hard the model thinks, in the same menu, for the engines that have such a setting.
        efforts = [value for _, value in EFFORTS]
        self.effort_index = efforts.index(self.settings.get("effort")) if self.settings.get("effort") in efforts else 0
        effort = Gio.SimpleAction.new_stateful("effort", GLib.VariantType.new("s"),
                                               GLib.Variant.new_string(efforts[self.effort_index] or ""))
        effort.connect("activate", lambda _action, value: self.choose_effort(efforts.index(value.get_string() or None)))
        self.add_action(effort)
        self.fill_model_menu()
        self.refresh_codex_models()
        self.usage = self.load_usage()

        # Top right: a bell, there only while the system has something to suggest. It does
        # not speak up by itself: what it holds is read when the user opens it.
        # The text box lifted out over the windows (toggle_ask): its window, whose it is, the picture taken.
        self.ask_window = self.ask_of = self.ask_shot = None
        self.advice_count = Gtk.Label()
        bell = Gtk.Box(spacing=6)
        bell.append(Gtk.Image(icon_name="preferences-system-notifications-symbolic"))
        bell.append(self.advice_count)
        self.advice_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14,
                                   margin_top=6, margin_bottom=6, margin_start=6, margin_end=6)
        self.advice_popover = Gtk.Popover(child=self.advice_list)
        self.advice_button = Gtk.MenuButton(child=bell, popover=self.advice_popover, valign=Gtk.Align.CENTER,
                                            tooltip_text="Suggestions for this system", visible=False)
        self.advice_button.add_css_class("model")

        top = Gtk.Box(spacing=8, margin_top=14, margin_start=16, margin_end=16)
        top.append(new_tab)
        top.append(self.tab_list)
        top.append(tab_bar)
        top.append(self.advice_button)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, vexpand=True)
        self.stack.add_named(self.tabs, "chat")
        self.connect_page = Gtk.Box(halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        self.stack.add_named(self.connect_page, "sign-in")

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content.append(top)
        content.append(self.stack)
        self.set_content(content)

        # Right-click on the desktop opens the assistant's own menu.
        self.chat_hidden = False
        for name, handler in (("clear-chat", lambda *_: self.ask_to_clear()),
                              ("new-chat", lambda *_: self.new_or_empty()),
                              ("history", lambda *_: self.show_history()),
                              ("toggle-chat", lambda *_: self.show_chat(self.chat_hidden)),
                              ("advice", lambda *_: self.show_advice_settings()),
                              ("mentor-settings", lambda *_: self.spawn(["/usr/local/bin/mentor-settings"])),
                              # What the desktop's menu has on stock GNOME.
                              ("background", lambda *_: self.spawn(["gnome-control-center", "background"])),
                              ("displays", lambda *_: self.spawn(["gnome-control-center", "display"])),
                              ("settings", lambda *_: self.spawn(["gnome-control-center"]))):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", handler)
            self.add_action(action)
        self.context_menu = Gtk.PopoverMenu.new_from_model(Gio.Menu())
        self.context_menu.set_has_arrow(False)
        self.context_menu.set_parent(content)
        right = Gtk.GestureClick(button=Gdk.BUTTON_SECONDARY)
        right.connect("pressed", self.on_right_click)
        content.add_controller(right)

        # A click anywhere on the desktop is a click on the assistant: the windows step
        # aside and the text box takes the keyboard. Escape puts the windows back.
        click = Gtk.GestureClick(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        click.connect("pressed", lambda *_: app.shell("Show"))
        self.add_controller(click)
        background = Gtk.GestureClick()
        background.connect("released", lambda *_: self.focus_entry())
        self.add_controller(background)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda _c, keyval, *_: keyval == Gdk.KEY_Escape and app.shell("Restore") is None)
        self.add_controller(keys)
        # Signing in happens in a terminal; look again when the user comes back.
        self.connect("notify::is-active", self.on_focus)
        self.connect("close-request", lambda *_: True)  # the desktop is not something one closes
        self.restoring = True  # nothing is saved while the saved conversations are being shown
        for saved in self.load_conversations():
            conversation = self.new_conversation()
            conversation.restore(saved)
            self.tabs.get_page(conversation).set_title(saved.get("title") or "Conversation")
        self.restoring = False
        if not os.path.exists(HISTORY_PATH):
            try:
                os.makedirs(os.path.dirname(HISTORY_PATH), exist_ok=True)
                with open(HISTORY_PATH, "w") as f:
                    for conversation in self.conversations():
                        moment = 0
                        for item in conversation.history:
                            moment = item.get("time") or moment
                            if item.get("text") and not item.get("error"):
                                f.write(json.dumps({"t": int(moment), "c": conversation.sandbox,
                                                    "title": self.tabs.get_page(conversation).get_title(),
                                                    "user": bool(item.get("user")), "text": item["text"]}) + "\n")
            except OSError:
                pass
        if not self.tabs.get_n_pages():
            self.new_conversation(first_run=not os.path.exists(WELCOMED_PATH))
        self.go_to_workspace(0)
        self.tell_restore()
        os.makedirs(NOTICES_DIR, exist_ok=True)
        self.notices_monitor = Gio.File.new_for_path(NOTICES_DIR).monitor_directory(Gio.FileMonitorFlags.NONE, None)
        self.notices_monitor.connect("changed", lambda *_: GLib.timeout_add(500, self.show_notices))
        self.show_notices()
        self.show_usage()
        if MODELS[self.model_index][1] in USAGE_ASKED:
            self.ask_usage(MODELS[self.model_index][1])
        self.advice_monitor = Gio.File.new_for_path(ADVICE_PATH).monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.advice_monitor.connect("changed", lambda *_: GLib.timeout_add(800, self.refresh_advice))
        # The agent can bring back what was turned away (suggestions_restore): the bell follows.
        self.advice_state_monitor = Gio.File.new_for_path(ADVICE_STATE_PATH).monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.advice_state_monitor.connect("changed", lambda *_: GLib.timeout_add(800, self.refresh_advice))
        self.refresh_advice()
        # A recipe that was used and never rated is asked about again, a long while after.
        GLib.timeout_add_seconds(90, self.ask_rating_again)
        GLib.timeout_add_seconds(6 * 3600, lambda: self.ask_rating_again() or True)
        # What was put off comes back when its time is up, without anything else having to happen.
        GLib.timeout_add_seconds(3600, lambda: self.refresh_advice() or True)
        self.check_sign_in()

    # --- conversations ------------------------------------------------------

    @property
    def current(self):
        page = self.tabs.get_selected_page()
        return page.get_child() if page else None

    def on_right_click(self, _gesture, _n_press, x, y):
        menu = Gio.Menu()
        menu.append("Show chat" if self.chat_hidden else "Hide chat", "win.toggle-chat")
        menu.append("Clear chat\u2026", "win.clear-chat")
        menu.append("New conversation", "win.new-chat")
        menu.append("History\u2026", "win.history")
        menu.append("Suggestions\u2026", "win.advice")
        menu.append("Mentor Settings\u2026", "win.mentor-settings")
        system = Gio.Menu()
        system.append("Change Background\u2026", "win.background")
        system.append("Display Settings", "win.displays")
        system.append("Settings", "win.settings")
        menu.append_section(None, system)
        self.context_menu.set_menu_model(menu)
        rect = Gdk.Rectangle()
        rect.x, rect.y, rect.width, rect.height = int(x), int(y), 1, 1
        self.context_menu.set_pointing_to(rect)
        self.context_menu.popup()

    def ask_to_clear(self):
        """Clearing cannot be taken back, so it is asked about; nothing to ask when nothing was said."""
        conversation = self.current
        if not conversation or conversation.untouched:
            return
        dialog = Adw.AlertDialog(heading="Clear this conversation?",
                                 body="What was said here is forgotten, by the assistant too. "
                                      "Changes already made to the system stay.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("clear", "Clear")
        dialog.set_response_appearance("clear", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _dialog, response: response == "clear" and conversation.clear())
        dialog.present(self)

    def show_chat(self, shown=True):
        """Hide what was said, leaving the bare wallpaper and the text box, or show it again."""
        self.chat_hidden = not shown
        for conversation in self.conversations():
            conversation.scroller.set_opacity(1 if shown else 0)
            conversation.scroller.set_can_target(shown)

    def load_conversations(self):
        try:
            with open(CONVERSATIONS_PATH) as f:
                saved = json.load(f)
            return [c for c in saved if isinstance(c, dict) and c.get("history")]
        except (OSError, ValueError):
            return []

    def save_conversations(self):
        if self.restoring:
            return
        saved = [c.saved(self.tabs.get_page(c).get_title()) for c in self.conversations() if c.history]
        try:
            os.makedirs(os.path.dirname(CONVERSATIONS_PATH), exist_ok=True)
            with open(CONVERSATIONS_PATH + ".new", "w") as f:
                json.dump(saved, f)
            os.replace(CONVERSATIONS_PATH + ".new", CONVERSATIONS_PATH)
        except OSError:
            pass

    def focus_entry(self):
        if self.current and self.stack.get_visible_child_name() == "chat":
            self.current.entry.grab_focus()

    def new_conversation(self, first_run=False):
        conversation = Conversation(self, first_run)
        page = self.tabs.append(conversation)
        page.set_title("New conversation")
        self.show_model()
        if hasattr(self, "usage"):
            self.show_usage()
        self.tabs.set_selected_page(page)
        conversation.entry.grab_focus()
        return conversation

    def new_or_empty(self):
        """A conversation to start in: one nothing was asked in yet, if this workspace has one."""
        for conversation in self.conversations():
            if conversation.workspace == self.workspace and conversation.untouched:
                self.tabs.set_selected_page(self.tabs.get_page(conversation))
                conversation.entry.grab_focus()
                return conversation
        return self.new_conversation()

    def fill_tab_list(self, button):
        menu = Gio.Menu()
        for index, conversation in enumerate(self.conversations()):
            title = self.tabs.get_page(conversation).get_title()
            if conversation.workspace != self.workspace:
                title += f"  (workspace {conversation.workspace + 1})"
            item = Gio.MenuItem.new(title, None)
            item.set_action_and_target_value("win.go-tab", GLib.Variant.new_int32(index))
            menu.append_item(item)
        more = Gio.Menu()
        more.append("History\u2026", "win.history")
        menu.append_section(None, more)
        button.set_menu_model(menu)

    def go_to_tab(self, index):
        if 0 <= index < self.tabs.get_n_pages():
            self.tabs.set_selected_page(self.tabs.get_nth_page(index))
            self.focus_entry()

    # --- history ----------------------------------------------------------------
    # Everything said, in every conversation, is also written to one file, a line each, and
    # stays there when a conversation is cleared or closed. It is read from the end, a part
    # at a time, so years of it cost nothing until they are scrolled to.

    def note(self, conversation, text, user):
        try:
            os.makedirs(os.path.dirname(HISTORY_PATH), exist_ok=True)
            with open(HISTORY_PATH, "a") as f:
                f.write(json.dumps({"t": int(time.time()), "c": conversation.sandbox,
                                    "title": self.tabs.get_page(conversation).get_title() if conversation.get_parent() else "",
                                    "user": bool(user), "text": text}) + "\n")
        except OSError:
            pass

    @staticmethod
    def read_history(end, count, wanted=""):
        """Up to `count` entries that end before byte `end` of the file (None: its end), newest
        first, and where the part read begins: (entries, start). `wanted` keeps only entries
        with those words."""
        entries, wanted = [], wanted.lower()
        try:
            with open(HISTORY_PATH, "rb") as f:
                if end is None:
                    end = f.seek(0, os.SEEK_END)
                while end > 0 and len(entries) < count:
                    start = max(0, end - 65536)
                    f.seek(start)
                    block = f.read(end - start)
                    if start > 0:  # begin at the first whole line
                        cut = block.find(b"\n") + 1
                        if cut == 0:
                            break
                        start, block = start + cut, block[cut:]
                    for line in reversed(block.splitlines()):
                        try:
                            entry = json.loads(line)
                        except ValueError:
                            continue
                        if isinstance(entry, dict) and wanted in str(entry.get("text", "")).lower():
                            entries.append(entry)
                    end = start
        except OSError:
            return [], 0
        return entries, end

    def show_history(self):
        dialog = Adw.Dialog(title="History", content_width=760, content_height=680)
        dialog.add_css_class("advice-details")
        rows = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=6, margin_bottom=18,
                       margin_start=24, margin_end=24)
        scroller = Gtk.ScrolledWindow(child=rows, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        search = Gtk.SearchEntry(placeholder_text="Search everything that was said", margin_start=24, margin_end=24,
                                 margin_bottom=8)
        state = {"end": None, "day": None, "done": False}

        def more(*_):
            if state["done"]:
                return
            entries, state["end"] = self.read_history(state["end"], 40, search.get_text().strip())
            state["done"] = state["end"] == 0
            for entry in entries:
                when = time.localtime(entry.get("t", 0))
                day = time.strftime("%A, %d %B %Y", when)
                if day != state["day"]:
                    state["day"] = day
                    heading = Gtk.Label(label=day, xalign=0, margin_top=10)
                    heading.add_css_class("heading")
                    rows.append(heading)
                who = Gtk.Label(xalign=0, use_markup=True, label=(
                    f"<b>{'You' if entry.get('user') else 'Mentor'}</b>  {time.strftime('%H:%M', when)}"
                    + (f"  \u00b7  {GLib.markup_escape_text(str(entry.get('title')), -1)}" if entry.get("title") else "")))
                who.add_css_class("caption")
                who.add_css_class("dim-label")
                text = str(entry.get("text", ""))
                text = text if len(text) <= 1500 else text[:1499] + "\u2026"
                said = Gtk.Label(xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR, selectable=True)
                if entry.get("user"):
                    said.set_text(text)
                else:
                    said.set_markup(to_markup(text))
                one = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                one.append(who)
                one.append(said)
                rows.append(one)
            if state["done"] and rows.get_first_child() is None:
                rows.append(Gtk.Label(label="Nothing yet." if not search.get_text().strip() else "Nothing found.",
                                      margin_top=30))

        def again(*_):
            while child := rows.get_first_child():
                rows.remove(child)
            state.update(end=None, day=None, done=False)
            more()

        scroller.connect("edge-reached", lambda _s, edge: edge == Gtk.PositionType.BOTTOM and more())
        search.connect("search-changed", again)
        view = Adw.ToolbarView(content=scroller)
        view.add_top_bar(Adw.HeaderBar())
        view.add_top_bar(search)
        dialog.set_child(view)
        dialog.set_focus(search)
        dialog.present(self)
        more()

    def on_selected(self, *_):
        current = self.current
        if current and current.workspace == self.workspace:
            self.last_on[self.workspace] = current

    # --- suggestions ----------------------------------------------------------

    def advice_state(self):
        try:
            with open(ADVICE_STATE_PATH) as f:
                state = json.load(f)
        except (OSError, ValueError):
            state = {}
        if not isinstance(state, dict):
            state = {}
        state.setdefault("off", False)
        state.setdefault("never", [])   # kinds of suggestion not to make again
        state.setdefault("until", {})   # a suggestion -> when it may be made again
        return state

    def save_advice_state(self, state):
        os.makedirs(os.path.dirname(ADVICE_STATE_PATH), exist_ok=True)
        with open(ADVICE_STATE_PATH, "w") as f:
            json.dump(state, f)

    def suggestions(self):
        """What there is to suggest now, less what the user has put off or does not want to hear of."""
        state = self.advice_state()
        if state["off"]:
            return []
        try:
            with open(ADVICE_PATH) as f:
                found = [s for s in json.load(f) if isinstance(s, dict) and s.get("id") and s.get("prompt")]
        except (OSError, ValueError):
            return []
        return [s for s in found
                if s.get("kind") not in state["never"] and state["until"].get(s["id"], 0) <= time.time()]

    def refresh_advice(self):
        """Fill the bell with the suggestions there are; no suggestions, no bell."""
        while child := self.advice_list.get_first_child():
            self.advice_list.remove(child)
        suggestions = self.suggestions()
        self.advice_button.set_visible(bool(suggestions))
        self.advice_count.set_text(str(len(suggestions)))
        if not suggestions:
            self.advice_popover.popdown()
        for suggestion in suggestions:
            title = Gtk.Label(xalign=0, wrap=True, max_width_chars=46, use_markup=True,
                              label=linked(suggestion.get("title", ""), suggestion.get("link")))
            title.add_css_class("heading")
            body = Gtk.Label(label=suggestion.get("body", ""), xalign=0, wrap=True, max_width_chars=46,
                             wrap_mode=Pango.WrapMode.WORD_CHAR, visible=bool(suggestion.get("body")))
            body.add_css_class("dim-label")
            words = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            words.append(title)
            top = Gtk.Box(spacing=12)
            top.append(Gtk.Image(icon_name=ADVICE_ICONS.get(suggestion.get("kind"), "dialog-information-symbolic"),
                                 pixel_size=24, valign=Gtk.Align.START, margin_top=2))
            if suggestion.get("details"):  # a click on the words under the title opens the whole of it
                opener = Gtk.Button(child=body, tooltip_text="Read all of it", visible=body.get_visible())
                opener.add_css_class("advice-open")
                opener.set_cursor(Gdk.Cursor.new_from_name("pointer"))
                opener.connect("clicked", lambda _b, suggestion=suggestion: self.show_advice_details(suggestion))
                words.append(opener)
            else:
                words.append(body)
            top.append(words)
            # To the chat: the agent takes it up, in a conversation of its own.
            look = Gtk.Button(label="Send to the chat")
            look.add_css_class("suggested-action")
            look.add_css_class("pill")
            look.connect("clicked", lambda _b, suggestion=suggestion: self.take_advice(suggestion))
            later = Gtk.Button(label="Not now")
            later.add_css_class("flat")
            later.connect("clicked", lambda _b, suggestion=suggestion: self.put_off(suggestion, days=3))
            never = Gtk.Button(label="Don\u2019t suggest this again")
            never.add_css_class("flat")
            never.connect("clicked", lambda _b, suggestion=suggestion: self.put_off(suggestion, never=True))
            buttons = Gtk.Box(spacing=6, halign=Gtk.Align.END)
            for button in (never, later, look):
                buttons.append(button)
            one = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            one.append(top)
            one.append(buttons)
            if self.advice_list.get_first_child():
                self.advice_list.append(Gtk.Separator())
            self.advice_list.append(one)
        return GLib.SOURCE_REMOVE

    def show_advice_details(self, suggestion):
        """The whole of a suggestion, over the desktop: to read, and to copy from."""
        self.advice_popover.popdown()
        dialog = Adw.Dialog(title=suggestion.get("title", "Suggestion"), content_width=720, content_height=620)
        dialog.add_css_class("advice-details")
        text = Gtk.Label(label=details_markup(suggestion["details"]), use_markup=True, xalign=0, yalign=0,
                         wrap=True, selectable=True, wrap_mode=Pango.WrapMode.WORD_CHAR)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=6, margin_bottom=18,
                       margin_start=24, margin_end=24)
        if suggestion.get("link"):  # the title again, as the way to the page itself
            heading = Gtk.Label(label=linked(suggestion.get("title", ""), suggestion["link"]), use_markup=True,
                                xalign=0, wrap=True)
            heading.add_css_class("title-3")
            page.append(heading)
        page.append(text)
        scroller = Gtk.ScrolledWindow(child=page, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        buttons = Gtk.Box(spacing=8, margin_top=10, margin_bottom=14, margin_start=24, margin_end=24)
        if suggestion.get("link"):
            visit = Gtk.Button(label="Open the page")
            visit.add_css_class("pill")
            visit.connect("clicked", lambda *_: Gio.AppInfo.launch_default_for_uri(suggestion["link"], None))
            buttons.append(visit)
        copy = Gtk.Button(label="Copy all")
        copy.add_css_class("pill")
        copy.connect("clicked", lambda *_: self.get_clipboard().set(suggestion["details"]))
        buttons.append(copy)
        buttons.append(Gtk.Box(hexpand=True))
        send = Gtk.Button(label="Send to the chat")
        send.add_css_class("suggested-action")
        send.add_css_class("pill")
        send.connect("clicked", lambda *_: (dialog.close(), self.take_advice(suggestion)))
        buttons.append(send)
        view = Adw.ToolbarView(content=scroller)
        view.add_top_bar(Adw.HeaderBar())
        view.add_bottom_bar(buttons)
        dialog.set_child(view)
        dialog.set_focus(send)  # not the text: a label that takes the focus selects all of itself
        dialog.present(self)

        def from_the_top():
            text.select_region(0, 0)
            scroller.get_vadjustment().set_value(0)
            return GLib.SOURCE_REMOVE
        GLib.idle_add(from_the_top)
        GLib.timeout_add(250, from_the_top)

    def put_off(self, suggestion, days=0, never=False):
        state = self.advice_state()
        if never and suggestion.get("kind") not in state["never"]:
            state["never"].append(suggestion.get("kind"))
        if days:
            state["until"][suggestion["id"]] = time.time() + days * 86400
        self.save_advice_state(state)
        self.refresh_advice()

    def take_advice(self, suggestion):
        """The user wants it looked into: now it goes to the agent, in a conversation of its own."""
        self.advice_popover.popdown()
        self.put_off(suggestion, days=7)
        prompt, shown = suggestion["prompt"], suggestion.get("title") or "Look into it"
        if suggestion.get("kind") in ("news", "gnome", "apps", "github", "recipes"):
            prompt = ("Review this, and tell me what we can make of it: what in it is of use to me and to this "
                      "system, and what we could do with it, most worthwhile first.\n\n" + prompt)
            shown = "Review this, what can we make of it: " + shown
        self.for_request().send(prompt, shown=shown)

    def show_advice_settings(self):
        """Suggestions on or off, and everything the user turned away, each with the way back."""
        dialog = Adw.Dialog(title="Suggestions", content_width=480)
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        dialog.set_child(view)

        def change(act):
            state = self.advice_state()
            act(state)
            self.save_advice_state(state)
            self.refresh_advice()
            fill()

        def row(title, subtitle, back):
            button = Gtk.Button(label="Bring back", valign=Gtk.Align.CENTER)
            button.connect("clicked", lambda *_: change(back))
            one = Adw.ActionRow(title=title, subtitle=subtitle)
            one.add_suffix(button)
            return one

        def fill():
            state = self.advice_state()
            page = Adw.PreferencesPage()
            main = Adw.PreferencesGroup(description=(
                "The system looks itself over now and then and notes what may be worth your attention. "
                "It waits behind the bell on the desktop. Nothing goes to the agent until you send it to the chat."))
            switch = Adw.SwitchRow(title="Suggest things for this system", active=not state["off"])
            switch.connect("notify::active", lambda *_: change(lambda s: s.update(off=not switch.get_active())))
            main.add(switch)
            page.add(main)
            hidden = Adw.PreferencesGroup(title="Not suggested any more")
            for kind in state["never"]:
                hidden.add(row(ADVICE_KINDS.get(kind, kind), "You chose not to be told about these again",
                               lambda s, kind=kind: s["never"].remove(kind)))
            try:
                with open(ADVICE_PATH) as f:
                    titles = {s["id"]: s.get("title") for s in json.load(f) if isinstance(s, dict) and s.get("id")}
            except (OSError, ValueError):
                titles = {}
            for key, when in sorted(state["until"].items(), key=lambda item: item[1]):
                if when > time.time():
                    hidden.add(row(titles.get(key) or key, f"Put off until {told_when(when)}",
                                   lambda s, key=key: s["until"].pop(key, None)))
            if not state["never"] and not any(when > time.time() for when in state["until"].values()):
                hidden.add(Adw.ActionRow(title="Nothing is hidden", subtitle="What you turn away is listed here"))
            page.add(hidden)
            view.set_content(page)

        fill()
        dialog.present(self)

    def go_to_workspace(self, index):
        """Show the conversation of a workspace: the one last looked at there, or a new one."""
        self.workspace = index
        here = [c for c in self.conversations() if c.workspace == index]
        last = self.last_on.get(index)
        if here:
            self.tabs.set_selected_page(self.tabs.get_page(last if last in here else here[-1]))
        else:
            self.new_conversation()
        # A workspace only passed through leaves no empty conversation behind.
        for conversation in self.conversations():
            if conversation.workspace != index and conversation.untouched and not conversation.first_run:
                self.tabs.close_page(self.tabs.get_page(conversation))
        self.focus_entry()

    # --- the text box over the windows (Alt+Space) --------------------------------

    def asking(self, conversation):
        """Whether this conversation's text box is the one shown over the windows now."""
        return self.ask_of is conversation

    def ask_say(self, text):
        """What is shown above the text box while it is over the windows."""
        if self.ask_of is None:
            return
        self.ask_words.set_label(text if len(text) <= 1500 else text[:1499] + "\u2026")
        self.ask_bubble.set_visible(bool(text))

    def toggle_ask(self):
        """Lift the text box of the conversation in front out of the desktop and show it
        over whatever the user is looking at, or put it back. A picture of the screen, as
        it was before the box came up, is attached for the agent to see what they see."""
        if self.ask_of is not None:
            self.close_ask()
            return
        conversation = self.current
        if conversation is None or self.unchosen or self.stack.get_visible_child_name() == "sign-in":
            self.get_application().shell("Show")  # nothing to ask yet: to the desktop, to connect an engine
            return
        os.makedirs(PASTED_DIR, exist_ok=True)
        shot = os.path.join(PASTED_DIR, time.strftime("screen-%H%M%S.png"))
        try:  # the shell takes it; nothing else may on Wayland
            self.get_application().get_dbus_connection().call_sync(
                "org.gnome.Shell", "/org/mentor/Shell", "org.mentor.Shell", "Screenshot",
                GLib.Variant("(s)", (shot,)), None, Gio.DBusCallFlags.NONE, 5000, None)
        except GLib.Error:
            shot = None
        if self.ask_window is None:
            self.ask_words = Gtk.Label(xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR, selectable=True,
                                       max_width_chars=70)
            self.ask_bubble = card(self.ask_words, visible=False, margin_start=12, margin_end=12)
            self.ask_bubble.add_css_class("said")
            self.ask_slot = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, width_request=720)
            box.append(self.ask_bubble)
            box.append(self.ask_slot)
            self.ask_window = Gtk.Window(application=self.get_application(), title="Ask Mentor", decorated=False,
                                         resizable=False, child=box)
            self.ask_window.add_css_class("agent")
            self.ask_window.add_css_class("ask-over")
            keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
            keys.connect("key-pressed", lambda _c, keyval, *_: keyval == Gdk.KEY_Escape and self.close_ask() is None)
            self.ask_window.add_controller(keys)
            self.ask_window.connect("close-request", lambda *_: self.close_ask() is None)
            # A click anywhere else puts the box back where it lives, on the desktop.
            self.ask_window.connect("notify::is-active", lambda window, _p: (
                not window.is_active() and GLib.timeout_add(200, self.ask_left)))
        self.ask_of, self.ask_shot = conversation, shot
        self.ask_say("")
        conversation.bottom_home.set_child(None)
        self.ask_slot.append(conversation.bottom)
        if shot and os.path.isfile(shot):
            conversation.attach(shot)
            conversation.entry.set_placeholder_text("Ask Mentor about what you see\u2026   (Esc puts this away)")
        self.ask_window.present()
        conversation.entry.grab_focus()

    def ask_left(self):
        """The window with the text box is no longer the one in front. (A moment after, so
        that a menu of its own opening and closing does not count.)"""
        if self.ask_of is not None and self.ask_window and not self.ask_window.is_active():
            self.close_ask()
        return GLib.SOURCE_REMOVE

    def close_ask(self):
        conversation, self.ask_of = self.ask_of, None
        if conversation is None:
            return
        conversation.quick = False  # an answer still to come is told of as always: in the chat, with a notification
        self.ask_window.set_visible(False)
        self.ask_slot.remove(conversation.bottom)
        conversation.bottom_home.set_child(conversation.bottom)
        # A picture that was taken for a question never asked is not kept for the next one.
        if self.ask_shot and conversation.attachments == [os.path.abspath(self.ask_shot)]:
            conversation.attachments = []
            while chip := conversation.attachment_bar.get_first_child():
                conversation.attachment_bar.remove(chip)
            conversation.attachment_bar.set_visible(False)
        conversation.entry.set_placeholder_text("Ask Mentor to do something\u2026")

    def ask_rating_again(self):
        """A recipe from the site that was applied here and never rated: one card, in the open
        conversation if it is quiet. Not more than one at a time, and each only again after days."""
        try:
            due = mentor_recipes.used_due() if mentor_recipes and mentor_settings and mentor_settings.get("offer_recipes") else None
            if due and self.current and not self.current.busy:
                rid, entry = due
                mentor_recipes.used_asked(rid)  # asked now, whatever the answer
                self.current.rating_card(rid, entry.get("title", rid), again=True)
        except Exception:
            pass
        return GLib.SOURCE_REMOVE

    def for_request(self):
        """The conversation a request from outside goes to: the open tab if nothing was
        asked in it yet, otherwise a new one, so running work is left alone."""
        current = self.current
        return current if current and current.untouched else self.new_conversation()

    def name_tab(self, conversation, text):
        title = " ".join(text.split())
        self.tabs.get_page(conversation).set_title(title if len(title) <= 28 else title[:27] + "…")

    def on_busy_changed(self, conversation):
        page = self.tabs.get_page(conversation) if conversation.get_parent() else None
        if page:
            page.set_loading(conversation.busy)

    def on_close_page(self, tabs, page):
        closed = page.get_child()
        closed.stop()
        closed.process = None  # what it may still say is no longer listened to
        tabs.close_page_finish(page, True)
        # There is always a place to type. Checked once the page is really gone.
        GLib.idle_add(lambda: tabs.get_n_pages() == 0 and bool(self.new_conversation()) and False)
        GLib.idle_add(lambda: self.save_conversations() and False)
        return Gdk.EVENT_STOP

    # --- model and sign-in --------------------------------------------------

    def conversations(self):
        return [self.tabs.get_nth_page(i).get_child() for i in range(self.tabs.get_n_pages())]

    def choose_model(self, index):
        """One model for all conversations, picked from the button next to any text box."""
        if index == self.model_index and not self.unchosen:
            return
        self.unchosen = False
        self.model_index = index
        self.settings["choice"] = MODELS[index][0]
        # Also by engine and model, for `mentor repair`, which talks to the same one on a console.
        self.settings["engine"], self.settings["engine_model"] = MODELS[index][1], MODELS[index][2]
        save_settings(self.settings)
        self.lookup_action("model").set_state(GLib.Variant.new_string(MODELS[index][0]))
        for conversation in self.conversations():
            conversation.model.set_label(self.shown_name(index))
            conversation.model.popdown()
        self.show_model()
        # The menu itself stays as it is: this is called from it, and taking it apart under the
        # click that is still being handled brought the assistant down. Only its top changes.
        GLib.idle_add(lambda: self.show_usage() and False)
        if MODELS[index][1] in USAGE_ASKED:
            self.ask_usage(MODELS[index][1])
        self.check_sign_in()

    def shown_name(self, index, short=False):
        """A model's name for the button, or (short) for its provider's submenu. Claude's names
        are families ("the latest Haiku"); once one has answered, its version is known and shown."""
        label, provider, model, name = MODELS[index]
        text = name if short else label
        exact = self.settings.get("resolved", {}).get(label, "")
        found = re.search(r"claude-([a-z]+)-(\d+)(?:-(\d{1,2}))?(?:-\d{6,})?$", exact) if provider == "claude" else None
        if found:
            version = found.group(2) + (f".{found.group(3)}" if found.group(3) else "")
            text = f"{text} {version}" if model else f"{text} ({found.group(1).capitalize()} {version})"
        return text

    def fill_model_menu(self):
        # The place at the top goes with the old menu: what was put there is taken out first.
        for conversation in self.conversations():
            menu = conversation.model.get_popover()
            if conversation.usage_box is not None and menu is not None and conversation.usage_box.get_parent():
                menu.remove_child(conversation.usage_box)
            conversation.usage_box = None
        self.model_menu.remove_all()
        # First in the menu, a place for the chosen model and what its account says of its limits (show_usage).
        top = Gio.Menu()
        place = Gio.MenuItem.new(None, None)
        place.set_attribute_value("custom", GLib.Variant.new_string("usage"))
        top.append_item(place)
        self.model_menu.append_section(None, top)
        for title, provider in MENUS:
            submenu = Gio.Menu()
            for label, engine, _, name in MODELS:
                if engine == provider:
                    item = Gio.MenuItem.new(self.shown_name([m[0] for m in MODELS].index(label), short=True), None)
                    item.set_action_and_target_value("win.model", GLib.Variant.new_string(label))
                    submenu.append_item(item)
            if provider in ACCOUNTS:  # for when the account's sign-in has gone stale
                extra = Gio.Menu()
                item = Gio.MenuItem.new("Sign in again\u2026", None)
                item.set_action_and_target_value("win.sign-in", GLib.Variant.new_string(provider))
                extra.append_item(item)
                submenu.append_section(None, extra)
            if provider in PROVIDERS:  # its key can be replaced at any time
                extra = Gio.Menu()
                item = Gio.MenuItem.new("Change key\u2026", None)
                item.set_action_and_target_value("win.change-key", GLib.Variant.new_string(provider))
                extra.append_item(item)
                submenu.append_section(None, extra)
            self.model_menu.append_submenu(title, submenu)
        # Always there, though Claude Code has no such setting and Gemini's models carry theirs in their names: a menu that changed with the
        # model would have to be rebuilt while it is open.
        choices = Gio.Menu()
        for label, value in EFFORTS:
            item = Gio.MenuItem.new("Default" if value is None else label, None)
            item.set_action_and_target_value("win.effort", GLib.Variant.new_string(value or ""))
            choices.append_item(item)
        section = Gio.Menu()
        section.append_submenu("Effort", choices)
        self.model_menu.append_section(None, section)
        if hasattr(self, "usage"):
            self.show_usage()

    # --- usage ----------------------------------------------------------------

    def load_usage(self):
        try:
            with open(USAGE_PATH) as f:
                usage = json.load(f)
            return usage if isinstance(usage, dict) else {}
        except (OSError, ValueError):
            return {}

    def set_usage(self, provider, windows):
        """Keep what an account said of its allowance, and show it."""
        if not windows:
            return
        self.usage[provider] = {"at": time.time(), "windows": windows}
        try:
            os.makedirs(os.path.dirname(USAGE_PATH), exist_ok=True)
            with open(USAGE_PATH, "w") as f:
                json.dump(self.usage, f)
        except OSError:
            pass
        self.show_usage()

    def claude_usage(self, info):
        """Claude Code tells of the allowance in the stream of every answer."""
        if not isinstance(info, dict):
            return
        windows = []
        named = info.get("unifiedWindows")
        for key, minutes in (("five_hour", 300), ("seven_day", 10080)):
            window = (named or {}).get(key)
            if isinstance(window, dict):
                windows.append({"minutes": minutes, "resets": window.get("resetsAt"),
                                "used": self.share(window.get("utilization"))})
        if not windows:  # only the window that is nearest its limit was told
            minutes = {"five_hour": 300}.get(info.get("rateLimitType"), 10080 if info.get("rateLimitType") else None)
            if info.get("resetsAt") or info.get("utilization") is not None:
                known = [w for w in self.usage.get("claude", {}).get("windows", []) if w.get("minutes") != minutes]
                windows = sorted(known + [{"minutes": minutes, "resets": info.get("resetsAt"),
                                           "used": self.share(info.get("utilization")),
                                           "status": info.get("status")}], key=lambda w: w.get("minutes") or 0)
        self.set_usage("claude", windows)

    @staticmethod
    def share(utilization):
        """Claude gives a share of one; shown as a percentage."""
        return round(utilization * 100) if isinstance(utilization, (int, float)) else None

    def ask_usage(self, provider):
        """Codex and Gemini have to be asked (mentor-usage)."""
        process = self.spawn([USAGE, provider], Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        if process:
            process.communicate_utf8_async(None, None, self.on_usage, provider)

    def on_usage(self, process, result, provider):
        try:
            _, out, _ = process.communicate_utf8_finish(result)
            windows = json.loads(out).get("windows") or []
        except (GLib.Error, ValueError, AttributeError):
            return
        self.set_usage(provider, [{"minutes": w.get("minutes"), "resets": w.get("resets"),
                                   "used": round(w["used"]) if isinstance(w.get("used"), (int, float)) else None}
                                  for w in windows if isinstance(w, dict)])  # both give percentages

    def show_usage(self):
        """Fill the top of the model's menu, in every conversation: the model chosen, and under it
        the limits of its account where the engine tells them."""
        provider = MODELS[self.model_index][1]
        known = self.usage.get(provider) or {}
        # A window whose reset has passed says nothing about now.
        windows = [w for w in known.get("windows", []) if not w.get("resets") or w["resets"] > time.time()]
        for conversation in self.conversations():
            menu = conversation.model.get_popover()
            if menu is None:
                continue
            if conversation.usage_box is not None and conversation.usage_box.get_parent():
                menu.remove_child(conversation.usage_box)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, width_request=320,
                          margin_top=6, margin_bottom=8, margin_start=10, margin_end=10)
            chosen = Gtk.Label(label=MODELS[self.model_index][0], xalign=0, hexpand=True)
            chosen.add_css_class("title-4")
            head = Gtk.Box(spacing=12)
            head.append(chosen)
            if provider not in ("claude", "gemini") and EFFORTS[self.effort_index][1]:
                effort = Gtk.Label(label=f"{EFFORTS[self.effort_index][0]} effort", xalign=1)
                effort.add_css_class("dim-label")
                head.append(effort)
            box.append(head)
            for window in windows:
                name = Gtk.Label(label=window_name(window.get("minutes")), xalign=0, hexpand=True)
                when = Gtk.Label(label=resets_when(window["resets"]) if window.get("resets") else "", xalign=1)
                when.add_css_class("dim-label")
                share = Gtk.Label(label=f"{window['used']}%" if window.get("used") is not None else
                                  {"allowed_warning": "nearly used", "rejected": "used up"}.get(window.get("status"), ""),
                                  xalign=1, width_chars=5)
                top = Gtk.Box(spacing=12)
                for label in (name, when, share):
                    top.append(label)
                one = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
                one.append(top)
                if window.get("used") is not None:
                    one.append(Gtk.ProgressBar(fraction=min(1.0, window["used"] / 100)))
                box.append(one)
            if windows:
                told = Gtk.Label(label=f"As {ACCOUNTS[provider][0]} last said, {told_when(known['at']).lower()}.", xalign=0)
            elif provider in ACCOUNTS:
                told = Gtk.Label(label="Its limits show here after the first answer.", xalign=0)
            else:
                # A model that runs on a key: which key that is, and the way to give it one.
                label, _, model, _ = MODELS[self.model_index]
                name = PROVIDERS[provider][0]
                own = os.path.exists(key_path(provider, model)) if model else False
                told = Gtk.Label(xalign=0, wrap=True, max_width_chars=40, label=(
                    f"Runs on a key of its own." if own else
                    f"Runs on the key the {name} models share." if read_key(provider) else "Has no key yet."))
            told.add_css_class("caption")
            told.add_css_class("dim-label")
            box.append(told)
            if provider in PROVIDERS:
                key = Gtk.Button(label=f"Set a key for {MODELS[self.model_index][0]}…", halign=Gtk.Align.START)
                key.add_css_class("pill")

                def set_key(_button, conversation=conversation, provider=provider):
                    conversation.model.popdown()
                    GLib.idle_add(lambda: self.show_connect(change=provider) and False)
                key.connect("clicked", set_key)
                box.append(key)
            conversation.usage_box = box if menu.add_child(box, "usage") else None

    def refresh_codex_models(self):
        """Ask Codex what its models are now; they change more often than this program does."""
        process = self.spawn([CODEX, "debug", "models"], Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        if process:
            process.communicate_utf8_async(None, None, self.on_codex_models)

    def on_codex_models(self, process, result):
        try:
            _, out, _ = process.communicate_utf8_finish(result)
            catalog = json.loads(out)["models"]
            models = [(m["slug"], m.get("display_name") or m["slug"]) for m in catalog if m.get("visibility") == "list"]
        except (GLib.Error, ValueError, KeyError, TypeError):
            return
        self.keep_models("codex", models)

    def keep_models(self, provider, models):
        """What an account said its models are: into the picker, and kept for the next start."""
        if not models:
            return
        try:
            os.makedirs(os.path.dirname(MODELS_PATHS[provider]), exist_ok=True)
            with open(MODELS_PATHS[provider], "w") as f:
                json.dump(models, f)
        except OSError:
            pass
        if add_models(provider, models):
            self.fill_model_menu()

    def choose_effort(self, index):
        if index == self.effort_index:
            return
        self.effort_index = index
        self.settings["effort"] = EFFORTS[index][1]
        save_settings(self.settings)
        self.lookup_action("effort").set_state(GLib.Variant.new_string(EFFORTS[index][1] or ""))
        self.show_usage()  # it says the effort beside the model

    def show_model(self, resolved=None):
        """Keep the exact model id as the pickers' tooltip. `resolved` is what the CLI just
        reported: a picker holds aliases ("the latest Opus"), this is what one stands for."""
        known = self.settings.setdefault("resolved", {})
        label = MODELS[self.model_index][0]
        if resolved and known.get(label) != resolved:
            known[label] = resolved
            save_settings(self.settings)
            self.fill_model_menu()  # the version is part of the name
            for conversation in self.conversations():
                conversation.model.set_label(self.shown_name(self.model_index))
        for conversation in self.conversations():
            conversation.model.set_tooltip_text(known.get(label, "Model the agent runs on"))

    def tell_restore(self):
        """After a start that failed and was put right automatically, say so, once."""
        try:
            with open(RESTORED_PATH) as f:
                report = json.load(f)
        except (OSError, ValueError):
            return
        try:
            with open(RESTORE_SEEN_PATH) as f:
                if f.read() == report["time"]:
                    return
        except OSError:
            pass
        lines = [f"The start after the last change failed: {report['why']}."]
        if report["undone"]:
            lines.append("Undone:")
            lines += [f"• {change['summary'] or change['id']}" for change in report["undone"]]
        if report["not_undone"]:
            lines.append("Could not be undone: " + ", ".join(change["id"] for change in report["not_undone"]))
        if report["kernel_held"]:
            lines.append("The kernel that failed is still installed, but the one that works is the one that starts.")
        self.current.add_notice(
            "problem", "Mentor went back to the way it last worked", "\n".join(lines),
            "The last start failed and Mentor went back to the way it last worked by itself. What it noted:\n\n"
            + "\n".join(lines) + "\n\nFind out why that start failed (boot_status, and the log of the start before "
            "this one), tell me in plain words, and say how the change could be tried again another way. Do not "
            "change anything before I agree.")
        # Also as a notification: the desktop may be covered, or showing the sign-in card.
        notification = Gio.Notification.new("Mentor went back to the way it last worked")
        notification.set_body("The start after the last change failed, so the change was undone.")
        notification.set_default_action("app.show")
        self.get_application().send_notification("restore", notification)
        os.makedirs(os.path.dirname(RESTORE_SEEN_PATH), exist_ok=True)
        with open(RESTORE_SEEN_PATH, "w") as f:
            f.write(report["time"])

    def show_notices(self):
        """Put what was left in NOTICES_DIR into the chat, oldest first, and take it from there."""
        try:
            names = [name for name in os.listdir(NOTICES_DIR) if name.endswith(".json")]
            names.sort(key=lambda name: os.path.getmtime(os.path.join(NOTICES_DIR, name)))
        except OSError:
            return GLib.SOURCE_REMOVE
        shown = []
        for name in names:
            path = os.path.join(NOTICES_DIR, name)
            try:
                with open(path) as f:
                    notice = json.load(f)
                os.remove(path)
                title, text = str(notice["title"]).strip(), str(notice.get("text") or "").strip()
            except (OSError, ValueError, KeyError, TypeError):
                continue
            if not title or not self.current:
                continue
            prompt = notice.get("prompt") if isinstance(notice.get("prompt"), str) else None
            self.current.add_notice(notice.get("level") if notice.get("level") in ("problem", "idea") else "warning", title, text, prompt,
                                    auto=notice.get("auto") is True)
            shown.append((title, text))
        if shown:
            self.show_chat()
            if not self.is_active():  # the desktop is covered: say that there is something on it
                notification = Gio.Notification.new(shown[-1][0])
                notification.set_body(shown[-1][1] if len(shown[-1][1]) <= 160 else shown[-1][1][:159] + "…")
                notification.set_default_action("app.show")
                self.get_application().send_notification("notice", notification)
        return GLib.SOURCE_REMOVE

    def on_finished(self, conversation):
        """An answer nobody is looking at (the desktop is covered) is announced."""
        if self.is_active() or not conversation.last_said:
            return
        text = " ".join(re.sub(r"[*`#]", "", conversation.last_said).split())  # no Markdown in a notification
        notification = Gio.Notification.new("Mentor has finished")
        notification.set_body(text if len(text) <= 160 else text[:159] + "\u2026")
        notification.set_default_action("app.show")
        self.get_application().send_notification(conversation.sandbox, notification)

    def on_focus(self, *_):
        if not self.is_active():
            return
        if self.stack.get_visible_child_name() == "sign-in":
            self.check_sign_in()
        self.focus_entry()

    def sign_in(self, provider):
        """Open a terminal on the account's own sign-in."""
        if provider == "claude":
            # Claude Code marks a token refresh in progress with a directory. One left behind
            # by a refresh that was cut off (the computer went down) blocks every later one.
            lock = os.path.expanduser("~/.claude/.oauth_refresh.lock")
            try:
                if time.time() - os.path.getmtime(lock) > 120:
                    os.rmdir(lock)
            except OSError:
                pass
        self.spawn(["kgx", "-e", ACCOUNTS[provider][4]])

    def show_choice(self):
        """The card of a first start: the engines there are, none of them picked yet."""
        if getattr(self, "connect_showing", None) == "choice" and self.stack.get_visible_child_name() == "sign-in":
            return
        self.connect_showing = "choice"
        title = Gtk.Label(label="Connect the agent")
        title.add_css_class("title-2")
        text = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=44, label=(
            "Mentor’s assistant runs on the model you choose. Pick one to start with; the button "
            "beside the text box changes it at any time."))
        options = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, halign=Gtk.Align.CENTER, margin_top=6)
        needs = {"nvidia": "Models NVIDIA hosts free of charge, with a key from its page",
                 "claude": "With your Claude account", "codex": "With your ChatGPT account",
                 "gemini": "With your Google account"}
        for label, provider in MENUS:
            name = Gtk.Label(label=label, xalign=0)
            name.add_css_class("heading")
            what = Gtk.Label(label=needs[provider], xalign=0)
            what.add_css_class("caption")
            what.add_css_class("dim-label")
            inside = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin_top=4, margin_bottom=4,
                             margin_start=8, margin_end=8)
            inside.append(name)
            inside.append(what)
            option = Gtk.Button(child=inside, width_request=380)
            index = [p for _, p, _, _ in MODELS].index(provider)
            option.connect("clicked", lambda _button, index=index: self.choose_model(index))
            options.append(option)
        while child := self.connect_page.get_first_child():
            self.connect_page.remove(child)
        self.connect_page.append(card(Gtk.Image(icon_name=APP_ID, pixel_size=72), title, text, options))
        self.stack.set_visible_child_name("sign-in")

    def show_connect(self, rejected=False, change=None):
        """The card that connects the engine of the chosen model: a key for the hosted models,
        an account for Claude or ChatGPT. From it one can also turn to another engine.
        `change` names a provider whose key is to be replaced, whatever model is chosen."""
        provider = change or MODELS[self.model_index][1]
        # Asked for again while it is already showing (the window got the focus back, which
        # happens when a menu on the card opens): left as it is, or the menu would be torn down.
        showing = (provider, MODELS[self.model_index][0], rejected, change)
        if showing == getattr(self, "connect_showing", None) and self.stack.get_visible_child_name() == "sign-in":
            return
        self.connect_showing = showing
        # The model the card is about, when it is one of this provider's.
        label, chosen, model, _ = MODELS[self.model_index]
        if chosen != provider:
            label = model = None
        title = Gtk.Label(label="Connect the agent")
        title.add_css_class("title-2")
        widgets = [Gtk.Image(icon_name=APP_ID, pixel_size=72), title]
        if provider in ACCOUNTS:
            name, through, program, _, _ = ACCOUNTS[provider]
            account = "Google" if provider == "gemini" else name
            widgets.append(Gtk.Label(
                label=f"{name} runs through {through}. Sign in once with your {account} account."
                      + ("" if GLib.find_program_in_path(program) else
                         f" {through} is downloaded first, which takes a minute."),
                wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=44))
            button = Gtk.Button(label=f"Sign in to {name}", halign=Gtk.Align.CENTER)
            button.add_css_class("suggested-action")
            button.add_css_class("pill")
            button.connect("clicked", lambda *_: self.sign_in(provider))
            widgets.append(button)
        else:
            name, page, text = PROVIDERS[provider]
            if label:  # which model the key is asked for
                title.set_label(f"Connect {label}")
                chosen = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=48, use_markup=True,
                                   label=f"You chose <b>{GLib.markup_escape_text(label, -1)}</b>, one of {name}’s "
                                         f"models. The key you paste here is the one it runs on" + (
                                             f". {name}’s other models keep the key they have." if read_key(provider) else
                                             f"; {name}’s other models use it too, until one of them is given "
                                             f"a key of its own."))
                widgets.append(chosen)
            widgets.append(Gtk.Label(label=text, wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=48))
            if rejected:
                refused = Gtk.Label(label=f"{name} did not accept the saved key for {label}. Paste one that works "
                                          "for this model.", wrap=True,
                                    justify=Gtk.Justification.CENTER, max_width_chars=48)
                refused.add_css_class("chat-error")
                widgets.append(refused)
            get = Gtk.Button(label=f"Open {name}\u2019s page", halign=Gtk.Align.CENTER)
            get.add_css_class("suggested-action")
            get.add_css_class("pill")
            get.connect("clicked", lambda *_: Gio.AppInfo.launch_default_for_uri(page, None))
            entry = Gtk.PasswordEntry(show_peek_icon=True, hexpand=True, placeholder_text="Paste the key here")
            save = Gtk.Button(label="Save")
            save.add_css_class("pill")

            # A key is kept for the model it was pasted for. The first one is also the one the
            # provider's other models fall back on, so that one key is enough where one key serves
            # them all; a model that the provider refuses it for asks for its own (rejected).
            def on_save(*_):
                if entry.get_text().strip():
                    if model:
                        write_key(provider, entry.get_text(), model)
                        if not read_key(provider):
                            write_key(provider, entry.get_text(), keep_others=True)
                    else:
                        write_key(provider, entry.get_text())
                    self.check_sign_in()

            save.connect("clicked", on_save)
            entry.connect("activate", on_save)
            row = Gtk.Box(spacing=8)
            row.append(entry)
            row.append(save)
            widgets += [get, row]
            if change:
                widgets.remove(title)
                title = Gtk.Label(label=f"A key for {label}" if label else f"Change the {name} key")
                title.add_css_class("title-2")
                widgets.insert(1, title)
                back = Gtk.Button(label="Keep the key I have", halign=Gtk.Align.CENTER)
                back.add_css_class("flat")
                back.connect("clicked", lambda *_: self.check_sign_in())
                widgets.append(back)
        # The other ways to run the assistant.
        others = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER, margin_top=6, visible=not change)
        others.append(Gtk.Label(label="Or use"))
        if provider in PROVIDERS:  # another model of the same provider, without leaving the card
            same = Gio.Menu()
            for name, engine, _, _ in MODELS:
                if engine == provider:
                    item = Gio.MenuItem.new(name, None)
                    item.set_action_and_target_value("win.model", GLib.Variant.new_string(name))
                    same.append_item(item)
            another = Gtk.MenuButton(label=f"another {PROVIDERS[provider][0]} model", menu_model=same,
                                     direction=Gtk.ArrowType.UP)
            another.add_css_class("flat")
            others.append(another)
        for label, first in MENUS:
            if first == provider:
                continue
            other = Gtk.Button(label=label)
            other.add_css_class("flat")
            index = [p for _, p, _, _ in MODELS].index(first)
            other.connect("clicked", lambda _button, index=index: self.choose_model(index))
            others.append(other)
        widgets.append(others)
        while child := self.connect_page.get_first_child():
            self.connect_page.remove(child)
        self.connect_page.append(card(*widgets))
        self.stack.set_visible_child_name("sign-in")

    def spawn(self, argv, flags=Gio.SubprocessFlags.NONE, sandbox=None, key=None, own_group=False, folder=None):
        if own_group:  # setsid becomes the program itself, at the head of a group that can be stopped as one
            argv = ["setsid"] + list(argv)
        launcher = Gio.SubprocessLauncher.new(flags)
        launcher.set_cwd(folder or GLib.get_home_dir())
        if sandbox:
            launcher.setenv("MENTOR_SANDBOX", sandbox, True)  # read by the mentor tools
        if key:
            launcher.setenv("MENTOR_API_KEY", key, True)  # in the environment: not for other users to read
        # With only our handful of tools, give the model their descriptions up front
        # instead of making it search for them by name.
        launcher.setenv("ENABLE_TOOL_SEARCH", "false", True)
        try:
            return launcher.spawnv(argv)
        except GLib.Error:
            return None

    def check_sign_in(self, rejected=False):
        """Show the conversations if the chosen model's engine is ready to answer, otherwise how to connect it."""
        if self.unchosen:
            self.show_choice()
            return
        _, provider, _, _ = MODELS[self.model_index]
        if provider not in ACCOUNTS:
            if read_key(provider, MODELS[self.model_index][2]) and not rejected:
                self.stack.set_visible_child_name("chat")
                self.focus_entry()
            else:
                self.show_connect(rejected)
            return
        if provider == "gemini":
            agy_keyring()
        process = self.spawn(ACCOUNTS[provider][3], Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        if process:
            process.communicate_utf8_async(None, None, self.on_sign_in_status, provider)
        else:  # the CLI itself is missing
            self.show_connect()

    def on_sign_in_status(self, process, result, provider):
        try:
            _, out, _ = process.communicate_utf8_finish(result)
            if provider == "claude":
                signed_in = json.loads(out).get("loggedIn", False)
            else:  # Codex answers with its exit status, as does the Antigravity CLI asked for its models
                signed_in = process.get_exit_status() == 0
            if signed_in and provider == "gemini":
                # One to a line, "id<tab>name". It also offers other makers' models, which have
                # their own entries in the picker and their own accounts.
                listed = [line.split("\t", 1) for line in out.splitlines() if "\t" in line]
                self.keep_models("gemini", [(model.strip(), name.strip()) for model, name in listed
                                            if model.startswith("gemini")])
        except (GLib.Error, ValueError, AttributeError):
            signed_in = True  # cannot tell; let a real message report the problem
        # Codex is only there, and only says what its models are, once the user has signed in:
        # the list asked for when the assistant started came back empty then.
        if signed_in and provider == "codex" and sum(engine == "codex" for _, engine, _, _ in MODELS) < 2:
            self.refresh_codex_models()
        if MODELS[self.model_index][1] != provider:
            return  # another engine was chosen while this was being asked
        # An account that was signed in before is not called signed out on one failed asking:
        # right after a login the keyring or the network may not be there yet, and the asking
        # fails the same way. It is asked a few times more before the card comes up.
        known = self.settings.setdefault("signed_in", [])
        tries = getattr(self, "sign_in_tries", 0)
        if signed_in:
            self.sign_in_tries = 0
            if provider not in known:
                known.append(provider)
                save_settings(self.settings)
            self.stack.set_visible_child_name("chat")
        elif provider in known and tries < 5:
            self.sign_in_tries = tries + 1
            GLib.timeout_add_seconds(6, lambda: self.check_sign_in() and False)
        else:
            self.sign_in_tries = 0
            if provider in known:
                known.remove(provider)
                save_settings(self.settings)
            self.show_connect()


class AssistantApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)

    def do_startup(self):
        Adw.Application.do_startup(self)
        show = Gio.SimpleAction.new("show", None)  # a click on one of our notifications
        show.connect("activate", lambda *_: self.shell("Show"))
        self.add_action(show)
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def shell(self, method):
        """Ask the shell (the mentor extension) for Show, which clears the windows away so
        the desktop can be seen, or Restore, which puts them back."""
        self.get_dbus_connection().call(
            "org.gnome.Shell", "/org/mentor/Shell", "org.mentor.Shell", method,
            None, None, Gio.DBusCallFlags.NONE, -1, None, None)

    def do_command_line(self, command_line):
        arguments = command_line.get_arguments()[1:]
        # The desktop's own window, not "the active one": once the text box has been lifted over
        # a program (Alt+Space) the active window can be that second window, and not this one.
        window = next((w for w in self.get_windows() if isinstance(w, DesktopWindow)), None)
        if window is None:  # first start: at login, or summoned after a crash
            window = DesktopWindow(self)
            window.present()
            if not arguments:
                return 0
        if not arguments:  # started again by hand, e.g. from a pinned icon: go to the desktop
            self.shell("Show")
            return 0
        if arguments[:1] == ["--workspace"] and len(arguments) == 2 and arguments[1].isdigit():
            if int(arguments[1]) != window.workspace:
                window.go_to_workspace(int(arguments[1]))
            return 0
        if arguments == ["--ask"]:  # Alt+Space, Super+Z
            window.toggle_ask()
            return 0
        if arguments[:1] == ["--app"] and len(arguments) == 2:
            window.for_request().set_subject(app_id=arguments[1])
        elif arguments[:1] == ["--file"] and len(arguments) > 1:
            conversation = window.for_request()
            for path in arguments[1:]:
                conversation.attach(path)
        else:
            window.for_request().send(" ".join(arguments))
        self.shell("Show")
        return 0


AssistantApp().run(sys.argv)
