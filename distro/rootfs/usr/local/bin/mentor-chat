MODELS_PATHS = {provider: os.path.join(GLib.get_user_cache_dir(), "mentor", f"{provider}-models.json")
                for provider in ("codex", "gemini")}


def add_models(provider, models):
    """Add an account's models to the picker: (id, name) pairs. True if any were new."""
    known = {model for _, engine, model, _ in MODELS if engine == provider}
    new = [(str(model), str(name)) for model, name in models if model not in known]
    MODELS.extend((name, provider, model, name) for model, name in new)
    return bool(new)


for provider, path in MODELS_PATHS.items():
    try:
        with open(path) as f:
            add_models(provider, json.load(f))
    except (OSError, ValueError, TypeError):
        pass

