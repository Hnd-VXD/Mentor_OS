#!/usr/bin/python3
"""Recipes: the recipes that were used on this computer, the ones written here, the ones downloaded
and not used yet, and a way to the recipes site. See /etc/mentor/RECIPES.md.

Nothing here calls a model. "Take it away", "Share" and "Follow it" hand a request to the assistant
on the desktop; the thumbs send one signed vote to the site (mentor_hub.rate).
"""
import os
import re
import subprocess
import sys
import threading
import time

sys.path.insert(0, "/usr/local/lib/mentor")
import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk

import mentor_recipes

CHAT = "/usr/local/bin/mentor-chat"
SITE = "https://mentor-recipes.netlify.app"
SITE_FOLDER = os.path.join(mentor_recipes.FOLDER, "from the site")


def short_words(prompt):
    """What the user sees of a request handed to the assistant: its first sentence, without the paths."""
    first = re.split(r"(?<=[^\d])[.:](?:\s|$)", prompt, maxsplit=1)[0]
    first = re.sub(r"\s*\(/[^)]*\)", "", first)            # "(/home/admin/...md)"
    first = re.sub(r"\s(at|is)\s/\S*?([^/\s]+)\.md\b", " \u201c\\2\u201d", first)  # "at /home/.../x.md" -> the quoted name
    return first if len(first) <= 110 else first[:109] + "\u2026"


def ask(prompt):
    """Hand a request to the assistant on the desktop. The chat shows the user its first sentence; the
    rest (the steps, the file, the tool to call) is for the agent."""
    try:
        subprocess.Popen([CHAT, "--as", short_words(prompt), prompt], start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def later(work, done):
    def run():
        try:
            result = work()
        except Exception as e:
            result = e
        GLib.idle_add(lambda: done(result) and False)
    threading.Thread(target=run, daemon=True).start()


THUMBS = "/usr/share/icons/hicolor/scalable/actions/mentor-thumb-{}-symbolic.svg"


def thumb(which, size=16):
    """Mentor's own thumbs icon, up or down: symbolic, so drawn in the theme's colour (Adwaita has none)."""
    return Gtk.Image(gicon=Gio.FileIcon.new(Gio.File.new_for_path(THUMBS.format(which))), pixel_size=size)


def button(label, action, suggested=False, tip=None):
    made = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
    if suggested:
        made.add_css_class("suggested-action")
    if tip:
        made.set_tooltip_text(tip)
    made.connect("clicked", lambda *_: action())
    return made


def day(when):
    return time.strftime("%Y-%m-%d", time.localtime(float(when or 0)))


def open_file(path):
    try:
        Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(path).get_uri(), None)
    except GLib.Error:
        pass


ROW = re.compile(r"(?m)^\|\s*([A-Za-z][A-Za-z ]{1,20}?)\s*\|\s*(.+?)\s*\|\s*$")
SHOWN = ("Needs", "Touches", "Risk", "Made on", "Written by", "Based on")


def details(path):
    """(title, one line of what it does, [(name, value)] of the rows worth showing) of a recipe file."""
    title, summary, rows = os.path.basename(path)[:-3], "", []
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read(60000)
    except OSError:
        return title, summary, rows
    if text.startswith("---\n") and "\n---" in text[4:]:  # the site's header
        text = text[text.find("\n---", 4) + 4:]
    title = next((l[2:].strip() for l in text.splitlines() if l.startswith("# ")), title)
    summary = next((l.lstrip("> ").strip() for l in text.splitlines() if l.startswith(">")), "")
    found = {m.group(1).strip(): m.group(2) for m in ROW.finditer(text)}
    rows = [(k, found[k]) for k in SHOWN if found.get(k)]
    return title, summary, rows


class WidePage(Gtk.ScrolledWindow):
    """A page of groups, like Adw.PreferencesPage but as wide as the window allows (up to 1100 pixels):
    the standard page stops at about 600, which leaves rows of buttons squeezed in a wide window."""

    def __init__(self):
        super().__init__(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24, margin_top=24, margin_bottom=24,
                           margin_start=12, margin_end=12)
        self.set_child(Adw.Clamp(maximum_size=1100, tightening_threshold=900, child=self.box))

    def add(self, group):
        self.box.append(group)


class RecipesWindow(Adw.ApplicationWindow):
    """Two tabs (from the site, and the user's own), one search over both, and a row for each recipe
    that opens to say what it does. Built for hundreds: rows are only hidden by the search, never rebuilt."""

    def __init__(self, app):
        super().__init__(application=app, title="Recipes", default_width=800, default_height=760)
        self.rows = []  # (row, the words it can be found by)
        self.built = 0.0
        self.view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        site = Gtk.Button(label="Open the recipes site")
        site.add_css_class("suggested-action")
        site.connect("clicked", lambda *_: Gio.AppInfo.launch_default_for_uri(SITE, None))
        header.pack_start(site)
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Refresh")
        refresh.connect("clicked", lambda *_: self.rebuild())
        header.pack_end(refresh)
        self.stack = Adw.ViewStack()
        self.site_bin, self.mine_bin = Adw.Bin(), Adw.Bin()
        self.stack.add_titled_with_icon(self.site_bin, "site", "From the site", "folder-download-symbolic")
        self.stack.add_titled_with_icon(self.mine_bin, "mine", "Mine", "document-edit-symbolic")
        header.set_title_widget(Adw.ViewSwitcher(stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE))
        self.view.add_top_bar(header)
        self.search = Gtk.SearchEntry(placeholder_text="Search recipes", hexpand=True,
                                      margin_start=12, margin_end=12, margin_top=6, margin_bottom=6)
        self.search.connect("search-changed", lambda *_: self.filter())
        self.view.add_top_bar(self.search)
        self.view.set_content(self.stack)
        self.set_content(self.view)
        # Back to the window: look again, but not more than twice a minute (and the search stays as it was).
        self.connect("notify::is-active", lambda *_: self.is_active() and time.time() - self.built > 30 and self.rebuild())
        self.rebuild()

    # --- rows ---------------------------------------------------------------------

    def recipe_row(self, title, subtitle, summary, rows, extra=""):
        """A row that opens to say what the recipe does, like a card on the site."""
        row = Adw.ExpanderRow(title=GLib.markup_escape_text(title), subtitle=GLib.markup_escape_text(subtitle))
        lines = [GLib.markup_escape_text(summary or "It does not say what it does in one line.")]
        if rows:
            lines.append("<small>" + "\n".join(f"<b>{GLib.markup_escape_text(k)}</b>  {GLib.markup_escape_text(v)}" for k, v in rows) + "</small>")
        label = Gtk.Label(label="\n\n".join(lines), use_markup=True, wrap=True, xalign=0, selectable=True,
                          margin_start=14, margin_end=14, margin_top=10, margin_bottom=10)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(label)
        # the buttons inside, under what it does: Delete, and Remove it from the site for one that is there
        row.actions = Gtk.Box(spacing=8, margin_start=14, margin_end=14, margin_bottom=12, visible=False)
        box.append(row.actions)
        row.add_row(box)
        row.inside = box
        self.rows.append((row, " ".join([title, summary, extra] + [v for _k, v in rows]).lower()))
        return row

    def filter(self):
        words = self.search.get_text().lower().split()
        for row, hay in self.rows:
            row.set_visible(all(w in hay for w in words))

    # --- the two tabs -------------------------------------------------------------

    def rebuild(self):
        self.built = time.time()
        self.rows = []
        used = mentor_recipes.used_load()

        site = WidePage()
        group = Adw.PreferencesGroup(title="Used on this computer", description="Recipes from the site that Mentor applied")
        if not used:
            group.add(Adw.ActionRow(title="None yet", subtitle="A recipe you download from the site and follow is listed here"))
        for rid, entry in sorted(used.items(), key=lambda item: -float(item[1].get("applied", 0))):
            title, summary, rows = details(entry.get("path", ""))
            row = self.recipe_row(entry.get("title") or title, "", summary, rows, rid)
            self.say(row, entry)
            row.add_suffix(self.recipe_switch(not entry.get("undone"), entry.get("title") or rid, entry.get("path", ""), rid, row))
            # an opening row shows each new button before the ones already there: added from the right
            for vote, tip in (("down", "It did not work"), ("up", "It worked")):
                rating = button("", lambda rid=rid, vote=vote, row=row: self.rate(rid, vote, row), tip=tip)
                rating.set_child(thumb(vote))
                row.add_suffix(rating)
            path_used = entry.get("path", "")
            row.add_suffix(button("Improve", lambda path=path_used, title=entry.get("title") or title, rid=rid, row=row:
                                  self.improve_copy(path, title, rid, row)))
            group.add(row)
        site.add(group)

        waiting, known = [], {e.get("sha") for e in used.values()}
        downloads = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD) or os.path.expanduser("~/Downloads")
        for folder in (SITE_FOLDER, downloads):
            try:
                names = sorted(os.listdir(folder))
            except OSError:
                continue
            for name in names:
                path = os.path.join(folder, name)
                if not name.endswith(".md") or not mentor_recipes.looks_like_recipe(path):
                    continue
                sha = mentor_recipes.sha_of(path)
                if sha and sha not in known:  # the same recipe in both folders is listed once
                    known.add(sha)
                    waiting.append(path)
        group = Adw.PreferencesGroup(title="Downloaded, not used yet", description="Mentor looks at each with you before it changes anything")
        if not waiting:
            group.add(Adw.ActionRow(title="None", subtitle="Press Download on a recipe on the site, and it is here"))
        for path in waiting:
            title, summary, rows = details(path)
            row = self.recipe_row(title, os.path.basename(os.path.dirname(path)), summary, rows)
            row.add_suffix(button("Follow it", lambda path=path: ask(
                f"I want to use the recipe at {path}. Follow \u201cFollowing a recipe made by someone else\u201d in "
                "/etc/mentor/RECIPES.md from the first step: inspect it, give me the short report, and wait for my answer."),
                suggested=True))
            row.add_suffix(button("Improve", lambda path=path, title=title, row=row: self.improve_copy(path, title, None, row)))
            self.delete_button(row, path, title)
            group.add(row)
        site.add(group)
        self.site_bin.set_child(site)

        # the user's own recipes, one row each; the ones that are also on the site say so, with
        # what can be done there (Update, Remove), when the site's list has come
        mine_page = WidePage()
        self.mine_group = Adw.PreferencesGroup(
            title="My recipes", description="Kept in Documents / Mentor recipes. The ones on the site are public, and only you can change them")
        self.mine_rows = {}  # title, in lower case -> (row, share button, update button)
        mine = mentor_recipes.listing()
        off = mentor_recipes.off_load()
        self.mine_none = None
        if not mine:
            self.mine_none = Adw.ActionRow(title="None yet", subtitle="After something works, Mentor offers to write down how it was done")
            self.mine_group.add(self.mine_none)
        for name, title, when in mine:
            path = os.path.join(mentor_recipes.FOLDER, name)
            _t, summary, rows = details(path)
            row = self.recipe_row(title, day(when), summary, rows)
            row.day = day(when)
            row.switch = self.recipe_switch(name not in off, title, path, name, row)
            row.add_suffix(row.switch)
            # an opening row shows each new button before the ones already there: added from the right
            update = button("Update", lambda: None)
            update.set_visible(False)
            row.add_suffix(update)
            share = button("Share", lambda path=path, title=title: ask(
                f"I want to share my recipe \u201c{title}\u201d ({path}) on the recipes site. Look first whether the same one is "
                "there, choose the category, show me exactly what would be posted, and wait for my yes."))
            row.add_suffix(share)
            row.add_suffix(button("Improve", lambda path=path, title=title: ask(
                f"I want to improve my recipe \u201c{title}\u201d ({path}). Read it, then ask me what I want to change or add, "
                "and suggest what you think could be better (clearer steps, what it needs, how to check it, how to take it away, "
                "anything that did not work when I tried it). Change that file, keeping the form of a recipe, and tell me in "
                "plain words what changed. If it is also on the recipes site, tell me I can send the new version with "
                "Update, in the Recipes app."), suggested=True))
            row.add_suffix(button("Open", lambda path=path: open_file(path)))
            # (the switch is added first, so that it is the last on the right)
            self.delete_button(row, path, title, name)
            self.mine_group.add(row)
            self.mine_rows.setdefault(title.strip().lower(), (row, share, update))
        mine_page.add(self.mine_group)
        self.mine_bin.set_child(mine_page)
        later(self.fetch_shared, self.show_shared)
        self.filter()

    def fetch_shared(self):
        import mentor_hub
        return mentor_hub.mine(mentor_hub.get_index())

    def show_shared(self, result):
        """Mark the user's recipes that are on the site, in the same list. One that is on the site but
        no longer on this computer gets a row of its own."""
        if isinstance(result, Exception) or not result:
            return
        for entry in result:
            rid, title = entry["id"], entry.get("title") or entry["id"]
            votes = f"{entry.get('up', 0)} up, {entry.get('down', 0)} down" if (entry.get("up") or entry.get("down")) else "not rated yet"
            said = "On the site, " + votes + (", updated " + entry["updated"] if entry.get("updated") else "")
            found = self.mine_rows.get(title.strip().lower())
            if found:
                row, share, update = found
                row.set_subtitle(GLib.markup_escape_text(f"{row.day} \u00b7 {said}"))
                share.set_visible(False)
                row.shared = True
            else:
                setup = entry.get("setup") or {}
                made = ", ".join(x for x in (f"GNOME {setup['gnome']}" if setup.get("gnome") else "",
                                             f"kernel {setup['kernel']}" if setup.get("kernel") else "") if x)
                rows = [(k, v) for k, v in (("Made on", made), ("Written by", entry.get("model") or ""),
                                            ("Category", entry.get("category") or "")) if v]
                row = self.recipe_row(title, said + " (not on this computer)", entry.get("summary") or "", rows, rid)
                update = button("Update", lambda: None)
                row.add_suffix(update)
                if self.mine_none is not None:
                    self.mine_group.remove(self.mine_none)
                    self.mine_none = None
                self.mine_group.add(row)
            update.set_visible(True)
            update.add_css_class("suggested-action")
            update.connect("clicked", lambda _b, rid=rid, title=title, row=row: self.update(rid, title, row))
            remove = Gtk.Button(label="Remove it from the site")
            remove.add_css_class("destructive-action")
            remove.connect("clicked", lambda _b, rid=rid, title=title, row=row: self.withdraw(rid, title, row))
            row.actions.append(remove)
            row.actions.set_visible(True)
        self.filter()

    def recipe_switch(self, on, title, path, key, row):
        """On: what the recipe built is in use on this computer. Off: switched off, with every file kept, so that
        On brings it back in a moment; removing for good is another request ("Take it away again"). A recipe that
        only added a GNOME Shell extension is switched here, at once, without the assistant: the extension is
        turned off or on (mentor_recipes.only_extension). Any other goes to the assistant, with the usual preview
        and the password where one is needed. The switch shows what was last done, not what is asked."""
        switch = Gtk.Switch(active=on, valign=Gtk.Align.CENTER,
                            tooltip_text="On: in use on this computer. Off: switched off, its files kept")
        uuid = mentor_recipes.only_extension(path)
        state = {"on": on}

        def direct(wanted):
            """Turn the recipe's extension off or on here, and note it as the assistant would (recipe_used)."""
            import mentor_tools
            code, out = mentor_tools.extension_set({"uuid": uuid, "enabled": wanted})
            if code == 0:
                mentor_tools.recipe_used({("put_back" if wanted else "taken_away"): key})
            return code, out

        def done(result, wanted):
            switch.set_sensitive(True)
            code, out = (1, str(result)) if isinstance(result, Exception) else result
            if code == 0:
                state["on"] = wanted
                row.set_subtitle("Switched on" + (": it shows after you log out and back in" if "log" in out else "")
                                 if wanted else "Switched off, its files kept")
            else:
                switch.set_active(state["on"])  # as it was: nothing changed
                row.set_subtitle("It could not be switched: " + out.strip()[:90])

        def flipped(widget, _param):
            if widget.get_active() == state["on"]:
                return
            if not widget.get_active():
                # Off asks first (the user's wish, 2026-10-16); on does not.
                dialog = Adw.AlertDialog(heading=f"Switch off “{title}”?",
                                         body="It stops working until you switch it on again here. Nothing is deleted.")
                dialog.add_response("cancel", "Cancel")
                dialog.add_response("off", "Switch off")
                dialog.set_default_response("cancel")
                dialog.set_close_response("cancel")

                def answered(_dialog, response):
                    if response == "off":
                        go(widget)
                    else:
                        widget.set_active(state["on"])  # as it was; flipped sees no change
                dialog.connect("response", answered)
                dialog.present(row.get_root())
                return
            go(widget)

        def go(widget):
            switch.set_sensitive(False)
            if uuid:
                wanted = widget.get_active()
                threading.Thread(target=lambda: GLib.idle_add(
                    lambda result=self.attempt(direct, wanted): done(result, wanted) and False), daemon=True).start()
                return
            if widget.get_active():
                row.set_subtitle("Mentor is putting it back, in the chat")
                ask(f"Switch the recipe \u201c{title}\u201d back on. Its file is {path}. It was switched off, not removed: "
                    "turn on again what was turned off (enable the extension, start the service, set the setting back). "
                    "Only if something it needs is gone, apply that part of its steps again, with a preview first. Keep "
                    "it short: do not search the system or read Mentor's own files for this. Tell me in one or two "
                    f"sentences what you switched on, then call recipe_used with put_back set to {key}.")
            else:
                row.set_subtitle("Mentor is switching it off, in the chat")
                ask(f"Switch the recipe \u201c{title}\u201d off. Its file is {path}. Switching off is not removing: turn off "
                    "what it added (disable the extension, stop the service, set the setting back) and keep every file, "
                    "so that it can be switched on again in a moment. Do not delete anything. If it cannot be switched "
                    "off without removing it, tell me so and ask first. Keep it short: do not search the system or read "
                    "Mentor's own files for this. Tell me in one or two sentences what you switched off, then call "
                    f"recipe_used with taken_away set to {key}.")
        switch.connect("notify::active", flipped)
        return switch

    @staticmethod
    def attempt(work, *args):
        try:
            return work(*args)
        except Exception as e:
            return e

    def improve_copy(self, path, title, rid, row):
        """Someone else's recipe, made better: a copy of it among the user's own (Mine), which says what it
        was made from, handed to the assistant to improve. Shared, it goes on the site as a version of
        the original, never in its place."""
        def work():
            import mentor_hub
            based = rid
            if not based:
                try:
                    listed = mentor_hub.on_hub(mentor_recipes.sha_of(path))
                    based = listed["id"] if listed else ""
                except Exception:
                    based = ""
            return mentor_recipes.fork(path, based), based

        def done(result):
            if isinstance(result, Exception):
                row.set_subtitle("It could not be copied: " + str(result)[:80])
                return
            copy, based = result
            row.set_subtitle("Your own version is in Mine; Mentor has it in the chat")
            ask(f"I want to improve the recipe \u201c{title}\u201d. My own copy of it is {copy}" +
                (f", made from the recipe {based} on the recipes site" if based else "") + ". The original is not mine: "
                "before anything else, inspect my copy with recipe_inspect and tell me, briefly, if anything in it is a "
                "problem. Then ask me what I want to change or add, suggest what you think could be better (clearer steps, "
                "what it needs, how to check it, how to take it away, anything that did not work for me), and change my "
                "copy, keeping the form of a recipe and its \"Based on\" row. Tell me in plain words what changed. If I "
                "want to share it, it goes on the site as a version of the original (recipe_share, as RECIPES.md says).")
            self.rebuild()
        later(work, done)

    def update(self, rid, title, row):
        """The published text comes here, to a file of the user's, and goes to the assistant, who asks what
        to improve. It is sent back to the site only after the user has seen the new text and said yes."""
        def done(result):
            if isinstance(result, Exception):
                row.set_subtitle("The recipe could not be downloaded just now. Try again later.")
                return
            row.set_subtitle("Mentor has it now, in the chat")
            ask(f"I want to improve my recipe \u201c{title}\u201d, which is on the recipes site as {rid}. Its published text "
                f"is now in {result}. Read it, then ask me what I want to change or improve, and suggest what you think "
                "could be better (clearer steps, what it needs, how to take it away). Make the changes in that file. When "
                f"we are done, call recipe_update with id {rid} and that path: it shows what would be sent; send it only "
                "after I say yes.")

        import mentor_hub
        row.set_subtitle("Downloading\u2026")
        later(lambda: mentor_hub.own_copy(rid), done)

    def withdraw(self, rid, title, row):
        dialog = Adw.AlertDialog(heading="Remove it from the site?",
                                 body=f"\u201c{title}\u201d will no longer be on the recipes site. Your copy on this computer "
                                      "stays, and people who already downloaded it keep theirs.")
        dialog.add_response("cancel", "Keep it")
        dialog.add_response("remove", "Remove")
        dialog.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")

        def answered(_dialog, response):
            if response != "remove":
                return
            import mentor_hub

            def done(result):
                row.set_subtitle("It could not be sent just now. Try again later." if isinstance(result, Exception)
                                 else "Removal sent: it is gone from the site within minutes")
            row.set_subtitle("Sending\u2026")
            later(lambda: mentor_hub.withdraw(rid), done)
        dialog.connect("response", answered)
        dialog.present(self)

    def delete_button(self, row, path, title, name=None):
        """Delete, inside the opened row: the recipe's file is erased from this computer, after a question.
        name: the file name of one of the user's own recipes (FOLDER), whose switched-off mark goes with it."""
        delete = Gtk.Button(label="Delete")
        delete.add_css_class("destructive-action")
        delete.connect("clicked", lambda *_: self.delete(row, path, title, name))
        row.actions.prepend(delete)
        row.actions.set_visible(True)

    def delete(self, row, path, title, name):
        """Ask, then erase the file for good (not to the trash: the user asked for it gone, 2026-10-17).
        What the recipe built is not touched: that is switching off, or "Take it away again"."""
        switch = getattr(row, "switch", None)
        body = f"“{title}” will be erased from this computer. This cannot be undone."
        if switch is not None and switch.get_active():
            body += (" It is still switched on: what it set up stays, and Mentor will no longer have its steps to take "
                     "it away. Switch it off first if you do not want to keep what it set up.")
        if getattr(row, "shared", False):
            body += " It stays on the recipes site; “Remove it from the site” takes it off there."
        dialog = Adw.AlertDialog(heading="Delete this recipe?", body=body)
        dialog.add_response("cancel", "Keep it")
        dialog.add_response("delete", "Delete")
        dialog.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")

        def answered(_dialog, response):
            if response != "delete":
                return
            try:
                os.remove(path)
            except FileNotFoundError:
                pass
            except OSError as e:
                row.set_subtitle("It could not be deleted: " + (e.strerror or str(e)))
                return
            if name:
                mentor_recipes.off_set(name, False)
            self.rebuild()
        dialog.connect("response", answered)
        dialog.present(self)

    def say(self, row, entry):
        said = {"up": "you said it worked", "down": "you said it did not work"}.get(entry.get("vote"), "not rated yet")
        row.set_subtitle(f"Used {day(entry.get('applied'))}, " + ("switched off" if entry.get("undone") else said))

    def rate(self, rid, vote, row):
        def send():
            import mentor_hub
            entry = mentor_recipes.used_load().get(rid, {})
            mentor_hub.rate(rid, entry.get("sha", ""), vote)
            mentor_recipes.used_vote(rid, vote)
            return mentor_recipes.used_load().get(rid, {})

        def done(result):
            if isinstance(result, Exception):
                row.set_subtitle("It could not be sent just now. Try again later.")
            else:
                self.say(row, result)
        row.set_subtitle("Sending…")
        later(send, done)


class RecipesApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.mentor.Recipes", flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.window = None

    def do_command_line(self, _command_line):
        if self.window is None:
            self.window = RecipesWindow(self)
        self.window.present()
        return 0


sys.exit(RecipesApp().run(sys.argv))
