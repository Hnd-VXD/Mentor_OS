p.add_argument("tool")
p.add_argument("arguments", nargs="?", default="{}")
p.set_defaults(func=cmd_call)
p = sub.add_parser("connect", help="register the tools with an agent CLI")
p.add_argument("agent", choices=sorted(CONNECT))
p.set_defaults(func=cmd_connect)
