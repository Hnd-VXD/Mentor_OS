p.add_argument("--json", action="store_true", help="as data")
p.set_defaults(func=lambda args: print(json.dumps(__import__("mentor_report").report(args.days), indent=2, ensure_ascii=False)
                                       if args.json else __import__("mentor_report").text(__import__("mentor_report").report(args.days))))
p = sub.add_parser("screenshot", help="take a picture of the screen (or of the window in front) and open it in Gradia")
