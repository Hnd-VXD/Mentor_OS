#!/usr/bin/python3
"""Command line front end of the Mentor agent layer: try tools by hand, connect an agent, read the audit log."""
import argparse
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, "/usr/local/lib/mentor")
import mentor_core
import mentor_tools

MCP_SERVER = "/usr/local/bin/mentor-mcp"
ACCEPTED = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "mentor", "verify-accepted.json")
SOURCE = "/etc/mentor/source"  # every file of Mentor's as it was built, and a list of what each should contain
CONNECT = {
    "claude": ["claude", "mcp", "add", "--scope", "user", "mentor", "--", MCP_SERVER],
    "codex": ["codex", "mcp", "add", "mentor", "--", MCP_SERVER],
    "gemini": ["agy", "mcp", "add", "mentor", MCP_SERVER],  # Google's Antigravity CLI
}


def cmd_tools(args):
    for name, (description, schema, _) in mentor_tools.TOOLS.items():
        params = ", ".join(schema["properties"]) or "-"
        print(f"{name}\n    {description}\n    arguments: {params}")


def cmd_call(args):
    try:
        arguments = json.loads(args.arguments)
    except ValueError as e:
        sys.exit(f"arguments must be JSON: {e}")
    ok, text = mentor_tools.call(args.tool, arguments)
    print(text)
    sys.exit(0 if ok else 1)


def cmd_connect(args):
    argv = CONNECT[args.agent]
    try:
        sys.exit(subprocess.run(argv).returncode)
    except FileNotFoundError:
        sys.exit(f"'{argv[0]}' is not installed. Install it, then run this again.\n"
                 f"Any other MCP-capable agent works too: register the stdio server {MCP_SERVER}")


def cmd_check_files(args):
    """The weekly check of the system's program files (SECURITY.md, "Unusual programs"), when the user agrees."""
    import mentor_guard
    print("Comparing every installed program with what its package installed. This takes a few minutes…", flush=True)
    changed, new, packages, first = mentor_guard.check_files()
    if not packages:
        print("The check could not run (pacman -Qkk gave nothing).")
        return 1
    if first:
        print(f"Checked the files of {packages} packages." + (
            f" {len(changed)} differ from what was installed; this was the first check, so they are noted as "
            "they are, and only what changes from now on will count:\n" + "\n".join(changed[:40])
            if changed else " Every one is as it was installed."))
        return 0
    if new:
        print(f"Checked the files of {packages} packages. CHANGED since the last check ({len(new)}):")
        for path in new[:40]:
            print(f"  {path}  (package: {mentor_guard._package(path) or '?'})")
        print("An update in progress, a repair by hand, or a harmful program can do this: `pacman -Qkk PACKAGE`, "
              "the journal and /var/log/pacman.log say more.")
        return 3
    print(f"Checked the files of {packages} packages: every one is as it was installed"
          + (f" (or as at the last check: {len(changed)} differed already then)." if changed else "."))
    return 0


def run_tool(name, arguments):
    ok, text = mentor_tools.call(name, arguments)
    if not ok:
        sys.exit(text)
    print(text)


def _supported_scales(size):
    """The scales the shell allows for the screen's mode of this size ("2880x1659"), as it gives them
    (1.3333333730697632, not 1.33: it takes back only its own numbers). [] when it cannot be asked."""
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        state = bus.call_sync("org.gnome.Mutter.DisplayConfig", "/org/gnome/Mutter/DisplayConfig",
                              "org.gnome.Mutter.DisplayConfig", "GetCurrentState", None, None,
                              Gio.DBusCallFlags.NONE, 5000, None).unpack()
    except Exception:
        return []
    for monitor in state[1]:
        for mode_id, width, height, _rate, _preferred, scales, props in monitor[1]:
            if (size and f"{width}x{height}" == size) or (not size and props.get("is-current")):
                return sorted(set(scales))
    return []


def cmd_keyring(args):
    """Make the "login" keyring open by itself again: give it no password. It gets one when the user
    types their password at the login screen (after a log out) on a system built before that was
    turned off (customize.sh); from then on every start asks for it. The user types the password
    here, once. What is kept in the keyring stays."""
    import getpass
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    def call(path, interface, method, value, reply):
        return bus.call_sync("org.freedesktop.secrets", path, interface, method, value, GLib.VariantType(reply),
                             Gio.DBusCallFlags.NONE, 30000, None).unpack()

    path = "/org/freedesktop/secrets/collection/login"
    try:
        locked = bus.call_sync("org.freedesktop.secrets", path, "org.freedesktop.DBus.Properties", "Get",
                               GLib.Variant("(ss)", ("org.freedesktop.Secret.Collection", "Locked")),
                               GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 10000, None).unpack()[0]
    except GLib.Error as e:
        sys.exit(f"The keyring cannot be reached: {e.message}")
    keyring = os.path.expanduser("~/.local/share/keyrings/login.keyring")
    try:
        with open(keyring, "rb") as f:
            plain = f.read(9) == b"[keyring]"
    except OSError:
        plain = False
    _out, session = call("/org/freedesktop/secrets", "org.freedesktop.Secret.Service", "OpenSession",
                         GLib.Variant("(sv)", ("plain", GLib.Variant("s", ""))), "(vo)")

    def secret(text):
        return (session, b"", text.encode(), "text/plain")
    if plain:
        if locked:  # no password, but not opened in this session: opened now
            try:
                bus.call_sync("org.freedesktop.secrets", "/org/freedesktop/secrets",
                              "org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface", "UnlockWithMasterPassword",
                              GLib.Variant("(o(oayays))", (path, secret(""))), None, Gio.DBusCallFlags.NONE, 30000, None)
            except GLib.Error:
                pass
        print("The login keyring has no password already: it opens by itself.")
        return
    password = getpass.getpass("Your password (the one you log in with; it is not shown): ")
    try:
        bus.call_sync("org.freedesktop.secrets", "/org/freedesktop/secrets",
                      "org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface", "ChangeWithMasterPassword",
                      GLib.Variant("(o(oayays)(oayays))", (path, secret(password), secret(""))),
                      None, Gio.DBusCallFlags.NONE, 30000, None)
    except GLib.Error as e:
        sys.exit("That did not work: the password is not the keyring's (" + e.message.split(":")[-1].strip() + "). Nothing was changed.")
    try:  # and open now, for this session too: the chat waits for it (mentor-chat, show_keyring)
        bus.call_sync("org.freedesktop.secrets", "/org/freedesktop/secrets",
                      "org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface", "UnlockWithMasterPassword",
                      GLib.Variant("(o(oayays))", (path, secret(""))), None, Gio.DBusCallFlags.NONE, 30000, None)
    except GLib.Error:
        pass  # it opens by itself at the next start anyway
    print("Done. The login keyring opens by itself again, and what was in it is kept.")


def cmd_scale(args):
    """Scale the desktop the way the host's screen is scaled, so that it is drawn sharp.

    The launcher says how much (it reaches /run/mentor/host-scale, see mentor_boot.py). The
    shell goes back to its own idea of the scale whenever the window, and with it the
    resolution, changes, so the mentor extension runs this again each time. What is set is
    kept (monitors.xml), so the next start in a window of the same size begins with it and
    nothing has to change in front of the user. Does nothing where no launcher said anything.

    The shell asks the user whether to keep a display setting that is to last. With --keep,
    which the extension passes, that question is the extension's to answer: it is told so
    through /run/mentor/scale-kept. Without it the setting is for this session only.
    """
    import glob
    import re
    try:
        with open("/run/mentor/host-scale") as f:
            wanted = float(f.read())
    except (OSError, ValueError):
        return
    # A scale the user chose in Settings goes before the host's (the extension notes it).
    try:
        with open(os.path.expanduser("~/.config/mentor/scale")) as f:
            wanted = float(f.read())
    except (OSError, ValueError):
        pass
    shown = subprocess.run(["gdctl", "show"], capture_output=True, text=True,
                           env={**os.environ, "LC_ALL": "C.UTF-8", "LANGUAGE": ""}).stdout  # read in English
    monitor, scale = re.search(r"Monitor (\S+)", shown), re.search(r"Scale: ([\d.]+)", shown)
    current = re.search(r"Current mode\s*\n\W*(\d+x\d+)@", shown)
    if not monitor or not scale:
        return
    # What is kept names a resolution too. When that is one the screen always offers, the
    # shell holds on to it in a window of another size: back to the one the window asks
    # for, which the kernel lists first.
    mode = []
    for path in glob.glob(f"/sys/class/drm/card*-{monitor.group(1)}/modes"):
        try:
            with open(path) as f:
                asked = f.readline().strip()
        except OSError:
            continue
        if asked and current and asked != current.group(1):
            modes = subprocess.run(["gdctl", "show", "--modes"], capture_output=True, text=True).stdout
            if found := re.search(rf"\b{re.escape(asked)}@[\d.]+", modes):
                mode = ["--mode", found.group(0)]
    # Not every scale fits every resolution (2 does not fit an odd height, as when the window is
    # maximized at 2880x1659): the shell says which ones the mode takes. The largest of them that
    # is not more than wanted is used, so a maximized window on a 200% screen gets 150%, not 100%.
    # Without that list: the wanted one, then the nearest whole one.
    target = mode[1].split("@")[0] if mode else (current.group(1) if current else "")
    allowed = _supported_scales(target)
    if allowed:
        # quarter steps first (125%, 150%...), as Settings offers them: thirds draw text less sharp
        allowed = [s for s in allowed if abs(s * 4 - round(s * 4)) < 0.01] or allowed
        fits = [s for s in allowed if s <= wanted + 0.01]
        candidates = [max(fits) if fits else min(allowed, key=lambda s: abs(s - wanted))]
    else:
        candidates = list(dict.fromkeys((wanted, float(round(wanted)))))
    for candidate in candidates:
        if not mode and abs(float(scale.group(1)) - candidate) < 0.01:
            return
        keep = []
        if args.keep:
            keep = ["--persistent"]
            open("/run/mentor/scale-kept", "w").close()
        if subprocess.run(["gdctl", "set", *keep, "--logical-monitor", "--primary",
                           "--monitor", monitor.group(1), *mode, "--scale", repr(candidate)],
                          capture_output=True).returncode == 0:
            return

# Tries "Ask Mentor…" in Files the way Files uses it (cmd_doctor): prints ok, or exits with why not.
FILES_PROBE = r"""
import glob, importlib.util, os, re, sys
import gi
found = sorted((tuple(int(n) for n in re.findall(r"\d+", v)), v) for v in
               (re.search(r"Nautilus-([\d.]+)\.typelib$", p).group(1)
                for p in glob.glob("/usr/lib/girepository-1.0/Nautilus-*.typelib")))
if not found:
    sys.exit("Files offers no interface for add-ons any more (no Nautilus typelib)")
gi.require_version("Nautilus", found[-1][1])
from gi.repository import Gio, Nautilus
for name, wanted in (("get_file_items", 1), ("get_background_items", 1)):
    method = getattr(Nautilus.MenuProvider, name, None)
    if method is None or len(method.get_arguments()) != wanted:
        sys.exit(f"Files {found[-1][1]} asks add-ons for their menu items in a new way ({name})")
spec = importlib.util.spec_from_file_location("mentor_files", "/usr/share/nautilus-python/extensions/mentor.py")
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)

class Place:
    def get_location(self):
        return Gio.File.new_for_path("/tmp")

ask = module.AskMentor()
labels = [item.props.label for item in ask.get_file_items([Place()]) + ask.get_background_items(Place())]
if len(labels) != 2 or not all(label.startswith("Ask Mentor") for label in labels):
    sys.exit(f"the add-on gives no menu item ({labels})")
print("ok")
"""


def cmd_doctor(args):
    """Say which parts of Mentor's desktop work right now (they are described in /etc/mentor/DESKTOP.md)."""
    import re
    extension = "mentor@mentor.local"
    lines, bad = [], 0

    def out(*argv):
        try:  # in English whatever language the desktop is in: "State:" is read below, not "Κατάσταση:"
            return subprocess.run(argv, capture_output=True, text=True, timeout=20,
                                  env={**os.environ, "LC_ALL": "C.UTF-8", "LANGUAGE": ""}).stdout
        except (OSError, subprocess.TimeoutExpired):
            return ""

    def say(ok, what, detail="", minor=False):
        """A part that does not work is BROKEN; a minor one (a menu item missing) is WARN."""
        nonlocal bad
        bad += not ok
        mark = "ok    " if ok else "WARN  " if minor else "BROKEN"
        lines.append(f"{mark} {what}" + (f": {detail}" if detail else ""))

    shell = (re.search(r"[\d.]+", out("gnome-shell", "--version")) or [""])[0]
    try:
        with open(f"/usr/share/gnome-shell/extensions/{extension}/metadata.json") as f:
            made_for = json.load(f).get("shell-version", [])
    except (OSError, ValueError):
        made_for = []
    say(shell.split(".")[0] in made_for, "GNOME Shell version",
        f"{shell or 'unknown'}; Mentor's extension is made for {', '.join(made_for) or 'none'}")
    info = out("gnome-extensions", "info", extension)
    state = (re.search(r"State: *(\S+)", info) or ["", "not found"])[1]
    say(state in ("ACTIVE", "ENABLED"), "Mentor's extension", state)
    status = out("gdbus", "call", "--session", "--dest", "org.gnome.Shell", "--object-path", "/org/mentor/Shell",
                 "--method", "org.mentor.Shell.Status")
    try:
        report = json.loads(re.search(r"\{.*\}", status.replace("\\\"", "\"").replace("\\'", "'")).group(0))
    except (AttributeError, ValueError):
        report = None
    if report is None:
        say(False, "the extension's own report", "it does not answer (an extension from before it could, or not loaded)")
    else:
        for part, how in report.get("parts", {}).items():
            say(how == "ok", f"part: {part}", "" if how == "ok" else how)
        say(bool(report.get("assistant_on_desktop")), "the assistant is the desktop")
        taskbar = "dash-to-panel@jderose9.github.com" in out("gsettings", "get", "org.gnome.shell", "enabled-extensions")
        if taskbar:
            say(report.get("taskbar_panels", 0) > 0, "the taskbar (Dash to Panel)",
                "" if report.get("taskbar_panels") else "enabled, but it has no panel")
        else:
            lines.append("-      the taskbar is switched off")
    say(os.path.exists("/run/mentor/desktop-ok"), "this start was reported as working")
    say(bool(out("pgrep", "-u", str(os.getuid()), "-f", "bin/mentor-chat").strip()), "the assistant is running")
    if os.path.exists("/dev/virtio-ports/org.mentor.clipboard"):
        say(bool(out("pgrep", "-u", str(os.getuid()), "-f", "lib/mentor/mentor-clipboard").strip()),
            "the clipboard shared with the host")
    else:  # no launcher on a host: nothing to share with (a PC of its own, another VM)
        lines.append("-      no host to share the clipboard with")
    watching = out("systemctl", "is-active", "mentor-sentinel").strip() == "active"
    say(watching, "the watch on freezes", "" if watching else "not running (/etc/mentor/FREEZES.md)", minor=True)
    key = out("systemctl", "is-active", "mentor-emergency-key").strip() == "active"
    say(key, "the emergency key (Ctrl+Alt+Backspace)", "" if key else "not running (/etc/mentor/FREEZES.md)", minor=True)
    # Updates of Mentor itself (UPDATES.md): the daily look, and the permission the Update button needs.
    looking = (out("systemctl", "is-enabled", "mentor-update-check.timer").strip() == "enabled"
               and out("systemctl", "is-active", "mentor-update-check.timer").strip() == "active")
    say(looking, "the daily look for Mentor updates",
        "" if looking else "mentor-update-check.timer is off: this Mentor gets no updates (/etc/mentor/UPDATES.md)", minor=True)
    try:
        recent = time.time() - os.path.getmtime("/var/log/mentor/updates.log") < 2 * 86400
    except OSError:
        recent = False
    if recent:
        say(True, "Mentor looked for an update in the last two days")
    else:
        # Not looked lately: ask for a look the way the Update button does (polkit rule 50-mentor-update.rules),
        # never with a password box. Allowed, it simply looks, which was due.
        asked = subprocess.run(["systemctl", "--no-ask-password", "start", "--no-block", "mentor-update-check.service"],
                               capture_output=True, text=True)
        say(asked.returncode == 0, "the Update button may install updates",
            "" if asked.returncode == 0 else "refused (" + (asked.stderr.strip().splitlines() or ["?"])[-1][:120]
            + "): /etc/polkit-1/rules.d/50-mentor-update.rules, UPDATES.md", minor=True)
    quiet = out("systemctl", "--user", "is-enabled", "mentor-taskbar-quiet.service").strip() == "enabled"
    say(quiet, 'no "Dash to Panel has been updated!" notice',
        "" if quiet else "mentor-taskbar-quiet.service is off (/etc/mentor/DESKTOP.md)", minor=True)
    # "Ask Mentor…" in Files, a Python add-on. When a new Files changes how add-ons work (Files 43
    # did), the item is simply gone, with no error anywhere: it is tried here as Files uses it.
    import glob
    if not glob.glob("/usr/lib/nautilus/extensions-*/libnautilus-python.so"):
        say(False, '"Ask Mentor…" in Files', "Files no longer loads Python add-ons (the nautilus-python package)", minor=True)
    else:
        try:
            probe = subprocess.run([sys.executable, "-W", "ignore", "-c", FILES_PROBE], capture_output=True,
                                   text=True, timeout=30)
            why = probe.stdout.strip() if probe.returncode == 0 else (probe.stderr.strip().splitlines() or ["it failed"])[-1]
        except (OSError, subprocess.TimeoutExpired):
            why = "the check did not finish"
        say(why == "ok", '"Ask Mentor…" in Files', "" if why == "ok" else why[:200], minor=True)
    errors = [line for line in out("journalctl", "-b", "--no-pager", "-o", "cat", "_COMM=gnome-shell").splitlines()
              if "mentor" in line.lower() and ("error" in line.lower() or "could not" in line)]
    say(not errors, "errors of Mentor's in the shell's log", errors[-1][:200] if errors else "")
    chat = out("journalctl", "-b", "--no-pager", "-o", "cat", f"_UID={os.getuid()}")
    # Each traceback up to its own last line, the error ("FileNotFoundError: …"): the lines before it
    # are indented. Not a fixed number of lines, which once named a journal line that came after.
    trace = re.findall(r"Traceback \(most recent call last\):\n((?:[ \t].*\n)*)(\S.*)", chat)
    trace = [error for where, error in trace if "mentor" in where]
    say(not trace, "errors of the assistant's", trace[-1][:200] if trace else "")
    print("\n".join(lines))
    print(f"\n{bad} thing(s) need attention. What each is and how to make it again: /etc/mentor/DESKTOP.md"
          if bad else "\nEverything of Mentor's desktop is in place.")
    sys.exit(1 if bad else 0)


def differing():
    """Mentor's own files that are gone or no longer what was built: [(path, how)], where how
    is "missing", "changed", "accepted" (changed, and said to be meant so: verify --accept),
    "root only" (a file the user may not read, such as a polkit rule: checked as root) or
    "cannot be read (why)"."""
    import hashlib
    found = []
    try:
        with open(os.path.join(SOURCE, "MANIFEST.sha256")) as f:
            lines = f.read().splitlines()
    except OSError:
        sys.exit(f"There is no list of Mentor's files at {SOURCE}: this system was built before there was one.")
    try:
        with open(ACCEPTED) as f:
            accepted = json.load(f)
    except (OSError, ValueError):
        accepted = {}
    for line in lines:
        wanted, _, path = line.partition("  ")
        try:
            with open(path, "rb") as f:
                now = hashlib.sha256(f.read()).hexdigest()
            if now != wanted:
                found.append((path, "accepted" if isinstance(accepted, dict) and accepted.get(path) == now else "changed", now))
        except FileNotFoundError:
            found.append((path, "missing", None))
        except PermissionError as e:
            found.append((path, "root only" if os.geteuid() else f"cannot be read ({e.strerror})", None))
        except OSError as e:
            found.append((path, f"cannot be read ({e.strerror})", None))
    return found


def cmd_screenshot(args):
    """The shell takes the picture at once (no overlay, no permission asked), into Pictures/Screenshots,
    and Gradia opens it to crop, draw on, copy or save. GNOME's own screenshot keys are off (00-mentor)."""
    import time
    folder = os.path.join(subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True, text=True).stdout.strip()
                          or os.path.expanduser("~/Pictures"), "Screenshots")
    os.makedirs(folder, exist_ok=True)
    path = os.path.join(folder, time.strftime("Screenshot from %Y-%m-%d %H-%M-%S.png"))
    method = "ScreenshotWindow" if args.window else "ScreenshotArea" if args.area else "Screenshot"
    done = subprocess.run(["gdbus", "call", "--session", "--dest", "org.gnome.Shell", "--object-path", "/org/mentor/Shell",
                           "--timeout", "600", "--method", f"org.mentor.Shell.{method}", path], capture_output=True, text=True)
    if args.area and done.returncode == 0 and "false" in done.stdout:
        return  # Esc: nothing taken, nothing opened
    if done.returncode or not os.path.isfile(path):
        sys.exit(f"the screenshot was not taken: {done.stderr.strip() or done.stdout.strip()}")
    if args.no_open:
        print(path)
        return
    # In a scope of its own, as GNOME starts apps: not ended with the key's command.
    subprocess.Popen(["systemd-run", "--user", "--scope", "--quiet", "--collect", "--", "gradia", path],
                     start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_capture_text(args):
    """Shift+Super+T: the text in an area the user drags out, onto the clipboard, with a short notification
    (as Omarchy's omarchy-capture-text, MIT; DESKTOP.md, Copy text from the screen)."""
    found = mentor_tools.capture_text("pick")

    def say(title, body=""):
        subprocess.run(["notify-send", "--app-name=Mentor", "--icon=edit-copy-symbolic", "--expire-time=4000",
                        title, body], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if found["state"] == "cancelled":
        return
    if found["state"] == "copied":
        first = " ".join(found["text"].split())
        say("Text copied", first if len(first) <= 90 else first[:89] + "…")
    elif found["state"] == "none":
        say("No text found", "Try a bigger area around the words.")
    else:
        say("The text could not be copied", "Ask Mentor what went wrong.")
        sys.exit(found.get("error") or "not copied")


def cmd_colors(args):
    """The window colors of Mentor Settings (mentor_colors.py; DESKTOP.md, "Window colors")."""
    import mentor_colors
    name = " ".join(args.name)
    if not name:
        now = mentor_colors.current() or "GNOME's own"
        for palette in mentor_colors.PALETTES + mentor_colors.ACCENT_PALETTES:
            name = mentor_colors.label(palette)
            kind = "accent" if mentor_colors.is_accent(palette) else "light" if palette[1] else "dark"
            print(f"{name:16} {kind}" + ("   (in use)" if name == now else ""))
        return
    palette = mentor_colors.apply(name)
    if palette is None:
        sys.exit(f"No window colors called {name!r}. They are: " + ", ".join(
            mentor_colors.label(p) for p in mentor_colors.PALETTES + mentor_colors.ACCENT_PALETTES))
    print(f"{mentor_colors.label(palette)} is in use. Programs that are open show it when they are opened again.")


def cmd_pointer(args):
    """The mouse pointer's color and size, as Mentor Settings sets them (mentor_pointer.py; DESKTOP.md, "Pointer")."""
    import mentor_pointer
    color, size = mentor_pointer.apply(args.color, args.size)
    print(f"The pointer is {color}, size {size}. Sizes: " + ", ".join(map(str, mentor_pointer.SIZES)))


def cmd_reminders(args):
    """The reminders that are set (TOOLS.md, Reminders); --fire is the reminder's own service."""
    if args.fire:
        mentor_tools.reminder_fire(args.fire)
    elif args.cancel:
        run_tool("reminder_cancel", {"id": args.cancel})
    else:
        run_tool("reminder_list", {})


def cmd_verify(args):
    """Compare every file Mentor added to the system with the copy kept from when it was built
    (/etc/mentor/source; see /etc/mentor/REBUILD.md)."""
    found = differing()
    unchecked = [path for path, how, _now in found if how == "root only"]
    found = [entry for entry in found if entry[1] != "root only"]
    if args.accept:
        # The changed files are as they are meant to be from now on (a part adapted to a new
        # GNOME, say). A file that changes again after this is reported again.
        os.makedirs(os.path.dirname(ACCEPTED), exist_ok=True)
        with open(ACCEPTED, "w") as f:
            json.dump({path: now for path, how, now in found if now}, f, indent=1)
        found = [(path, "accepted" if now else how, now) for path, how, now in found]
    for path, how, _now in found:
        print(f"{how:<8} {path}")
    wrong = [path for path, how, _now in found if how != "accepted"]
    if unchecked:
        print(f"({len(unchecked)} file(s) only root may read were not checked: sudo mentor verify)")
    if not found:
        print("Every file of Mentor's is as it was built.")
    elif not wrong:
        print(f"\n{len(found)} file(s) differ from what was built, and that was said to be meant so.")
    if not wrong:
        return
    print(f"\n{len(wrong)} file(s). To put one back as it was built: sudo mentor restore PATH   (all of them: --all).\n"
          f"When a file was changed on purpose and works, say so with: mentor verify --accept   (and write why in "
          f"~/.local/share/mentor/notes.md).\nWhat each file is: /etc/mentor/REBUILD.md")
    sys.exit(1)


def cmd_notice(args):
    """Tell the user something in the assistant's chat: a yellow card for a warning, a red one
    for a problem. For what the agent builds to speak with (see /etc/mentor/ASSISTANT.md)."""
    print(mentor_tools.leave_notice(args.level, args.title, args.text, args.prompt, update=args.update,
                                    action=args.action, quiet=args.quiet))


def cmd_update(args):
    """Which version of Mentor this is, and what the updater knows (/etc/mentor/UPDATES.md)."""
    sys.path.insert(0, "/usr/local/lib/mentor")
    import mentor_update  # only for the names: nothing here needs root
    version = mentor_update.installed_name() if mentor_update.installed_version() else \
        "unknown (made before Mentor had updates)"
    try:
        with open("/var/lib/mentor/updates/state.json") as f:
            state = json.load(f)
    except (OSError, ValueError):
        state = {}
    print(f"Mentor version: {version}")
    if state.get("installing"):
        print(f"Being tried: update {state['installing'].get('name') or state['installing']['version']} (installed {state['installing']['time']}; "
              "kept once a start with it reaches the desktop)")
    if state.get("offered"):
        try:
            with open("/var/lib/mentor/updates/update.json") as f:
                brings = json.load(f).get("summary", "")
        except (OSError, ValueError, AttributeError):
            brings = ""
        try:
            with open("/var/lib/mentor/updates/update.json") as f:
                waiting_name = mentor_update.display_name(state["offered"]["version"], json.load(f).get("name"))
        except (OSError, ValueError, AttributeError):
            waiting_name = mentor_update.display_name(state["offered"]["version"])
        print(f"Waiting for the user: update {waiting_name} (offered "
              f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(state['offered']['time']))})"
              + (f". What it brings: {brings}" if brings else ""))
    if state.get("installed"):
        print(f"Last installed: update {mentor_update.display_name(state['installed']['version'], state['installed'].get('name'))} "
              f"on {state['installed']['time']}")
    if state.get("failed"):
        print("Undone by a start that failed, not offered again: " + ", ".join(mentor_update.display_name(v) for v in state["failed"]))
    if state.get("declined_packages"):
        print("Packages the user removed, never put back by an update: " + ", ".join(state["declined_packages"]))
    if not state.get("offered") and not state.get("installing"):
        print("No update of Mentor is waiting: it has everything its maker has published.")
    print("Log: /var/log/mentor/updates.log. To look for an update now (as root): "
          "systemctl start mentor-update-check.service")


def cmd_restore(args):
    """Put files of Mentor's back as they were built. For the user, as root: the agent may not
    write most of them, and should not be the one to undo a change to its own rules."""
    import shutil
    if os.geteuid() != 0:
        sys.exit("Run it as root: sudo mentor restore " + ("--all" if args.all else " ".join(args.paths) or "PATH"))
    known = {path: how for path, how, _now in differing() if how != "accepted"}
    paths = list(known) if args.all else [os.path.abspath(path) for path in args.paths]
    if not paths:
        sys.exit("Nothing to restore." if args.all else "Name the files, or --all. mentor verify lists what differs.")
    for path in paths:
        kept = os.path.join(SOURCE, "rootfs", path.lstrip("/"))
        if not os.path.isfile(kept):
            print(f"not one of Mentor's files: {path}")
            continue
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.exists(path):  # what is there now is kept beside it, in case it was wanted
            shutil.copy2(path, path + ".before-restore")
        shutil.copy2(kept, path)  # with its mode
        os.chown(path, 0, 0)
        print(f"restored {path}")
    print("The assistant and the desktop take the restored files at the next login.")


def cmd_journal(args):
    """What the agent changed on this system, under the request it was for (/etc/mentor/JOURNAL.md)."""
    import mentor_journal
    found, left_out = mentor_journal.entries(" ".join(args.search), args.lines, args.all, args.since)
    if args.json:
        print("\n".join(json.dumps(entry, ensure_ascii=False) for entry in found))
    else:
        print(mentor_journal.readable(found, left_out))


def cmd_log(args):
    try:
        with open(mentor_core.AUDIT_PATH) as f:
            lines = f.readlines()[-args.lines:]
    except FileNotFoundError:
        lines = []
    for line in lines:
        r = json.loads(line)
        print(f"{r['time']}  {r['outcome']:<10} exit={r['exit_code']}  {r['action']} {json.dumps(r['args'])}")
    if not lines:
        print("No privileged actions recorded yet.")


