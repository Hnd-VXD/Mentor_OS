[Unit]
Description=Mentor: look the system over for things worth suggesting
Documentation=file:///usr/local/lib/mentor/mentor-advisor
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/mentor/mentor-advisor
# It is never in a hurry.
Nice=19
IOSchedulingClass=idle
# No limit from systemd: it counts the time Windows keeps the VM paused while the PC sleeps, and
# on 2026-10-17 a 30-minute sleep made a running advisor look hung ("failed", a yellow card).
# Every download and command inside has its own time limit. /etc/mentor/BOOT.md, "When Windows sleeps".
TimeoutStartSec=infinity
