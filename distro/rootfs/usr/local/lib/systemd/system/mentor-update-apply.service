[Unit]
Description=Mentor: install the update the user agreed to
Documentation=file:///etc/mentor/UPDATES.md
# Started from the update card in the chat (the polkit rule 50-mentor-update.rules lets the user do so).
# It only installs a package signed by Mentor's maker, and the system restarts at the end.

[Service]
Type=oneshot
ExecStart=/usr/local/lib/mentor/mentor-update apply
# No limit from systemd: it counts the time Windows keeps the VM paused while the PC sleeps, and
# on 2026-10-17 a 30-minute sleep made a running advisor look hung ("failed", a yellow card).
# Every download and command inside has its own time limit. /etc/mentor/BOOT.md, "When Windows sleeps".
TimeoutStartSec=infinity
