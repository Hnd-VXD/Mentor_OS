#!/usr/bin/python3
"""Guest half of the shared clipboard between Mentor and the host.

Talks to the launcher on the host over a virtio-serial port, one JSON object
per line. Text goes as {"text": "..."}. Copied files and folders go as a
stream, the same in both directions:

    {"files": id, "count": n, "bytes": total}
    {"dir": id, "name": "relative/path"}          for each folder
    {"file": id, "name": "relative/path", "size": n}
    {"chunk": id, "data": "<base64>"}             as many as the file needs
    {"files-end": id}                             or {"files-cancel": id}

and the receiving side saves them and puts the copies on its own clipboard, so
that a paste finds them there. {"files-refused": "why"} says a copy was too
large to send.

Runs on the X11 backend (Xwayland) on purpose: a Wayland client only sees the
clipboard while it has keyboard focus, an X11 client always does, and GNOME
mirrors the clipboard between the two.
"""
import base64
import json
import os
import select
import shutil
import subprocess
import sys
import threading
import time
import urllib.parse
import uuid

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk

PORT = "/dev/virtio-ports/org.mentor.clipboard"
OWNER = "/usr/local/lib/mentor/mentor-clipboard-files"
STAGING = os.path.join(GLib.get_user_cache_dir(), "mentor", "clipboard")
# The host's last picture as a file too, for as long as it is what the clipboard holds: GNOME fails
# to hand a large picture (over ~256 KB, an INCR transfer) from the X11 side on to Wayland programs,
# so the chat reads this file first.
HOST_PICTURE = os.path.join(GLib.get_user_cache_dir(), "mentor", "host-picture.png")
# The text last copied, on the host or here, as a file of the user's alone: the emergency console
# (a text console, outside the desktop and its clipboard) pastes it with Ctrl+V (mentor_repair.py).
CLIP_TEXT = os.path.join(GLib.get_user_cache_dir(), "mentor", "clipboard-text")


def keep_text(text):
    try:
        os.makedirs(os.path.dirname(CLIP_TEXT), exist_ok=True)
        fd = os.open(CLIP_TEXT + ".part", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(CLIP_TEXT + ".part", CLIP_TEXT)
    except OSError:
        pass
MAX_BYTES = 1 << 20            # of text
MAX_IMAGE = 32 << 20           # of a picture from the host (a PNG, sent as base64)
MAX_FILE_BYTES = 256 << 20     # of files in one copy
MAX_FILE_COUNT = 2000
CHUNK = 48 * 1024
POLL_MS = 50


class Bridge:
    def __init__(self):
        self.fd = os.open(PORT, os.O_RDWR | os.O_NONBLOCK)
        self.pending = bytearray()
        self.hurrying = False   # a read of the rest of a long line is due
        self.synced = None     # the text both sides already agree on
        self.received = []      # the files last brought over from the host, as they sit here
        self.incoming = None    # a transfer from the host under way: {"id", "dir", "file", "tops"}
        self.owner = None       # the process keeping received files on the clipboard
        self.picture_set = 0.0  # when the host's picture was put on the clipboard (monotonic)
        self.sending = 0        # counts copies; a newer one stops the transfer of an older
        self.write_lock = threading.Lock()
        shutil.rmtree(STAGING, ignore_errors=True)
        self.clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        self.clipboard.connect("owner-change", self.on_owner_change)
        # A timer instead of an fd watch: the port reports HUP for as long as
        # nothing is connected on the host, which would spin the main loop.
        GLib.timeout_add(POLL_MS, self.read_host)

    # --- to the host ---------------------------------------------------------------

    def write(self, message, patience=10.0):
        """Send one message. False when the host is not taking it."""
        data = json.dumps(message).encode() + b"\n"
        with self.write_lock:
            while data:
                try:
                    data = data[os.write(self.fd, data):]
                except BlockingIOError:
                    if not select.select([], [self.fd], [], patience)[1]:
                        return False
                except OSError:
                    return False
        return True

    def on_owner_change(self, clipboard, event):
        clipboard.request_targets(self.on_targets)
        clipboard.request_uris(self.on_uris)

    def on_targets(self, clipboard, targets, *_count):
        """Something else copied: the host's picture is old news. Its own change (just after
        set_image, with a picture) is the only one that keeps it."""
        own = time.monotonic() - self.picture_set < 2.0
        if not (own and any(target.name().startswith("image/") for target in targets or [])):
            try:
                os.remove(HOST_PICTURE)
            except OSError:
                pass

    def on_uris(self, clipboard, uris):
        paths = [urllib.parse.unquote(u[7:]) for u in uris or [] if u.startswith("file://")]
        if not paths:
            clipboard.request_text(self.on_text)
        elif sorted(paths) != sorted(self.received):  # not the ones that just came from the host
            self.sending += 1
            threading.Thread(target=self.send_files, args=(paths, self.sending), daemon=True).start()

    def on_text(self, clipboard, text):
        if not text or text == self.synced:
            return
        if len(text.encode()) > MAX_BYTES:
            return
        self.synced = text
        keep_text(text)
        self.write({"text": text}, patience=0.5)

    def send_files(self, paths, mine):
        entries, total = [], 0  # (path on disk, name for the other side, is a folder)
        for top in paths:
            base = os.path.dirname(top.rstrip("/"))
            if os.path.isdir(top):
                for folder, _, names in os.walk(top):
                    entries.append((folder, os.path.relpath(folder, base), True))
                    entries += [(os.path.join(folder, n), os.path.relpath(os.path.join(folder, n), base), False) for n in names]
            elif os.path.isfile(top):
                entries.append((top, os.path.basename(top), False))
        entries = [e for e in entries if e[2] or os.path.isfile(e[0])]
        try:
            total = sum(os.path.getsize(path) for path, _, folder in entries if not folder)
        except OSError:
            return
        if not entries:
            return
        if total > MAX_FILE_BYTES or len(entries) > MAX_FILE_COUNT:
            self.notify("Too much to copy to Windows this way",
                        f"The clipboard carries up to {MAX_FILE_BYTES >> 20} MB and {MAX_FILE_COUNT} files at a time.")
            return
        ident = uuid.uuid4().hex[:12]
        if not self.write({"files": ident, "count": len(entries), "bytes": total}):
            return
        for path, name, folder in entries:
            if folder:
                ok = self.write({"dir": ident, "name": name})
            else:
                try:
                    with open(path, "rb") as f:
                        ok = self.write({"file": ident, "name": name, "size": os.path.getsize(path)})
                        while ok and (chunk := f.read(CHUNK)):
                            ok = mine == self.sending and self.write({"chunk": ident, "data": base64.b64encode(chunk).decode()})
                except OSError:
                    ok = False
            if not ok or mine != self.sending:
                self.write({"files-cancel": ident}, patience=1.0)
                return
        self.write({"files-end": ident})

    # --- from the host -------------------------------------------------------------

    @staticmethod
    def picture_menu(path, method="HostPictureMenu"):
        """The menu of what to do with a picture from Windows, where the pointer is (a smaller copy, save as JPG…;
        the user's wish, 2026-10-20), unless the user switched it off (mentor_settings picture_menu). Not waited for.
        HostPictureComing (no PATH): the launcher's word that one is coming, the menu up at once with its items
        waiting for it (the user's wish, 2026-10-22); HostPictureGone: none came, that menu closes."""
        try:
            sys.path.insert(0, "/usr/local/lib/mentor")
            import mentor_settings
            if not mentor_settings.get("picture_menu"):
                return
            Gio.bus_get_sync(Gio.BusType.SESSION, None).call(
                "org.gnome.Shell", "/org/mentor/Shell", "org.mentor.Shell", method,
                GLib.Variant("(s)", (path,)) if path else None, None, Gio.DBusCallFlags.NONE, 5000, None, None, None)
        except Exception as e:
            print(f"mentor-clipboard: picture menu: {e}", file=sys.stderr)

    @staticmethod
    def shell_picture(path):
        """The PNG at PATH onto the clipboard by the shell (the mentor extension's SetClipboardImage)."""
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            done = bus.call_sync("org.gnome.Shell", "/org/mentor/Shell", "org.mentor.Shell", "SetClipboardImage",
                                 GLib.Variant("(s)", (path,)), GLib.VariantType("(b)"),
                                 Gio.DBusCallFlags.NONE, 5000, None)
            return bool(done.unpack()[0])
        except GLib.Error:
            return False

    def read_host(self):
        # All that is there, up to 16 MB a time (the clipboard's own events wait meanwhile). The port hands
        # over 4 KB a read: reading 64 times a tick took a 2880 x 1646 snip (4.7 MB as base64) in over
        # some 25 ticks of 50 ms, and adding each piece to a bytes object copied all before it (2026-10-22).
        got, newline = 0, False
        while got < 16 << 20:
            try:
                chunk = os.read(self.fd, 1 << 16)
            except BlockingIOError:
                break
            if not chunk:
                break
            self.pending += chunk  # a bytearray: grows in place
            got += len(chunk)
            newline = newline or b"\n" in chunk
        if newline:
            *lines, rest = self.pending.split(b"\n")
            self.pending = bytearray(rest)
            for line in lines:
                try:
                    message = json.loads(line)
                    if isinstance(message, dict):
                        self.on_message(message)
                except (ValueError, KeyError, TypeError, OSError):
                    continue
        if len(self.pending) > 2 * MAX_IMAGE:  # a picture is one long line
            self.pending = bytearray()
        # A long line (a picture) coming in: the rest is read 5 ms on, not at the next tick.
        if got and self.pending and not self.hurrying:
            self.hurrying = True
            GLib.timeout_add(5, self.read_rest)
        return True

    def read_rest(self):
        self.hurrying = False
        self.read_host()
        return False

    def on_message(self, message):
        if "image-coming" in message:
            self.picture_menu(None, "HostPictureComing")
            return
        if "image-none" in message:
            self.picture_menu(None, "HostPictureGone")
            return
        if "image" in message:
            # A picture copied on the host (Windows' PrtScr / Snipping Tool): on this clipboard as
            # a picture, so that Ctrl+V pastes it anywhere (the chat attaches it). Not sent back.
            data = base64.b64decode(str(message["image"]), validate=False)
            # Only the PNG's signature and header are checked: decoding the whole picture first held the menu
            # back the longer the bigger it was (2026-10-22). It is decoded only for set_image, below.
            if not (0 < len(data) <= MAX_IMAGE and data[:8] == b"\x89PNG\r\n\x1a\n" and data[12:16] == b"IHDR"):
                return
            try:
                os.makedirs(os.path.dirname(HOST_PICTURE), exist_ok=True)
                with open(HOST_PICTURE + ".part", "wb") as f:
                    f.write(data)
                os.replace(HOST_PICTURE + ".part", HOST_PICTURE)
            except OSError:
                pass
            self.synced = None
            self.received = []
            self.picture_set = time.monotonic()
            # Through the shell, which hands it to every program: held here (X11), a large one never
            # reached Wayland programs, and Chromium's page hung waiting (2026-10-19). Here only when
            # the shell cannot (an older extension, no shell).
            if not self.shell_picture(HOST_PICTURE):
                loader = GdkPixbuf.PixbufLoader()
                try:
                    loader.write(data)
                    loader.close()
                except GLib.Error:
                    return
                if loader.get_pixbuf() is None:
                    return
                self.clipboard.set_image(loader.get_pixbuf())
                self.clipboard.store()
            self.picture_menu(HOST_PICTURE)
            return
        if "text" in message:
            text = message["text"]
            if isinstance(text, str) and text != self.synced:
                self.synced = text
                keep_text(text)  # first: the desktop's clipboard may be the part that is stuck
                self.clipboard.set_text(text, -1)
        elif "window-fullscreen" in message:
            # Not the clipboard's business, but this is the service that listens to the host
            # all the time: kept where the shell's Full Screen switch reads it.
            try:
                with open("/run/mentor/fullscreen", "w") as f:
                    f.write("1" if message["window-fullscreen"] else "0")
            except OSError:
                pass
        elif "files" in message:
            self.close_incoming(discard=True)
            shutil.rmtree(STAGING, ignore_errors=True)
            folder = os.path.join(STAGING, os.path.basename(str(message["files"])))
            os.makedirs(folder, mode=0o700)
            self.incoming = {"id": message["files"], "dir": folder, "file": None, "tops": []}
        elif "files-refused" in message:
            self.notify("Too much to copy from Windows this way", str(message["files-refused"]))
        elif self.incoming and message.get("dir") == self.incoming["id"]:
            os.makedirs(self.place(message["name"]), exist_ok=True)
        elif self.incoming and message.get("file") == self.incoming["id"]:
            if self.incoming["file"]:
                self.incoming["file"].close()
            path = self.place(message["name"])
            os.makedirs(os.path.dirname(path), exist_ok=True)
            self.incoming["file"] = open(path, "wb")
        elif self.incoming and message.get("chunk") == self.incoming["id"] and self.incoming["file"]:
            self.incoming["file"].write(base64.b64decode(message["data"]))
        elif self.incoming and message.get("files-cancel") == self.incoming["id"]:
            self.close_incoming(discard=True)
        elif self.incoming and message.get("files-end") == self.incoming["id"]:
            tops = self.incoming["tops"]
            self.close_incoming(discard=False)
            if tops:
                self.received = tops
                if self.owner:
                    self.owner.terminate()
                # A process of its own holds them on the clipboard; this one's toolkit cannot.
                self.owner = subprocess.Popen([OWNER, *tops], env={**os.environ, "GDK_BACKEND": "x11"})

    def place(self, name):
        """Where a file of that (relative) name goes; the first part of each is what gets pasted."""
        parts = [p for p in str(name).replace("\\", "/").split("/") if p not in ("", ".", "..")]
        if not parts:
            raise ValueError(name)
        top = os.path.join(self.incoming["dir"], parts[0])
        if top not in self.incoming["tops"]:
            self.incoming["tops"].append(top)
        return os.path.join(self.incoming["dir"], *parts)

    def close_incoming(self, discard):
        if not self.incoming:
            return
        if self.incoming["file"]:
            self.incoming["file"].close()
        if discard:
            shutil.rmtree(self.incoming["dir"], ignore_errors=True)
        self.incoming = None

    @staticmethod
    def notify(title, text):
        subprocess.Popen(["notify-send", "--app-name=Mentor", "--icon=org.mentor.Chat", title, text])


if not os.path.exists(PORT):
    # No launcher on a host (Mentor started on a PC of its own, or in another VM): there is no other
    # clipboard to share with. Nothing to do, and nothing wrong (etc/mentor/DESKTOP.md, "The shared clipboard").
    raise SystemExit(0)
Bridge()
Gtk.main()
