#!/usr/bin/python3
"""The assistant speaking first: look for things the user has to be told about.

Run from a user timer. The checks are plain commands, no model involved. What is found is
left for the assistant as a notice, which it shows in the chat as a card: yellow for a
warning, red for a problem, with a button that hands it to the agent. Nothing is done, and
no model is called, unless the user presses it. Each finding is raised at most once every
few days.

Among the checks is Mentor itself: whether its own files are all there and as they were
built (mentor verify), and whether the parts of its desktop work (mentor doctor); and the
user's safety (mentor_security.checks: the firewall, the first password, and more).
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time

sys.path.insert(0, "/usr/local/lib/mentor")
import mentor_security
import mentor_settings
import mentor_tools

DOCTOR_AGAIN = 30  # seconds before a part found broken is looked at again

STATE_PATH = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "mentor", "watch.json")
REMIND_AFTER = 3 * 24 * 3600
MENTOR = "/usr/local/bin/mentor"


def output(*argv, timeout=120):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def findings():
    """(key, level, title, text, request for the assistant), most urgent first."""
    # Mentor itself. A file that is gone, or changed without anyone saying it was meant
    # (mentor verify --accept), and a part of the desktop that does not work.
    wrong = re.findall(r"(?m)^(missing|changed|cannot be read.*?)\s+(/\S+)$", output(MENTOR, "verify"))
    if wrong:
        listed = "\n".join(f"{how}  {path}" for how, path in wrong[:12]) + ("\n…" if len(wrong) > 12 else "")
        yield ("verify:" + ",".join(sorted(path for _how, path in wrong)), "problem",
               "Some of Mentor's own files are missing or changed",
               listed,
               "`mentor verify` says these files of Mentor's own are missing or no longer what was built:\n\n"
               f"{listed}\n\nFollow /etc/mentor/REBUILD.md: find out for each whether it was changed on purpose "
               "(~/.local/share/mentor/notes.md) and works, or is damaged; tell me which, and what putting it back "
               "would take. The journal (journal_read) says what was changed lately and for which request. Do not "
               "change anything before I agree.")
    doctor = output(MENTOR, "doctor")
    broken = re.findall(r"(?m)^BROKEN\s+(.+)$", doctor)
    minor = re.findall(r"(?m)^WARN\s+(.+)$", doctor)
    if broken:
        # Looked at again a little later: a part caught in a moment of change (the assistant being
        # restarted by an update, the shell busy just after login) is not a broken part. On
        # 2026-10-14 such a moment gave a red card for a desktop that was fine seconds later.
        time.sleep(DOCTOR_AGAIN)
        still = set(re.findall(r"(?m)^BROKEN\s+(.+)$", output(MENTOR, "doctor")))
        broken = [line for line in broken if line in still]
    if broken:
        listed = "\n".join(broken[:10])
        yield ("doctor:" + ",".join(sorted(line.split(":")[0] for line in broken)), "problem",
               "Part of Mentor's desktop is not working",
               listed,
               f"`mentor doctor` reports these parts of Mentor's desktop as broken:\n\n{listed}\n\n"
               "Read the journal first (journal_read): a change made lately may be why. Then follow "
               "/etc/mentor/DESKTOP.md to find out why and mend them, one part at a time, in the sandbox "
               "first. Tell me what you found before you change anything.")
    if minor:  # a smaller part (a menu item of Mentor's that is gone): a yellow card
        listed = "\n".join(minor[:10])
        yield ("doctor-minor:" + ",".join(sorted(line.split(":")[0] for line in minor)), "warning",
               "A small part of Mentor stopped working",
               listed,
               f"`mentor doctor` warns about these parts of Mentor:\n\n{listed}\n\n"
               "Read the journal first (journal_read): a recent upgrade or change may be why. Then follow "
               "/etc/mentor/DESKTOP.md for that part (\"Ask Mentor…\" in Files: its row there), in the sandbox "
               "first. Tell me what you found before you change anything.")

    # The user's safety: the firewall, the first password, remote login, root without a password.
    for key, level, title, text, request in mentor_security.checks():
        yield ("security:" + key, level, title, text, request)

    usage = shutil.disk_usage("/")
    percent = round(100 * usage.used / usage.total)
    if percent >= 90:
        yield ("disk", "problem", "The disk is almost full",
               f"{percent}% of the system disk is used; {usage.free / 2**30:.1f} GB are free.",
               "The system disk is almost full. Find what takes the space and suggest what can be removed safely.")

    failed = [line.split()[0] for scope in ((), ("--user",))
              for line in output("systemctl", *scope, "--failed", "--no-legend", "--plain").splitlines() if line.split()]
    if failed:
        yield ("failed:" + ",".join(sorted(failed)), "warning", "Something on the system is not running",
               ", ".join(failed[:4]) + (" and more" if len(failed) > 4 else "") + " failed.",
               f"These systemd units failed: {', '.join(failed)}. Look in the journal (journal_read) for a change "
               "that touched them, find out why they failed and fix what can be fixed.")


def group(key):
    """Which of the user's switches (Mentor Settings, Warnings) a finding belongs to."""
    kind = key.split(":")[0]
    if kind in ("verify", "doctor", "doctor-minor"):
        return "self"
    if kind == "security":
        return "refused" if key.startswith("security:refused") else "security"
    return kind


def main():
    try:
        with open(STATE_PATH) as f:
            raised = json.load(f)
    except (OSError, ValueError):
        raised = {}
    now = time.time()
    off = set(mentor_settings.get("watch_off") or [])
    if mentor_settings.get("auto_review"):
        off.add("refused")  # the agent looks at those itself as they happen (mentor-firewall-watch)
    for key, level, title, text, request in findings():
        if now - raised.get(key, 0) < REMIND_AFTER or group(key) in off:
            continue
        raised[key] = now
        os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
        with open(STATE_PATH, "w") as f:
            json.dump(raised, f)
        mentor_tools.leave_notice(level, title, text, request)
        # The assistant shows it, and says so with a notification when it is covered. When it
        # is not running at all, that is the first thing the user has to know.
        if not output("pgrep", "-u", str(os.getuid()), "-f", "bin/mentor-chat").strip():
            output("notify-send", "--app-name=Mentor", "--icon=dialog-warning", title,
                   text + "\n\nThe assistant is not running. From a terminal: mentor repair", timeout=20)


main()
