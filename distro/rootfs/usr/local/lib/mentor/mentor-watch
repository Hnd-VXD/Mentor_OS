#!/usr/bin/python3
"""The assistant speaking first: look for things the user has to be told about.

Run from a user timer. The checks are plain commands, no model involved. What is found is
left for the assistant as a notice, which it shows in the chat as a card: yellow for a
warning, red for a problem, with a button that hands it to the agent. Nothing is done, and
no model is called, unless the user presses it. Each finding is raised at most once every
few days.

Among the checks is Mentor itself: whether its own files are all there and as they were
built (mentor verify), and whether the parts of its desktop work (mentor doctor); and the
user's safety (mentor_security.checks: the firewall, the first password, and more).
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time

sys.path.insert(0, "/usr/local/lib/mentor")
import mentor_security
import mentor_settings
import mentor_tools

DOCTOR_AGAIN = 30  # seconds before a part found broken is looked at again

STATE_PATH = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "mentor", "watch.json")
REMIND_AFTER = 3 * 24 * 3600
MENTOR = "/usr/local/bin/mentor"


def output(*argv, timeout=120):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def findings():
    """(key, level, title, text, request for the assistant), most urgent first."""
    # Mentor itself. A file that is gone, or changed without anyone saying it was meant
    # (mentor verify --accept), and a part of the desktop that does not work.
    wrong = re.findall(r"(?m)^(missing|changed|cannot be read.*?)\s+(/\S+)$", output(MENTOR, "verify"))
    if wrong:
        listed = "\n".join(f"{how}  {path}" for how, path in wrong[:12]) + ("\n…" if len(wrong) > 12 else "")
        yield ("verify:" + ",".join(sorted(path for _how, path in wrong)), "problem",
               "Some of Mentor's own files are missing or changed",
               listed,
               "`mentor verify` says these files of Mentor's own are missing or no longer what was built:\n\n"
               f"{listed}\n\nFollow /etc/mentor/REBUILD.md: find out for each whether it was changed on purpose "
               "(~/.local/share/mentor/notes.md) and works, or is damaged; tell me which, and what putting it back "
               "would take. The journal (journal_read) says what was changed lately and for which request. Do not "
               "change anything before I agree.")
    doctor = output(MENTOR, "doctor")
    broken = re.findall(r"(?m)^BROKEN\s+(.+)$", doctor)
    minor = re.findall(r"(?m)^WARN\s+(.+)$", doctor)
    if broken:
        # Looked at again a little later: a part caught in a moment of change (the assistant being
        # restarted by an update, the shell busy just after login) is not a broken part. On
        # 2026-10-14 such a moment gave a red card for a desktop that was fine seconds later.
        time.sleep(DOCTOR_AGAIN)
        still = set(re.findall(r"(?m)^BROKEN\s+(.+)$", output(MENTOR, "doctor")))
        broken = [line for line in broken if line in still]
    if broken:
        listed = "\n".join(broken[:10])
        yield ("doctor:" + ",".join(sorted(line.split(":")[0] for line in broken)), "problem",
               "Part of Mentor's desktop is not working",
               listed,
               f"`mentor doctor` reports these parts of Mentor's desktop as broken:\n\n{listed}\n\n"
               "Read the journal first (journal_read): a change made lately may be why. Then follow "
               "/etc/mentor/DESKTOP.md to find out why and mend them, one part at a time, in the sandbox "
               "first. Tell me what you found before you change anything.")
    if minor:  # a smaller part (a menu item of Mentor's that is gone): a yellow card
        listed = "\n".join(minor[:10])
        yield ("doctor-minor:" + ",".join(sorted(line.split(":")[0] for line in minor)), "warning",
               "A small part of Mentor stopped working",
               listed,
               f"`mentor doctor` warns about these parts of Mentor:\n\n{listed}\n\n"
               "Read the journal first (journal_read): a recent upgrade or change may be why. Then follow "
               "/etc/mentor/DESKTOP.md for that part (\"Ask Mentor…\" in Files: its row there), in the sandbox "
               "first. Tell me what you found before you change anything.")

    # The user's safety: the firewall, the first password, remote login, root without a password.
    for key, level, title, text, request in mentor_security.checks():
        yield ("security:" + key, level, title, text, request)

    # The weekly check of the system's program files, offered, not done: it runs when the user presses Check now
    # (the user's wish, 2026-10-20). One reminder a week; a green card.
    try:
        import mentor_guard
        if mentor_guard.check_due():
            yield ("filecheck:" + time.strftime("%Y-%W"), "idea", "Time for the weekly check of this system's programs",
                   "Mentor compares every installed program with what was installed, to see that none was replaced. "
                   "It takes a few minutes, and you can go on working.",
                   "Run the weekly check of the system's program files now: run_command `mentor check-files` (it takes "
                   "a few minutes; give it a timeout of 1800 seconds). Then tell me the result in one or two plain "
                   "sentences. If files CHANGED, follow /etc/mentor/SECURITY.md, \"Unusual programs\", to find out "
                   "why, and change nothing before I agree.")
    except Exception:
        pass

    usage = shutil.disk_usage("/")
    percent = round(100 * usage.used / usage.total)
    if percent >= 90:
        yield ("disk", "problem", "The disk is almost full",
               f"{percent}% of the system disk is used; {usage.free / 2**30:.1f} GB are free.",
               "The system disk is almost full. Find what takes the space and suggest what can be removed safely.")

    failed = [line.split()[0] for scope in ((), ("--user",))
              for line in output("systemctl", *scope, "--failed", "--no-legend", "--plain").splitlines() if line.split()]
    if failed:
        yield ("failed:" + ",".join(sorted(failed)), "warning", "Something on the system is not running",
               ", ".join(failed[:4]) + (" and more" if len(failed) > 4 else "") + " failed.",
               f"These systemd units failed: {', '.join(failed)}. Look in the journal (journal_read) for a change "
               "that touched them, find out why they failed and fix what can be fixed.")


def group(key):
    """Which of the user's switches (Mentor Settings, Warnings) a finding belongs to."""
    kind = key.split(":")[0]
    if kind in ("verify", "doctor", "doctor-minor"):
        return "self"
    if kind == "report":
        return "self"  # a part of Mentor's that stays broken: the "Mentor itself" warnings
    if kind == "filecheck":
        return "security"
    if kind == "security":
        return "refused" if key.startswith("security:refused") else "security"
    return kind


def guard_findings():
    """Only what the watch for unusual programs found (mentor-watch --guard, started as soon as it finds
    something: mentor-guard-notice.path)."""
    import mentor_guard
    for key, level, title, text, request in mentor_guard.findings():
        yield ("security:" + key, level, title, text, request)


NET_GATHER = 3          # seconds a run for programs going online waits, so that a burst of them is one card
NET_LOOK_EVERY = 120    # at most one look by itself at programs going online in this many seconds
NET_CARD_EVERY = 30     # after a card of programs going online, what comes next is gathered this long
SINCE_PATH = os.path.join(os.path.dirname(STATE_PATH), "watch-since.json")
REPORT_AFTER = 24 * 3600  # a part of Mentor's that stays broken this long is offered to the maker


def still_broken(found, now):
    """A part of Mentor's desktop that stays broken a day, mended or not: the instructions it is mended from are what
    is out of date (a new GNOME renamed something, say), and only an update can fix that for everyone. A card offers
    to tell the maker (problem_report; the user's wish, 2026-10-20). Once per part, as any card."""
    try:
        with open(SINCE_PATH) as f:
            since = json.load(f)
    except (OSError, ValueError):
        since = {}
    now_broken = {}
    for key, _level, _title, text, _request in found:
        if key.split(":")[0] in ("doctor", "doctor-minor"):
            for line in text.splitlines():
                part = line.split(":")[0].strip()
                if part:
                    now_broken[part] = since.get(part, now)
    os.makedirs(os.path.dirname(SINCE_PATH), exist_ok=True)
    with open(SINCE_PATH, "w") as f:
        json.dump(now_broken, f)
    long = sorted(part for part, first in now_broken.items() if now - first >= REPORT_AFTER)
    if not long:
        return []
    listed = "\n".join(long[:8])
    return [("report:" + ",".join(long[:6]), "warning", "A part of Mentor still does not work",
             listed + "\n\nIt has not worked for a day. Telling Mentor's maker lets an update fix it, for you and "
             "for everyone.",
             f"These parts of Mentor's desktop have been broken for more than a day:\n\n{listed}\n\nThe instructions "
             "they are mended from (/etc/mentor/DESKTOP.md) did not bring them back, or were not followed yet. If you "
             "have not tried yet, follow them once, in the sandbox first. If they still do not work, or the "
             "instructions no longer match this system, use problem_report: title what does not work, `part` the "
             "part and the instruction file, `found` what the instructions say, what you did and what the check "
             "shows now. Show me the report as it is and send it only after my yes.")]


def main():
    try:
        with open(STATE_PATH) as f:
            raised = json.load(f)
    except (OSError, ValueError):
        raised = {}
    now = time.time()
    off = set(mentor_settings.get("watch_off") or [])
    if mentor_settings.get("auto_review"):
        off.add("refused")  # the agent looks at those itself as they happen (mentor-firewall-watch)
    if "--guard" in sys.argv:
        # Programs that went online together: one run, one card (net_notices). They try again in waves (a name
        # lookup every 5 s), which made four cards of eleven programs: after a card, the next waits NET_CARD_EVERY.
        # Changes of net.json meanwhile start no other run (systemd: the service is running).
        time.sleep(max(NET_GATHER, min(NET_CARD_EVERY, raised.get("net-card", 0) + NET_CARD_EVERY - now)))
        now = time.time()
    found = list(guard_findings() if "--guard" in sys.argv else findings())
    if "--guard" not in sys.argv:
        found += still_broken(found, now)
    waiting = []  # programs waiting to go online, new in this run: told of together (net_notices)
    for key, level, title, text, request in found:
        if now - raised.get(key, 0) < REMIND_AFTER or group(key) in off:
            continue
        raised[key] = now
        os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
        with open(STATE_PATH, "w") as f:
            json.dump(raised, f)
        # A program waiting to go online (key "security:guard-net:BOOT:PROGRAM"): its card has Allow and Block.
        if key.startswith("security:guard-net:") and key.count(":") >= 3:
            waiting.append((key.split(":", 3)[3], level, title, text, request))
            continue
        # Something that looks like a harmful program: with "Let Mentor look by itself" on, the assistant looks
        # at once and says in a few words what it is (the user's wish, 2026-10-19), as for refused connections.
        if key.startswith("security:guard-") and mentor_settings.get("auto_review"):
            mentor_tools.leave_notice(level, title, text + " Mentor is having a look.", request
                                      + " This was noticed just now, by itself, and I did not ask: answer in three or "
                                      "four short sentences, in simple words, what it is and what you would do.",
                                      auto=True)
        elif key.startswith("filecheck:"):
            mentor_tools.leave_notice(level, title, text, request, action="Check now", quiet=True)
        elif key.startswith("report:"):
            mentor_tools.leave_notice(level, title, text, request, action="Report a problem")
        else:
            mentor_tools.leave_notice(level, title, text, request)
        # The assistant shows it, and says so with a notification when it is covered. When it
        # is not running at all, that is the first thing the user has to know.
        if not output("pgrep", "-u", str(os.getuid()), "-f", "bin/mentor-chat").strip():
            output("notify-send", "--app-name=Mentor", "--icon=dialog-warning", title,
                   text + "\n\nThe assistant is not running. From a terminal: mentor repair", timeout=20)
    if waiting:
        net_notices(waiting, raised, now)


def net_notices(waiting, raised, now):
    """Programs waiting to go online, new in this run: one card each with Allow and Block, or for two and more one
    card that names them, with Open Network… to answer each (twelve programs at once gave twelve cards and twelve
    looks, 2026-10-23). With "Let Mentor look by itself", one look, at most every NET_LOOK_EVERY seconds."""
    look = mentor_settings.get("auto_review") and now - raised.get("net-look", 0) >= NET_LOOK_EVERY
    raised["net-card"] = now
    if look:
        raised["net-look"] = now
    with open(STATE_PATH, "w") as f:
        json.dump(raised, f)
    by_itself = (" This was noticed just now, by itself, and I did not ask: answer in three or four short sentences, "
                 "in simple words, what it is and what you would do.")
    if len(waiting) == 1:
        program, level, title, text, request = waiting[0]
        if look:
            mentor_tools.leave_notice(level, title, text + " Mentor is having a look.", request + by_itself,
                                      auto=True, net=program)
        else:
            mentor_tools.leave_notice(level, title, text, request, action="Ask Mentor", net=program)
        return
    import mentor_guard
    names = mentor_guard.net_names([program for program, *_ in waiting])
    listed = ", ".join(names[:-1]) + " and " + names[-1] if len(names) <= 6 else ", ".join(names[:5]) + \
        f" and {len(names) - 5} more"
    text = (f"{listed}. Mentor does not know them, so they stay offline until you answer. Network\u2026 in the menu "
            "has each, with Allow and Block.")
    request = ("Mentor's guard on programs going online keeps these programs offline until I answer:\n\n"
               + "\n\n---\n\n".join(r.split("\n\nFollow /etc/mentor/SECURITY.md")[0] for *_, r in waiting[:6])
               + "\n\nFollow /etc/mentor/SECURITY.md, \"Unusual programs\": look at them together, reading only, and "
               "tell me in plain words what they are, whether any is harmful, and what you would do with each. Do not "
               "allow, block, stop or remove anything before I agree.")
    title = f"{len(waiting)} programs want to go online"
    if look:
        mentor_tools.leave_notice("warning", title, text + " Mentor is having a look.",
                                  request + by_itself.replace("what it is", "what they are"), auto=True,
                                  network=[program for program, *_ in waiting])
    else:
        mentor_tools.leave_notice("warning", title, text, request, action="Ask Mentor",
                                  network=[program for program, *_ in waiting])


main()
