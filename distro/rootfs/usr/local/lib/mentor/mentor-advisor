#!/usr/bin/python3
"""Looks the system over, now and then, for things worth bringing up with the user:
updates that have been waiting, a disk that is filling, a service that failed; and, once
a day, what is new from Arch Linux, from GNOME, in applications, and on GitHub.

No model is involved and nothing is changed: what is found is written down as
suggestions, and the assistant shows one as a card when the user is there. Only when the
user takes a suggestion up does it go to the agent, as the `prompt` written here.
How often a card is shown, and what the user does not want to hear of again, is the
assistant's business (mentor-chat), not this program's.

    /var/lib/mentor/advice/suggestions.json
        [{"id", "kind", "title", "body", "prompt", "since", "details"?, "link"?}, ...]

`details` is the whole of it as plain text, for the user to read when they open the
suggestion; `link` the page it comes from.

Run by mentor-advisor.timer; by hand: mentor-advisor [--print]
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time

DIR = "/var/lib/mentor/advice"
OUT = os.path.join(DIR, "suggestions.json")
SYNC = os.path.join(DIR, "db")  # a copy of the package lists: the system's own are left alone

MANY_UPDATES = 25      # this many waiting are worth a word at once
OLD_UPDATES = 7        # days since the last upgrade after which any are
KERNELS = ("linux", "linux-lts", "linux-zen", "linux-hardened")
MENTOR_EXTENSION = "/usr/share/gnome-shell/extensions/mentor@mentor.local/metadata.json"
DISK_FULL = 85         # percent of / in use
ARCH_NEWS = "https://archlinux.org/feeds/news/"
GNOME_NEWS = "https://thisweek.gnome.org/index.xml"
GNOME_DAYS = 10        # one of its weekly posts at a time
NEW_APPS = "https://flathub.org/api/v2/feed/new"
APPS_DAYS = 2          # the day's suggestion names what was published in this many days
APPS_MOST = 12         # and no more than this many
GITHUB = "https://api.github.com/search/repositories"
GITHUB_TOPICS = ("libadwaita", "gtk4", "gnome")
GITHUB_NEW = 45        # days since a project was created for it to count as new
GITHUB_STARS = 15      # and how many people must have starred it: the only sign of worth there is without reading it
GITHUB_SHOWN = 3       # days a project stays in the suggestion once it has appeared in it
GITHUB_MOST = 8
NEWS_EVERY = 1         # days between two readings of it
NEWS_DAYS = 21         # how long an announcement counts as news
NEWS_MOST = 3          # and how many of them at a time


def run(*argv, timeout=120):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return subprocess.CompletedProcess(argv, 1, "", "")


def last_upgrade():
    """When the system was last upgraded, or built if it never was."""
    latest = None
    try:
        with open("/var/log/pacman.log", errors="replace") as f:
            for line in f:
                if "starting full system upgrade" in line:
                    if found := re.match(r"\[(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)", line):
                        latest = time.mktime(time.strptime(found.group(1), "%Y-%m-%dT%H:%M:%S"))
    except OSError:
        pass
    try:
        return latest or os.path.getmtime("/var/lib/pacman/local/ALPM_DB_VERSION")
    except OSError:
        return None


def updates():
    os.makedirs(SYNC, exist_ok=True)
    local = os.path.join(SYNC, "local")
    if not os.path.islink(local):
        os.symlink("/var/lib/pacman/local", local)
    if run("pacman", "-Sy", "--dbpath", SYNC, "--logfile", "/dev/null", timeout=300).returncode:
        return []  # no network: next time
    waiting = [line.split() for line in run("pacman", "-Qu", "--dbpath", SYNC).stdout.splitlines()
               if "[ignored]" not in line and len(line.split()) >= 4]
    if not waiting:
        return []
    names = [parts[0] for parts in waiting]
    # A new major GNOME is worth a word of its own, however few the updates.
    found = []
    major = lambda version: version.split(":")[-1].split(".")[0].split("-")[0]
    for name, old, _arrow, new in waiting:
        if name == "gnome-shell" and major(old) != major(new):
            try:
                with open(MENTOR_EXTENSION) as f:
                    supported = major(new) in json.load(f).get("shell-version", [])
            except (OSError, ValueError):
                supported = False
            found.append({
                "id": f"gnome-{major(new)}", "kind": "updates",
                "title": f"GNOME {major(new)} is among the updates",
                "body": (f"A new major version of the desktop (now {major(old)}). " +
                         ("Mentor is made for it." if supported else
                          "Mentor is not made for it yet: an upgrade now would be undone at the next start.")),
                "prompt": (f"GNOME {major(new)} is waiting among the updates; this system runs GNOME {major(old)}. "
                           "Tell me what is new in it that I would notice, what it means for this system and for "
                           "Mentor's own desktop, and whether to upgrade now or wait. Do not upgrade before I say so."),
            })
    since = last_upgrade()
    days = int((time.time() - since) / 86400) if since else 0
    kernel = [name for name in names if name in KERNELS]
    if not (len(names) >= MANY_UPDATES or kernel or days >= OLD_UPDATES):
        return found
    # The ones worth naming first: the kernel, then what the user knows by name.
    known = ("linux", "gnome-shell", "mutter", "chromium", "firefox", "systemd", "mesa", "nautilus")
    first = sorted(waiting, key=lambda parts: (parts[0] not in KERNELS, parts[0] not in known))[:4]
    named = ", ".join(f"{name} {new}" for name, _old, _arrow, new in first)
    body = f"Among them: {named}." + (f" The system was last upgraded {days} days ago." if days >= 2 else "")
    return found + [{
        "id": "updates", "kind": "updates",
        "title": f"{len(names)} updates are waiting" if len(names) > 1 else "An update is waiting",
        "body": body,
        "details": "\n".join(f"{name}  {old} \u2192 {new}" for name, old, _arrow, new in waiting),
        "prompt": (f"The system has {len(names)} package updates waiting"
                   + (f", the kernel among them ({', '.join(kernel)})" if kernel else "")
                   + f". It was last upgraded {days} days ago. The packages: {', '.join(names[:60])}"
                   + (" and more" if len(names) > 60 else "") + ".\n\n"
                   "If you can, look at the Arch Linux news for anything about these that needs doing by hand. "
                   "Then upgrade the system the safe way, with a restore point first, and tell me what changed "
                   "and whether a restart is needed."),
    }]


def megabytes(path):
    out = run("du", "-sm", "--one-file-system", path).stdout.split()
    return int(out[0]) if out and out[0].isdigit() else 0


def disk():
    usage = shutil.disk_usage("/")
    percent = round(100 * usage.used / usage.total)
    if percent < DISK_FULL:
        return []
    free = usage.free / 2**30
    cache, logs = megabytes("/var/cache/pacman/pkg"), megabytes("/var/log/journal")
    return [{
        "id": "disk", "kind": "disk",
        "title": f"The disk is {percent}% full",
        "body": f"{free:.1f} GB are free. Downloaded packages take {cache / 1024:.1f} GB and the logs {logs / 1024:.1f} GB.",
        "prompt": (f"The system disk is {percent}% full, with {free:.1f} GB free. The package cache takes {cache} MB "
                   f"and the journal {logs} MB. Find out what takes the space, and tell me what can be freed "
                   "safely and how much each would give. Ask before removing anything that is mine."),
    }]


def failed():
    found = []
    listing = run("systemctl", "--failed", "--no-legend", "--plain").stdout.splitlines()
    for unit in [line.split()[0] for line in listing if line.split()][:3]:
        log = run("journalctl", "-b", "-u", unit, "-n", "15", "--no-pager", "-o", "cat").stdout.strip()
        # What the service itself said last, rather than systemd's words about its end.
        own = [line.strip() for line in log.splitlines()
               if line.strip() and not re.match(r"(\S+\.(service|mount|socket|timer): |Started |Starting |Stopped |Failed to start )", line)]
        last = (own or log.splitlines() or [""])[-1].strip()
        found.append({
            "id": f"failed-{unit}", "kind": "failed",
            "title": f"A system service has failed: {unit.removesuffix('.service')}",
            "body": last if len(last) <= 140 else last[:139] + "\u2026",
            "details": log or "Nothing was logged.",
            "prompt": (f"The system service {unit} has failed in this session. The last lines of its log:\n\n"
                       f"{log[-2500:] or '(nothing was logged)'}\n\n"
                       "Find out why, tell me what it means for me, and propose a fix. Do not change anything "
                       "before I agree."),
        })
    return found


def read_feed(url):
    """The items of an RSS feed, newest first: (title, link, text, when, the text in its paragraphs)."""
    import email.utils
    import html
    import urllib.request
    import xml.etree.ElementTree as ET
    request = urllib.request.Request(url, headers={"User-Agent": "mentor-advisor"})
    with urllib.request.urlopen(request, timeout=30) as response:
        feed = ET.fromstring(response.read())
    items = []
    for item in feed.iter("item"):
        title, link = (item.findtext("title") or "").strip(), (item.findtext("link") or "").strip()
        try:
            when = email.utils.parsedate_to_datetime(item.findtext("pubDate") or "").timestamp()
        except (TypeError, ValueError):
            continue
        raw = html.unescape(item.findtext("description") or "")
        text = " ".join(re.sub(r"<[^>]+>", " ", raw).split())
        # For reading: the paragraphs, headings and list items each on their own.
        laid = re.sub(r"(?i)<li[^>]*>", "• ", raw)
        laid = re.sub(r"(?i)</(p|h[1-6]|li|ul|ol|div|blockquote|pre|tr)>|<br\s*/?>", "\n\n", laid)
        laid = "\n".join(" ".join(line.split()) for line in re.sub(r"<[^>]+>", " ", laid).splitlines())
        laid = re.sub(r"\n{3,}", "\n\n", laid).strip()
        if title and link:
            items.append((title, link, text, when, laid))
    return sorted(items, key=lambda item: -item[3])


def day_of(when):
    return time.strftime("%d %B", time.localtime(when)).lstrip("0")


def short(text, length):
    return text if len(text) <= length else text[:length - 1] + "\u2026"


def arch_news():
    """What Arch Linux has announced lately, whatever it is about: the user decides what is
    of interest, and the agent can say what it means for this system when asked."""
    found = []
    for title, link, text, when, laid in read_feed(ARCH_NEWS):
        if time.time() - when > NEWS_DAYS * 86400:
            continue
        found.append({
            "id": "news-" + (link.rstrip("/").rsplit("/", 1)[-1] or str(int(when))), "kind": "news",
            "title": f"Arch news: {title}",
            "body": f"{day_of(when)}. {short(text, 180)}",
            "details": laid[:12000], "link": link,
            "prompt": (f"Arch Linux published this news on {day_of(when)}: \u201c{title}\u201d ({link}).\n\n{text[:3000]}\n\n"
                       "Tell me in plain words what it is about, whether it matters for this system (look at "
                       "what is installed here), and what, if anything, I should do. Do not change anything "
                       "before I agree."),
            "since": int(when),
        })
    return found[:NEWS_MOST]


def gnome_news():
    """This Week in GNOME: what changed in the desktop this system runs, and in the apps around it."""
    found = []
    for title, link, text, when, laid in read_feed(GNOME_NEWS)[:6]:
        if time.time() - when > GNOME_DAYS * 86400:
            continue
        found.append({
            "id": "gnome-" + (link.rstrip("/").rsplit("/", 1)[-1] or str(int(when))), "kind": "gnome",
            "title": f"This week in GNOME: {title}",
            "body": f"{day_of(when)}. {short(text, 180)}",
            "details": laid[:20000], "link": link,
            "prompt": (f"\u201cThis Week in GNOME\u201d published this on {day_of(when)}: \u201c{title}\u201d ({link}).\n\n"
                       f"{text[:6000]}\n\n"
                       "Tell me briefly what in it is of use on this system: changes to the GNOME I run (look at "
                       "which version is installed), and any application mentioned that is worth trying here. For "
                       "those, say whether it is in the Arch repositories. Do not install or change anything "
                       "before I say so."),
            "since": int(when),
        })
    return found[:1]


def new_apps():
    """Applications that appeared in the last days, one suggestion a day: which of them are
    worth a look is for the agent to say when asked, with this system in front of it."""
    apps = [(title, link, text) for title, link, text, when, _laid in read_feed(NEW_APPS)
            if time.time() - when <= APPS_DAYS * 86400][:APPS_MOST]
    if not apps:
        return []
    listed = "\n".join(f"- {title}: {short(text, 160)} ({link})" for title, link, text in apps)
    return [{
        "id": "apps-" + time.strftime("%Y-%m-%d"), "kind": "apps",
        "title": "New applications to look at",
        "body": short("Just published: " + ", ".join(title for title, _, _ in apps) + ".", 200),
        "details": "\n\n".join(f"{title}\n{text}\n{link}" for title, link, text in apps),
        "link": "https://flathub.org/apps/collection/recently-added",
        "prompt": ("These applications were published on Flathub in the last days:\n\n" + listed + "\n\n"
                   "Pick the few that are really worth trying on this system and its GNOME desktop, and leave the "
                   "rest out. For each, say in a line what it does and how it can be installed here: from the Arch "
                   "repositories if it is there (search them), otherwise the other ways, and whether Flatpak is "
                   "set up on this system. Do not install anything before I say which."),
    }]


def github_projects():
    """New projects for this kind of desktop that have gathered some stars. Each is named
    for a few days from the day it first qualifies, then not again."""
    import urllib.parse
    import urllib.request
    since = time.strftime("%Y-%m-%d", time.localtime(time.time() - GITHUB_NEW * 86400))
    found = {}
    for topic in GITHUB_TOPICS:
        query = urllib.parse.urlencode({"q": f"topic:{topic} created:>{since} stars:>={GITHUB_STARS}",
                                        "sort": "stars", "order": "desc", "per_page": 15})
        request = urllib.request.Request(f"{GITHUB}?{query}", headers={
            "User-Agent": "mentor-advisor", "Accept": "application/vnd.github+json"})
        with urllib.request.urlopen(request, timeout=30) as response:
            for repo in json.load(response).get("items", []):
                if not repo.get("archived") and not repo.get("fork"):
                    found[repo["full_name"]] = repo
    # When each was first seen here.
    seen_path = os.path.join(DIR, "github-seen.json")
    try:
        with open(seen_path) as f:
            seen = json.load(f)
    except (OSError, ValueError):
        seen = {}
    now = time.time()
    for name in found:
        seen.setdefault(name, now)
    seen = {name: when for name, when in seen.items() if now - when < (GITHUB_NEW + 30) * 86400}
    with open(seen_path, "w") as f:
        json.dump(seen, f)
    fresh = sorted((repo for name, repo in found.items() if now - seen[name] < GITHUB_SHOWN * 86400),
                   key=lambda repo: -repo.get("stargazers_count", 0))[:GITHUB_MOST]
    if not fresh:
        return []
    listed = "\n".join(
        f"- {repo['full_name']} ({repo.get('stargazers_count', 0)} stars, created {repo.get('created_at', '')[:10]}, "
        f"{repo.get('language') or 'language unknown'}): {short(' '.join((repo.get('description') or '').split()), 200)} "
        f"{repo.get('html_url', '')}" for repo in fresh)
    names = sorted(repo["full_name"] for repo in fresh)
    return [{
        "id": "github-" + format(abs(hash_of(names)), "x")[:10], "kind": "github",
        "title": "New projects on GitHub for this desktop",
        "body": short(", ".join(f"{repo['name']} ({repo.get('stargazers_count', 0)}\u2605)" for repo in fresh) + ".", 200),
        "details": "\n\n".join(
            f"{repo['full_name']}  \u2605 {repo.get('stargazers_count', 0)}  ({repo.get('language') or 'language unknown'}, "
            f"started {repo.get('created_at', '')[:10]})\n{' '.join((repo.get('description') or 'No description.').split())}\n"
            f"{repo.get('html_url', '')}" for repo in fresh),
        "prompt": ("These projects for GNOME and GTK were started on GitHub in the last weeks and have gathered "
                   "some stars:\n\n" + listed + "\n\n"
                   "Nobody has vetted them: stars say that people are interested, not that the code is safe. Pick "
                   "the few that could be of use on this system, and for each say in a line what it does, who is "
                   "behind it and how far along it is, and whether it is packaged for Arch (the repositories; "
                   "say so if it is only in the AUR or only as source). Do not download, build or run anything "
                   "from them before I say which, and when I do, try it in the sandbox first."),
    }]


def hash_of(names):
    import zlib
    return zlib.crc32("\n".join(names).encode())


def news():
    """All of them, read once a day; in between, what was found last time stands."""
    kinds = ("news", "gnome", "apps", "github")
    stamp = os.path.join(DIR, "news-read")
    try:
        if time.time() - os.path.getmtime(stamp) < NEWS_EVERY * 86400:
            with open(OUT) as f:
                return [item for item in json.load(f) if item.get("kind") in kinds]
    except (OSError, ValueError, AttributeError):
        pass
    found, read = [], False
    for source in (arch_news, gnome_news, new_apps, github_projects):
        try:
            found += source()
            read = True
        except Exception as e:  # no network, or a feed that has changed: the others still count
            print(f"mentor-advisor: {source.__name__}: {e}", file=sys.stderr)
    if read:
        open(stamp, "w").close()
    return found


def main():
    os.makedirs(DIR, exist_ok=True)
    try:
        with open(OUT) as f:
            since = {item["id"]: item.get("since") for item in json.load(f)}
    except (OSError, ValueError, KeyError, TypeError):
        since = {}
    suggestions = []
    for look in (failed, disk, updates, news):  # in the order they matter
        try:
            suggestions += look()
        except Exception as e:  # one look gone wrong does not cost the others
            print(f"mentor-advisor: {look.__name__}: {e}", file=sys.stderr)
    for item in suggestions:
        item.setdefault("since", since.get(item["id"]) or int(time.time()))
    if "--print" in sys.argv:
        print(json.dumps(suggestions, indent=1))
    with open(OUT + ".new", "w") as f:
        json.dump(suggestions, f)
    os.chmod(OUT + ".new", 0o644)
    os.replace(OUT + ".new", OUT)


main()
