#!/bin/sh
# Sets up what Mentor's own files need around them: its services, the settings database built from
# /etc/dconf/db/*.d, the icon cache. Run once by the image build (customize.sh) and by every update
# (mentor_update.py, inside the update's sandbox, so it is part of what an undo takes back). It must
# stay safe to run again and again. A new service of Mentor's is enabled here, not in customize.sh,
# or updates would never turn it on (UPDATES.md).
set -e
dconf update
systemctl --global enable mentor-watch.timer mentor-firewall-watch.service mentor-recipe-watch.service \
    mentor-taskbar-quiet.service
# A card in the chat when a program crashes (etc/mentor/FREEZES.md).
systemctl --global enable mentor-crash-watch.service
# The watch for unusual programs (a miner, a program hiding under a system name, something new that starts by
# itself): it looks as root every ten minutes, and the user's session makes cards of it (etc/mentor/SECURITY.md).
systemctl enable mentor-guard.timer
systemctl --global enable mentor-guard-notice.path
# No programs from temporary folders; the record of every program started; the guard on programs going online,
# which is OpenSnitch's daemon with Mentor as its interface (package opensnitch; etc/mentor/SECURITY.md).
systemctl enable mentor-noexec.service mentor-execlog.service
if [ -e /usr/lib/systemd/system/opensnitchd.service ]; then
    systemctl enable mentor-netguard.service opensnitchd.service
fi
# GNOME asks after a change of language whether to rename Desktop, Documents, Downloads... into it; the
# folders keep their names: Mentor's recipes live in ~/Documents/Mentor recipes (DESKTOP.md, "Folders").
systemctl --global mask user-dirs-update-gtk.service
systemctl enable gdm.service NetworkManager.service systemd-timesyncd.service qemu-guest-agent.service
# Safe start-up: see usr/local/lib/mentor/mentor_boot.py.
systemctl enable mentor-boot-check.service mentor-boot-deadline.service mentor-boot-confirm.path mentor-boot-arm.service
systemctl enable mentor-advisor.timer
# Updates of Mentor's own files, signed by its maker (etc/mentor/UPDATES.md).
systemctl enable mentor-update-check.timer
# The firewall: what comes in from other computers is refused (etc/nftables.conf, etc/mentor/SECURITY.md).
systemctl enable nftables.service
# Where the agent's tools ask for root, with a password dialog that says exactly what for (mentor-rootd).
systemctl enable mentor-root.socket
systemctl enable mentor-power-button.service
# A watch on the desktop from outside it: a freeze is noticed and explained (etc/mentor/FREEZES.md).
systemctl enable mentor-sentinel.service
# The emergency key: Ctrl+Alt+Backspace opens the agent on tty3 even when the desktop is frozen.
systemctl enable mentor-emergency-key.service
# The languages offered in Settings, System, Region & Language (etc/mentor/DESKTOP.md, "Languages").
# GNOME's translations are all installed, but a language is listed only once its locale is made.
# More can be added the same way (one line of /etc/locale.gen, then locale-gen).
changed=
for l in en_US en_GB de_DE fr_FR es_ES es_MX it_IT pt_PT pt_BR nl_NL pl_PL cs_CZ sk_SK sl_SI hr_HR hu_HU \
         ro_RO bg_BG el_GR ru_RU uk_UA tr_TR sv_SE da_DK nb_NO fi_FI et_EE lv_LV lt_LT ja_JP zh_CN zh_TW \
         ko_KR ar_EG he_IL id_ID th_TH; do
    if grep -q "^#$l\.UTF-8 UTF-8" /etc/locale.gen; then
        sed -i "s/^#\($l\.UTF-8 UTF-8\)/\1/" /etc/locale.gen
        changed=1
    fi
done
if [ -n "$changed" ]; then
    locale-gen >/dev/null
fi
install -d -m 755 /var/log/mentor
gtk-update-icon-cache -q -f /usr/share/icons/hicolor
