#!/bin/sh
# No programs from temporary folders (SECURITY.md, "Unusual programs"; the user's wish, 2026-10-20): /tmp, /var/tmp
# and /dev/shm get noexec, so a program dropped there (a cryptominer in /tmp, say) cannot be started at all.
# Scripts started through their interpreter (bash /tmp/x.sh, python3 /tmp/x.py) still run; Mentor's own parts
# only keep data there. Safe to run again: what is already noexec is left as it is.
set -u
noexec() { findmnt -no OPTIONS --target "$1" | tr , '\n' | grep -qx noexec; }
for place in /tmp /dev/shm; do
    if mountpoint -q "$place" && ! noexec "$place"; then
        mount -o remount,noexec,nosuid,nodev "$place" || echo "mentor-noexec: $place could not be made noexec" >&2
    fi
done
# /var/tmp is a folder of the system disk: a mount of its own on itself carries the flags
if ! mountpoint -q /var/tmp; then
    mount --bind /var/tmp /var/tmp || echo "mentor-noexec: /var/tmp could not be bound" >&2
fi
if ! noexec /var/tmp; then
    mount -o remount,bind,noexec,nosuid,nodev /var/tmp || echo "mentor-noexec: /var/tmp could not be made noexec" >&2
fi
exit 0
