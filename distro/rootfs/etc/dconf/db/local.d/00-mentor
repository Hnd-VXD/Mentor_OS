# System-wide GNOME defaults. Users (and the agent) override these per user.

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
# Animations on: the desktop is drawn by the graphics card (Mentor.exe's Graphics card switch, on by
# default, or a PC's own). Without one, Mentor's extension holds them back for the session (DESKTOP.md, "Animations").
enable-animations=true

# Minimize and maximize buttons next to close, as on Ubuntu and Windows.
[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

# A permanent taskbar at the bottom (Dash to Panel) with tray icons, instead of
# GNOME's top bar and a dock that only shows in the overview.
[org/gnome/shell/extensions/dash-to-panel]
hide-overview-on-startup=true

[org/gnome/shell]
enabled-extensions=['mentor@mentor.local', 'dash-to-panel@jderose9.github.com', 'appindicatorsupport@rgcjonas.gmail.com']
favorite-apps=['chromium.desktop','org.gnome.Nautilus.desktop', 'org.gnome.Console.desktop', 'org.gnome.TextEditor.desktop']

# Super+A goes to the assistant on the desktop, and back, instead of opening the
# app grid (still on Super, then the grid button).
[org/gnome/shell/keybindings]
toggle-application-view=@as []
# GNOME's own screenshot overlay is off: Mentor takes the picture and Gradia opens it (below).
show-screenshot-ui=@as []
screenshot=@as []
screenshot-window=@as []

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mentor/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mentor-window/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mentor-ask/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mentor-ask-2/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mentor-shot-2/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mentor-shot-window/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mentor-text/']

# A screenshot: drag out an area (Esc cancels, a click is the whole screen), saved in
# Pictures/Screenshots and opened in Gradia to draw on, copy or save (`mentor screenshot --area`).
# Print Screen is Windows': its Snipping Tool takes it even while Mentor is full screen, and the
# picture comes into Mentor's clipboard (Ctrl+V). Bound here too, both pickers came up at once.
[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mentor-shot-2]
name='Screenshot (second key)'
command='/usr/local/bin/mentor screenshot --area'
binding='<Shift><Super>s'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mentor-shot-window]
name='Screenshot of the window in front'
command='/usr/local/bin/mentor screenshot --window'
binding='<Alt>Print'

# Copy the text in an area: drag over it (as for a screenshot), it is read (tesseract) and put on
# the clipboard, with a short notification (`mentor capture-text`; DESKTOP.md, Copy text from the screen).
[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mentor-text]
name='Copy text from the screen'
command='/usr/local/bin/mentor capture-text'
binding='<Shift><Super>t'

# Alt+Space and Super+Z bring up the ask bar over whatever is in front: a text box for the
# assistant, which is sent a picture of the screen with the words (/etc/mentor/ASKBAR.md).
[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mentor-ask]
name='Ask Mentor'
command='/usr/local/bin/mentor ask'
binding='<Alt>space'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mentor-ask-2]
name='Ask Mentor (second key)'
command='/usr/local/bin/mentor ask'
binding='<Super>z'

# Alt+Space is the ask bar's: the window menu it used to open is still on a right-click
# of a window's title.
[org/gnome/desktop/wm/keybindings]
activate-window-menu=@as []

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mentor]
name='Mentor Assistant'
command='/usr/local/bin/mentor desktop'
binding='<Super>a'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mentor-window]
name='Mentor full screen'
command='/usr/local/bin/mentor window toggle'
binding='<Super>F11'

# No fundraising notification from GNOME on a system that is not GNOME's own.
[org/gnome/settings-daemon/plugins/housekeeping]
donation-reminder-enabled=false

[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/screensaver]
lock-enabled=false
picture-uri='file:///usr/share/backgrounds/mentor/blue-waves.jpg'

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'
# The power button is mentor-power-button's: it powers off (the launcher's proper shut down).
power-button-action='nothing'

# The default wallpaper; the others of ours are offered in Settings > Appearance.
[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/mentor/blue-waves.jpg'
picture-uri-dark='file:///usr/share/backgrounds/mentor/blue-waves.jpg'
picture-options='zoom'
primary-color='#16171b'
